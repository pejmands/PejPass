<Window x:Class="PejPass.Wpf.Views.PasswordGeneratorWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="clr-namespace:PejPass.Wpf.Controls"
        Title="Password Generator"
        Height="490"
        Width="420"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        Background="{DynamicResource BgBrush}">
    <DockPanel>
        <controls:AppTitleBar DockPanel.Dock="Top" ShowMinimize="false" ShowMaximize="false"/>

    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <StackPanel Margin="0,0,0,16">
            <TextBlock Text="Password Generator"
                       FontSize="18"
                       FontWeight="Bold"
                       Foreground="{DynamicResource TextBrush}"
                       Margin="0,0,0,16"/>

            <TextBlock Text="LENGTH"
                       FontSize="11"
                       FontWeight="SemiBold"
                       Foreground="{DynamicResource MutedBrush}"
                       Margin="0,0,0,6"/>

            <Grid Margin="0,0,0,16">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <Slider Minimum="8"
                        Maximum="64"
                        Margin="0,0,8,0"
                        TickFrequency="1"
                        IsSnapToTickEnabled="True"
                        Value="{Binding Length}"
                        VerticalAlignment="Center"/>

                <TextBlock Grid.Column="1"
                           Text="{Binding Length}"
                           FontWeight="SemiBold"
                           Foreground="{DynamicResource TextBrush}"
                           HorizontalAlignment="Right"
                           VerticalAlignment="Center"/>
            </Grid>

            <CheckBox Content="Lowercase (a–z)"
                      IsChecked="{Binding IncludeLowercase}"
                      Margin="0,0,0,8"/>

            <CheckBox Content="Uppercase (A–Z)"
                      IsChecked="{Binding IncludeUppercase}"
                      Margin="0,0,0,8"/>

            <CheckBox Content="Digits (0–9)"
                      IsChecked="{Binding IncludeDigits}"
                      Margin="0,0,0,8"/>

            <CheckBox Content="Symbols (!@#$…)"
                      IsChecked="{Binding IncludeSymbols}"
                      Margin="0,0,0,8"/>

            <CheckBox Content="Exclude ambiguous (0 O l 1 I)"
                      IsChecked="{Binding ExcludeAmbiguous}"/>
        </StackPanel>

        <StackPanel Grid.Row="1">
            <TextBlock Text="PREVIEW"
                       FontSize="11"
                       FontWeight="SemiBold"
                       Foreground="{DynamicResource MutedBrush}"
                       Margin="0,0,0,6"/>

            <Border Background="{DynamicResource SurfaceBrush}"
                    CornerRadius="6"
                    Padding="12,10">

                <ScrollViewer HorizontalScrollBarVisibility="Auto"
                              Height="24"
                              VerticalScrollBarVisibility="Disabled">

                    <TextBlock Text="{Binding Preview}"
                               FontFamily="Consolas"
                               FontSize="14"
                               Foreground="{DynamicResource TextBrush}"
                               TextWrapping="NoWrap"/>
                </ScrollViewer>
            </Border>

            <TextBlock Text="{Binding Error}"
                       Foreground="{DynamicResource DangerBrush}"
                       TextWrapping="Wrap"
                       MinHeight="18"
                       Margin="0,2,0,4"/>

            <Button Content="Regenerate"
                    Command="{Binding RegenerateCommand}"
                    HorizontalAlignment="Right"
                    Background="{DynamicResource SurfaceAltBrush}"
                    Foreground="{DynamicResource TextBrush}"/>
        </StackPanel>

        <StackPanel Grid.Row="2"
                    Orientation="Horizontal"
                    HorizontalAlignment="Right">

            <Button Content="Cancel"
                    Command="{Binding CancelCommand}"
                    Margin="0,0,8,0"
                    Background="{DynamicResource SurfaceAltBrush}"
                    Foreground="{DynamicResource TextBrush}"/>

            <Button Content="Use password"
                    Command="{Binding UseCommand}"
                    IsDefault="True"/>
        </StackPanel>
    </Grid>
    </DockPanel>
</Window>
