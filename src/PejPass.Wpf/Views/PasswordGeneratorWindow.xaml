<Window x:Class="PejPass.Wpf.Views.PasswordGeneratorWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Password Generator"
        Height="440" Width="420"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        Background="{DynamicResource BgBrush}">

    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <StackPanel>
            <TextBlock Text="Password Generator" FontSize="18" FontWeight="Bold"
                       Foreground="{DynamicResource TextBrush}" Margin="0,0,0,16"/>

            <TextBlock Text="LENGTH" FontSize="11" FontWeight="SemiBold"
                       Foreground="{DynamicResource MutedBrush}" Margin="0,0,0,6"/>
            <Grid Margin="0,0,0,16">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="48"/>
                </Grid.ColumnDefinitions>
                <Slider Minimum="8" Maximum="64" TickFrequency="1" IsSnapToTickEnabled="True"
                        Value="{Binding Length}" VerticalAlignment="Center"/>
                <TextBlock Grid.Column="1" Text="{Binding Length}" FontWeight="SemiBold"
                           Foreground="{DynamicResource TextBrush}" HorizontalAlignment="Right"
                           VerticalAlignment="Center"/>
            </Grid>

            <CheckBox Content="Lowercase (a–z)" IsChecked="{Binding IncludeLowercase}" Margin="0,0,0,8"/>
            <CheckBox Content="Uppercase (A–Z)" IsChecked="{Binding IncludeUppercase}" Margin="0,0,0,8"/>
            <CheckBox Content="Digits (0–9)" IsChecked="{Binding IncludeDigits}" Margin="0,0,0,8"/>
            <CheckBox Content="Symbols (!@#$…)" IsChecked="{Binding IncludeSymbols}" Margin="0,0,0,8"/>
            <CheckBox Content="Exclude ambiguous (0 O l 1 I)" IsChecked="{Binding ExcludeAmbiguous}" Margin="0,0,0,16"/>

            <TextBlock Text="PREVIEW" FontSize="11" FontWeight="SemiBold"
                       Foreground="{DynamicResource MutedBrush}" Margin="0,0,0,6"/>
            <!-- Fixed height so long passwords wrap inside the box and scroll instead of overflowing the window -->
            <Border Background="{DynamicResource SurfaceBrush}" CornerRadius="6"
                    Padding="12,10" Margin="0,0,0,8"
                    Height="88" ClipToBounds="True">
                <ScrollViewer VerticalScrollBarVisibility="Auto"
                              HorizontalScrollBarVisibility="Disabled"
                              CanContentScroll="False">
                    <TextBlock Text="{Binding Preview}" FontFamily="Consolas" FontSize="14"
                               Foreground="{DynamicResource TextBrush}"
                               TextWrapping="Wrap"/>
                </ScrollViewer>
            </Border>

            <TextBlock Text="{Binding Error}" Foreground="{DynamicResource DangerBrush}"
                       TextWrapping="Wrap" MinHeight="18" Margin="0,0,0,8"/>

            <Button Content="Regenerate" Command="{Binding RegenerateCommand}"
                    HorizontalAlignment="Left" Padding="14,7"
                    Background="{DynamicResource SurfaceAltBrush}" Foreground="{DynamicResource TextBrush}"/>
        </StackPanel>

        <StackPanel Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0">
            <Button Content="Cancel" Command="{Binding CancelCommand}" Margin="0,0,8,0"
                    Background="{DynamicResource SurfaceAltBrush}" Foreground="{DynamicResource TextBrush}"/>
            <Button Content="Use password" Command="{Binding UseCommand}" IsDefault="True"/>
        </StackPanel>
    </Grid>
</Window>
