<Window x:Class="PejPass.Wpf.Views.PasswordGeneratorWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="clr-namespace:PejPass.Wpf.Controls"
        Title="Password Generator"
        Height="490"
        Width="420"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        Background="{DynamicResource BgBrush}">
    <DockPanel>
        <controls:AppTitleBar DockPanel.Dock="Top" ShowMinimize="false" ShowMaximize="false"/>

    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Preview -->
        <Border Background="{DynamicResource SurfaceBrush}"
                CornerRadius="6"
                Padding="12,10"
                Margin="0,0,0,16">
            <ScrollViewer HorizontalScrollBarVisibility="Auto"
                          VerticalScrollBarVisibility="Disabled">
                <TextBlock Text="{Binding Preview}"
                           FontFamily="Consolas"
                           FontSize="14"
                           Foreground="{DynamicResource TextBrush}"
                           TextWrapping="NoWrap"/>
            </ScrollViewer>
        </Border>

        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
            <StackPanel>
                <TextBlock Text="Length" Foreground="{DynamicResource MutedBrush}" Margin="0,0,0,6"/>
                <Grid Margin="0,0,0,16">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <Slider Minimum="8" Maximum="64"
                            Value="{Binding Length}"
                            TickFrequency="1" IsSnapToTickEnabled="True"
                            VerticalAlignment="Center"/>
                    <TextBlock Grid.Column="1" Text="{Binding Length}" Width="28"
                               Margin="10,0,0,0" VerticalAlignment="Center"
                               Foreground="{DynamicResource TextBrush}"/>
                </Grid>

                <CheckBox Content="Uppercase (A–Z)" IsChecked="{Binding UseUpper}" Margin="0,0,0,8"/>
                <CheckBox Content="Lowercase (a–z)" IsChecked="{Binding UseLower}" Margin="0,0,0,8"/>
                <CheckBox Content="Digits (0–9)" IsChecked="{Binding UseDigits}" Margin="0,0,0,8"/>
                <CheckBox Content="Symbols" IsChecked="{Binding UseSymbols}" Margin="0,0,0,8"/>
                <CheckBox Content="Exclude ambiguous (0O1lI)" IsChecked="{Binding ExcludeAmbiguous}" Margin="0,0,0,16"/>

                <Button Content="Regenerate" Command="{Binding RegenerateCommand}"
                        Background="{DynamicResource SurfaceAltBrush}"
                        Foreground="{DynamicResource TextBrush}"/>
            </StackPanel>
        </ScrollViewer>

        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0">
            <Button Content="Cancel" Click="Cancel_Click" Margin="0,0,8,0"
                    Background="{DynamicResource SurfaceAltBrush}" Foreground="{DynamicResource TextBrush}"/>
            <Button Content="Use password" Click="Use_Click" IsDefault="True"/>
        </StackPanel>
    </Grid>
    </DockPanel>
</Window>
