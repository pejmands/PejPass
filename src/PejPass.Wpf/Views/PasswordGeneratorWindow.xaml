<Window
	x:Class="PejPass.Wpf.Views.PasswordGeneratorWindow"
	xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
	xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
	xmlns:controls="clr-namespace:PejPass.Wpf.Controls"
	Title="Generate Password"
	Width="420"
	Height="490"
	Background="{DynamicResource BgBrush}"
	ResizeMode="NoResize"
	ShowInTaskbar="False"
	WindowStartupLocation="CenterOwner">
	<DockPanel>
		<controls:AppTitleBar
			DockPanel.Dock="Top"
			ShowMaximize="false"
			ShowMinimize="false" />

		<ScrollViewer HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
			<Grid Margin="24">
				<Grid.RowDefinitions>
					<RowDefinition Height="Auto" />
					<RowDefinition Height="*" />
					<RowDefinition Height="Auto" />
				</Grid.RowDefinitions>

				<StackPanel Margin="0,0,0,16">
					<TextBlock
						Margin="0,0,0,16"
						FontSize="{DynamicResource AppFontSize18}"
						FontWeight="Bold"
						Foreground="{DynamicResource TextBrush}"
						Text="Password Generator" />

					<TextBlock
						Margin="0,0,0,6"
						FontSize="{DynamicResource AppFontSize11}"
						FontWeight="SemiBold"
						Foreground="{DynamicResource MutedBrush}"
						Text="LENGTH" />

					<Grid Margin="0,0,0,16">
						<Grid.ColumnDefinitions>
							<ColumnDefinition Width="*" />
							<ColumnDefinition Width="Auto" />
						</Grid.ColumnDefinitions>

						<Slider
							Margin="0,0,8,0"
							VerticalAlignment="Center"
							IsSnapToTickEnabled="True"
							Maximum="64"
							Minimum="8"
							TickFrequency="1"
							Value="{Binding Length}" />

						<TextBlock
							Grid.Column="1"
							HorizontalAlignment="Right"
							VerticalAlignment="Center"
							FontWeight="SemiBold"
							Foreground="{DynamicResource TextBrush}"
							Text="{Binding Length}" />
					</Grid>

					<CheckBox Margin="0,0,0,8" Content="Lowercase (a–z)" IsChecked="{Binding IncludeLowercase}" />
					<CheckBox Margin="0,0,0,8" Content="Uppercase (A–Z)" IsChecked="{Binding IncludeUppercase}" />
					<CheckBox Margin="0,0,0,8" Content="Digits (0–9)" IsChecked="{Binding IncludeDigits}" />
					<CheckBox Margin="0,0,0,8" Content="Symbols (!@#$…)" IsChecked="{Binding IncludeSymbols}" />
					<CheckBox Margin="0,0,0,8" Content="Exclude ambiguous (0 O l 1 I)" IsChecked="{Binding ExcludeAmbiguous}" />
				</StackPanel>

				<StackPanel Grid.Row="1">
					<TextBlock
						Margin="0,0,0,6"
						FontSize="{DynamicResource AppFontSize11}"
						FontWeight="SemiBold"
						Foreground="{DynamicResource MutedBrush}"
						Text="PREVIEW" />

					<Border Padding="12,10" Background="{DynamicResource SurfaceBrush}" CornerRadius="6">
						<ScrollViewer Height="24" HorizontalScrollBarVisibility="Hidden" VerticalScrollBarVisibility="Disabled">
							<TextBlock
								FontFamily="Consolas"
								FontSize="{DynamicResource AppFontSize14}"
								Foreground="{DynamicResource TextBrush}"
								Text="{Binding Preview}"
								TextWrapping="NoWrap" />
						</ScrollViewer>
					</Border>

					<Grid Height="24" Margin="0,4,0,4">
						<TextBlock
							Margin="0"
							Style="{StaticResource ValidationErrorText}"
							Text="{Binding Error, StringFormat=⚠ {0}}"
							Visibility="{Binding Error, Converter={StaticResource NullOrEmptyToVis}}" />
					</Grid>
				</StackPanel>

				<Grid Grid.Row="2">
					<Button
						HorizontalAlignment="Left"
						VerticalAlignment="Center"
						Background="{DynamicResource SurfaceAltBrush}"
						Command="{Binding RegenerateCommand}"
						Content="Regenerate"
						Foreground="{DynamicResource TextBrush}"
						Style="{StaticResource SecondaryButton}" />

					<StackPanel HorizontalAlignment="Right" Orientation="Horizontal">
						<Button
							x:Name="CancelButton"
							Margin="0,0,8,0"
							Background="{DynamicResource SurfaceAltBrush}"
							Command="{Binding CancelCommand}"
							Content="Cancel"
							Foreground="{DynamicResource TextBrush}"
							IsCancel="True"
							Style="{StaticResource SecondaryButton}" />

						<Button
							x:Name="UseButton"
							Command="{Binding UseCommand}"
							Content="Use password"
							IsDefault="True"
							Style="{StaticResource PrimaryButton}" />
					</StackPanel>
				</Grid>
			</Grid>
		</ScrollViewer>
	</DockPanel>
</Window>