<Window x:Class="PejPass.Wpf.Views.ChangeMasterPasswordWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="clr-namespace:PejPass.Wpf.Controls"
        Title="Change master password"
        SizeToContent="Height"
        Width="440"
        MinWidth="400"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        WindowStyle="None"
        ShowInTaskbar="False"
        Background="{DynamicResource BgBrush}">

    <DockPanel>
        <controls:AppTitleBar DockPanel.Dock="Top"
                          ShowMinimize="false"
                          ShowMaximize="false"/>

        <ScrollViewer VerticalScrollBarVisibility="Auto"
                  HorizontalScrollBarVisibility="Disabled">
            <Border BorderBrush="{DynamicResource BorderBrush}"
                BorderThickness="1"
                Background="{DynamicResource SurfaceBrush}"
                Padding="24">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <StackPanel>
                        <TextBlock Text="Change master password"
                               FontSize="{DynamicResource AppFontSize18}"
                               FontWeight="SemiBold"
                               Foreground="{DynamicResource TextBrush}"
                               Margin="0,0,0,10"
                               TextWrapping="Wrap"/>

                        <TextBlock Text="The vault file will be re-encrypted with the new password. All entries stay the same."
                               FontSize="{DynamicResource AppFontSize14}"
                               TextWrapping="Wrap"
                               Foreground="{DynamicResource MutedBrush}"
                               Margin="0,0,0,20"/>

                        <TextBlock Text="Current password"
                               Foreground="{DynamicResource MutedBrush}"
                               Margin="0,0,0,6"/>
                        <Grid Margin="0,0,0,6">
                            <PasswordBox x:Name="CurrentPasswordBox"
                                         PasswordChanged="CurrentPasswordBox_PasswordChanged"
                                         Padding="10,8,44,8"
                                         Visibility="Visible"/>
                            <TextBox x:Name="CurrentPasswordBoxTextBox"
                                     TextChanged="CurrentPasswordBoxTextBox_TextChanged"
                                     Padding="10,8,44,8"
                                     TextWrapping="NoWrap"
                                     Visibility="Collapsed"/>
                            <Button x:Name="CurrentPasswordVisibilityButton"
                                    Content="&#xE890;"
                                    Click="CurrentPasswordVisibilityButton_Click"
                                    Width="36"
                                    Height="36"
                                    HorizontalAlignment="Right"
                                    VerticalAlignment="Center"
                                    Margin="0,0,4,0"
                                    Padding="0"
                                    FontFamily="Segoe MDL2 Assets"
                                    FontSize="{DynamicResource AppFontSize15}"
                                    Foreground="{DynamicResource AccentBrush}"
                                    Background="Transparent"
                                    BorderThickness="0"
                                    Cursor="Hand"
                                    ToolTip="Show password"/>
                        </Grid>
                        <TextBlock Style="{StaticResource ValidationErrorText}"
                               Text="{Binding CurrentPasswordError, StringFormat=⚠ {0}}"
                               Visibility="{Binding CurrentPasswordError, Converter={StaticResource NullOrEmptyToVis}}"
                               Margin="0,0,0,12"/>

                        <TextBlock Text="New password"
                               Foreground="{DynamicResource MutedBrush}"
                               Margin="0,0,0,6"/>
                        <Grid Margin="0,0,0,6">
                            <PasswordBox x:Name="NewPasswordBox"
                                         PasswordChanged="NewPasswordBox_PasswordChanged"
                                         Padding="10,8,44,8"
                                         Visibility="Visible"/>
                            <TextBox x:Name="NewPasswordBoxTextBox"
                                     TextChanged="NewPasswordBoxTextBox_TextChanged"
                                     Padding="10,8,44,8"
                                     TextWrapping="NoWrap"
                                     Visibility="Collapsed"/>
                            <Button x:Name="NewPasswordVisibilityButton"
                                    Content="&#xE890;"
                                    Click="NewPasswordVisibilityButton_Click"
                                    Width="36"
                                    Height="36"
                                    HorizontalAlignment="Right"
                                    VerticalAlignment="Center"
                                    Margin="0,0,4,0"
                                    Padding="0"
                                    FontFamily="Segoe MDL2 Assets"
                                    FontSize="{DynamicResource AppFontSize15}"
                                    Foreground="{DynamicResource AccentBrush}"
                                    Background="Transparent"
                                    BorderThickness="0"
                                    Cursor="Hand"
                                    ToolTip="Show password"/>
                        </Grid>
                        <TextBlock Style="{StaticResource ValidationErrorText}"
                               Text="{Binding NewPasswordError, StringFormat=⚠ {0}}"
                               Visibility="{Binding NewPasswordError, Converter={StaticResource NullOrEmptyToVis}}"
                               Margin="0,0,0,8"/>

                        <controls:PasswordStrengthIndicator
    Visibility="{Binding ShowNewPasswordStrength, Converter={StaticResource BoolToVis}}"
    StrengthLabel="{Binding NewPasswordStrengthLabel}"
    StrengthLevel="{Binding NewPasswordStrengthLevel}"
    StrengthProgress="{Binding NewPasswordStrengthProgress}"
    Margin="0,0,0,16"/>

                        <TextBlock Text="Confirm new password"
                               Foreground="{DynamicResource MutedBrush}"
                               Margin="0,0,0,6"/>
                        <Grid Margin="0,0,0,6">
                            <PasswordBox x:Name="ConfirmPasswordBox"
                                         PasswordChanged="ConfirmPasswordBox_PasswordChanged"
                                         Padding="10,8,44,8"
                                         Visibility="Visible"/>
                            <TextBox x:Name="ConfirmPasswordBoxTextBox"
                                     TextChanged="ConfirmPasswordBoxTextBox_TextChanged"
                                     Padding="10,8,44,8"
                                     TextWrapping="NoWrap"
                                     Visibility="Collapsed"/>
                            <Button x:Name="ConfirmPasswordVisibilityButton"
                                    Content="&#xE890;"
                                    Click="ConfirmPasswordVisibilityButton_Click"
                                    Width="36"
                                    Height="36"
                                    HorizontalAlignment="Right"
                                    VerticalAlignment="Center"
                                    Margin="0,0,4,0"
                                    Padding="0"
                                    FontFamily="Segoe MDL2 Assets"
                                    FontSize="{DynamicResource AppFontSize15}"
                                    Foreground="{DynamicResource AccentBrush}"
                                    Background="Transparent"
                                    BorderThickness="0"
                                    Cursor="Hand"
                                    ToolTip="Show password"/>
                        </Grid>
                        <TextBlock Style="{StaticResource ValidationErrorText}"
                               Text="{Binding ConfirmPasswordError, StringFormat=⚠ {0}}"
                               Visibility="{Binding ConfirmPasswordError, Converter={StaticResource NullOrEmptyToVis}}"
                               Margin="0,0,0,8"/>
                    </StackPanel>

                    <StackPanel Grid.Row="1"
                            Orientation="Horizontal"
                            HorizontalAlignment="Right"
                            Margin="0,20,0,0">
                        <Button Style="{StaticResource SecondaryButton}"
                            Content="Cancel"
                            Command="{Binding CancelCommand}"
                            IsCancel="True"
                            Margin="0,0,8,0"
                            Padding="16,8"/>
                        <Button Style="{StaticResource PrimaryButton}"
                            Content="Change password"
                            Command="{Binding ChangeCommand}"
                            Padding="16,8"
                            IsDefault="True"/>
                    </StackPanel>
                </Grid>
            </Border>
        </ScrollViewer>
    </DockPanel>
</Window>
