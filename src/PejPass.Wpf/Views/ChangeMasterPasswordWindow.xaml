<Window x:Class="PejPass.Wpf.Views.ChangeMasterPasswordWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="clr-namespace:PejPass.Wpf.Controls"
        Title="Change master password"
        SizeToContent="Height"
        Width="440"
        MinWidth="400"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        Background="{DynamicResource BgBrush}">

    <DockPanel>
        <controls:AppTitleBar DockPanel.Dock="Top"
                              ShowMinimize="false"
                              ShowMaximize="false"/>

        <Border BorderBrush="{DynamicResource BorderBrush}"
                BorderThickness="1"
                Background="{DynamicResource SurfaceBrush}"
                Padding="24">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <StackPanel>
                    <TextBlock Text="Change master password"
                               FontSize="18"
                               FontWeight="SemiBold"
                               Foreground="{DynamicResource TextBrush}"
                               Margin="0,0,0,10"
                               TextWrapping="Wrap"/>

                    <TextBlock Text="The vault file will be re-encrypted with the new password. All entries stay the same."
                               FontSize="14"
                               TextWrapping="Wrap"
                               Foreground="{DynamicResource MutedBrush}"
                               Margin="0,0,0,20"/>

                    <TextBlock Text="Current password"
                               Foreground="{DynamicResource MutedBrush}"
                               Margin="0,0,0,6"/>
                    <PasswordBox x:Name="CurrentPasswordBox"
                                 Margin="0,0,0,6"
                                 PasswordChanged="CurrentPasswordBox_PasswordChanged"/>
                    <TextBlock Style="{StaticResource ValidationErrorText}"
                               Text="{Binding CurrentPasswordError, StringFormat=⚠ {0}}"
                               Visibility="{Binding CurrentPasswordError, Converter={StaticResource NullOrEmptyToVis}}"
                               Margin="0,0,0,12"/>

                    <TextBlock Text="New password"
                               Foreground="{DynamicResource MutedBrush}"
                               Margin="0,0,0,6"/>
                    <PasswordBox x:Name="NewPasswordBox"
                                 Margin="0,0,0,6"
                                 PasswordChanged="NewPasswordBox_PasswordChanged"/>
                    <TextBlock Style="{StaticResource ValidationErrorText}"
                               Text="{Binding NewPasswordError, StringFormat=⚠ {0}}"
                               Visibility="{Binding NewPasswordError, Converter={StaticResource NullOrEmptyToVis}}"
                               Margin="0,0,0,8"/>

                    <Grid Margin="0,0,0,16"
                          Visibility="{Binding ShowNewPasswordStrength, Converter={StaticResource BoolToVis}}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <ProgressBar Height="6"
                                     Minimum="0"
                                     Maximum="100"
                                     Value="{Binding NewPasswordStrengthProgress}"
                                     Background="{DynamicResource SurfaceAltBrush}"/>
                        <TextBlock Grid.Column="1"
                                   Margin="10,0,0,0"
                                   FontSize="11"
                                   VerticalAlignment="Center"
                                   Text="{Binding NewPasswordStrengthLabel}">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Foreground"
                                            Value="{DynamicResource MutedBrush}"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding NewPasswordStrengthLevel}" Value="1">
                                            <Setter Property="Foreground"
                                                    Value="{DynamicResource DangerBrush}"/>
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding NewPasswordStrengthLevel}" Value="2">
                                            <Setter Property="Foreground"
                                                    Value="{DynamicResource DangerBrush}"/>
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding NewPasswordStrengthLevel}" Value="3">
                                            <Setter Property="Foreground"
                                                    Value="{DynamicResource WarningBrush}"/>
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding NewPasswordStrengthLevel}" Value="4">
                                            <Setter Property="Foreground"
                                                    Value="{DynamicResource SuccessBrush}"/>
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding NewPasswordStrengthLevel}" Value="5">
                                            <Setter Property="Foreground"
                                                    Value="{DynamicResource SuccessBrush}"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                    </Grid>

                    <TextBlock Text="Confirm new password"
                               Foreground="{DynamicResource MutedBrush}"
                               Margin="0,0,0,6"/>
                    <PasswordBox x:Name="ConfirmPasswordBox"
                                 Margin="0,0,0,6"
                                 PasswordChanged="ConfirmPasswordBox_PasswordChanged"/>
                    <TextBlock Style="{StaticResource ValidationErrorText}"
                               Text="{Binding ConfirmPasswordError, StringFormat=⚠ {0}}"
                               Visibility="{Binding ConfirmPasswordError, Converter={StaticResource NullOrEmptyToVis}}"
                               Margin="0,0,0,4"/>
                </StackPanel>

                <StackPanel Grid.Row="1"
                            Orientation="Horizontal"
                            HorizontalAlignment="Right"
                            Margin="0,20,0,0">
                    <Button Style="{StaticResource SecondaryButton}"
                            Content="Cancel"
                            Command="{Binding CancelCommand}"
                            IsCancel="True"
                            Margin="0,0,8,0"
                            Padding="16,8"/>
                    <Button Style="{StaticResource PrimaryButton}"
                            Content="Change password"
                            Command="{Binding ChangeCommand}"
                            Padding="16,8"
                            IsDefault="True"/>
                </StackPanel>
            </Grid>
        </Border>
    </DockPanel>
</Window>