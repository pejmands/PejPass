<Window x:Class="PejPass.Wpf.Views.ChangeMasterPasswordWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Change master password"
        Height="480" Width="440"
        MinHeight="420" MinWidth="400"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        Background="{DynamicResource BgBrush}">

    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <StackPanel>
            <TextBlock Text="Change master password"
                       FontSize="18" FontWeight="Bold"
                       Foreground="{DynamicResource TextBrush}"
                       Margin="0,0,0,8"/>
            <TextBlock Text="The vault file will be re-encrypted with the new password. All entries stay the same."
                       FontSize="12" TextWrapping="Wrap"
                       Foreground="{DynamicResource MutedBrush}"
                       Margin="0,0,0,20"/>

            <TextBlock Text="Current password"
                       Foreground="{DynamicResource MutedBrush}" Margin="0,0,0,6"/>
            <PasswordBox x:Name="CurrentPasswordBox"
                         Margin="0,0,0,16"
                         PasswordChanged="CurrentPasswordBox_PasswordChanged"/>

            <TextBlock Text="New password"
                       Foreground="{DynamicResource MutedBrush}" Margin="0,0,0,6"/>
            <PasswordBox x:Name="NewPasswordBox"
                         Margin="0,0,0,8"
                         PasswordChanged="NewPasswordBox_PasswordChanged"/>

            <Grid Margin="0,0,0,16"
                  Visibility="{Binding ShowNewPasswordStrength, Converter={StaticResource BoolToVis}}">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <ProgressBar Height="6" Minimum="0" Maximum="100"
                             Value="{Binding NewPasswordStrengthProgress}"
                             Background="{DynamicResource SurfaceAltBrush}"/>
                <TextBlock Grid.Column="1" Margin="10,0,0,0" FontSize="11"
                           VerticalAlignment="Center"
                           Text="{Binding NewPasswordStrengthLabel}">
                    <TextBlock.Style>
                        <Style TargetType="TextBlock">
                            <Setter Property="Foreground" Value="{DynamicResource MutedBrush}"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding NewPasswordStrengthLevel}" Value="1">
                                    <Setter Property="Foreground" Value="{DynamicResource DangerBrush}"/>
                                </DataTrigger>
                                <DataTrigger Binding="{Binding NewPasswordStrengthLevel}" Value="2">
                                    <Setter Property="Foreground" Value="{DynamicResource DangerBrush}"/>
                                </DataTrigger>
                                <DataTrigger Binding="{Binding NewPasswordStrengthLevel}" Value="3">
                                    <Setter Property="Foreground" Value="{DynamicResource WarningBrush}"/>
                                </DataTrigger>
                                <DataTrigger Binding="{Binding NewPasswordStrengthLevel}" Value="4">
                                    <Setter Property="Foreground" Value="{DynamicResource SuccessBrush}"/>
                                </DataTrigger>
                                <DataTrigger Binding="{Binding NewPasswordStrengthLevel}" Value="5">
                                    <Setter Property="Foreground" Value="{DynamicResource SuccessBrush}"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBlock.Style>
                </TextBlock>
            </Grid>

            <TextBlock Text="Confirm new password"
                       Foreground="{DynamicResource MutedBrush}" Margin="0,0,0,6"/>
            <PasswordBox x:Name="ConfirmPasswordBox"
                         Margin="0,0,0,12"
                         PasswordChanged="ConfirmPasswordBox_PasswordChanged"/>

            <TextBlock Text="{Binding ErrorMessage}"
                       Foreground="{DynamicResource DangerBrush}"
                       TextWrapping="Wrap"
                       MinHeight="20"
                       Visibility="{Binding ErrorMessage, Converter={StaticResource NullOrEmptyToVis}}"/>
        </StackPanel>

        <StackPanel Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0">
            <Button Content="Cancel" Command="{Binding CancelCommand}" Margin="0,0,8,0"
                    Background="{DynamicResource SurfaceAltBrush}" Foreground="{DynamicResource TextBrush}"/>
            <Button Content="Change password" Command="{Binding ChangeCommand}" IsDefault="True"/>
        </StackPanel>
    </Grid>
</Window>
