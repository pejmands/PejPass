<Window x:Class="PejPass.Wpf.Views.LoginWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="clr-namespace:PejPass.Wpf.Controls"
        Title="PejPass — Unlock or Create Vault"
        SizeToContent="Height"
        Height="450"
        Width="500"
        MinHeight="450"
        MinWidth="400"
        WindowStartupLocation="CenterScreen"
        ResizeMode="CanMinimize"
        Background="{DynamicResource BgBrush}">

    <DockPanel>
        <controls:AppTitleBar DockPanel.Dock="Top"
                              ShowMinimize="true"
                              ShowMaximize="false"/>

        <ScrollViewer VerticalScrollBarVisibility="Auto"
                      HorizontalScrollBarVisibility="Disabled"
                      Margin="20">

            <StackPanel VerticalAlignment="Top"
                        MaxWidth="440">

                <TextBlock Text="PejPass"
                           FontSize="{DynamicResource AppFontSize28}"
                           FontWeight="Bold"
                           Foreground="{DynamicResource TextBrush}"
                           HorizontalAlignment="Center"
                           Margin="0,0,0,8"/>

                <TextBlock Text="Local encrypted vault"
                           FontSize="{DynamicResource AppFontSize13}"
                           Foreground="{DynamicResource MutedBrush}"
                           HorizontalAlignment="Center"
                           Margin="0,0,0,28"/>

                <!-- Recent vaults -->
                <Grid Margin="0,0,0,10">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <Button x:Name="RecentsButton"
                            Grid.Column="0"
                            HorizontalAlignment="Left"
                            Style="{StaticResource SecondaryButton}"
                            Content="Recents ▾"
                            Padding="8,4"
                            Height="28"
                            IsEnabled="{Binding HasRecentVaults}"
                            Click="RecentsButton_Click"
                            Background="{DynamicResource SurfaceAltBrush}"
                            Foreground="{DynamicResource TextBrush}">
                        <Button.ContextMenu>
                            <ContextMenu x:Name="RecentVaultsMenu"
                                         Style="{StaticResource PejPassContextMenu}"
                                         Placement="Bottom"
                                         DataContext="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource Self}}"
                                         ItemsSource="{Binding RecentVaults}">
                                <ContextMenu.ItemContainerStyle>
                                    <Style TargetType="MenuItem"
                                           BasedOn="{StaticResource PejPassContextMenuItem}">
                                        <Setter Property="Command"
                                                Value="{Binding DataContext.SelectRecentVaultCommand, RelativeSource={RelativeSource AncestorType={x:Type ContextMenu}}}"/>
                                        <Setter Property="CommandParameter"
                                                Value="{Binding}"/>
                                        <Setter Property="ToolTip"
                                                Value="{Binding Path}"/>
                                        <Setter Property="HeaderTemplate">
                                            <Setter.Value>
                                                <DataTemplate>
                                                    <StackPanel MaxWidth="340">
                                                        <TextBlock Text="{Binding DisplayName}"
                                                                   Foreground="{DynamicResource TextBrush}"
                                                                   TextTrimming="CharacterEllipsis"/>
                                                        <TextBlock Text="{Binding Path}"
                                                                   Foreground="{DynamicResource MutedBrush}"
                                                                   FontSize="11"
                                                                   TextTrimming="CharacterEllipsis"/>
                                                    </StackPanel>
                                                </DataTemplate>
                                            </Setter.Value>
                                        </Setter>
                                    </Style>
                                </ContextMenu.ItemContainerStyle>
                            </ContextMenu>
                        </Button.ContextMenu>
                    </Button>
                </Grid>

                <!-- Mode -->
                <StackPanel Orientation="Horizontal"
                            HorizontalAlignment="Center"
                            Margin="0,0,0,20">

                    <RadioButton Content="Open vault"
                                 IsChecked="{Binding IsOpenMode}"
                                 GroupName="VaultMode"
                                 Checked="VaultMode_Checked"
                                 Margin="0,0,16,0"/>

                    <RadioButton Content="Create vault"
                                 GroupName="VaultMode"
                                 Checked="VaultMode_Checked"
                                 IsChecked="{Binding IsCreateMode}"/>
                </StackPanel>

                <!-- Path -->
                <TextBlock Text="Vault file"
                           Foreground="{DynamicResource MutedBrush}"
                           Margin="0,0,0,6"/>

                <Grid Margin="0,0,0,16">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <TextBox x:Name="VaultPathTextBox"
                             Text="{Binding VaultPath, UpdateSourceTrigger=PropertyChanged}"
                             TextWrapping="NoWrap"
                             VerticalScrollBarVisibility="Disabled"/>

                    <Button Grid.Column="1"
                            Style="{StaticResource SecondaryButton}"
                            Content="Browse…"
                            Command="{Binding BrowseCommand}"
                            Margin="8,0,0,0"
                            Background="{DynamicResource SurfaceAltBrush}"
                            Foreground="{DynamicResource TextBrush}"/>
                </Grid>

                <TextBlock Style="{StaticResource ValidationErrorText}"
                           Text="{Binding VaultPathError, StringFormat=⚠ {0}}"
                           Visibility="{Binding VaultPathError, Converter={StaticResource NullOrEmptyToVis}}"
                           Margin="0,-4,0,12"/>

                <!-- Password -->
                <TextBlock Text="Master password"
                           Foreground="{DynamicResource MutedBrush}"
                           Margin="0,0,0,6"/>

                <controls:PasswordRevealBox x:Name="MasterPasswordBox"
                                       PasswordChanged="MasterPasswordBox_PasswordChanged"
                                       ShowRevealButton="{Binding IsCreateMode}"
                                       Margin="0,0,0,12"
                                       Visibility="Visible"/>

                <!-- Confirm password (create mode) -->
                <TextBlock Text="Confirm master password"
           Visibility="{Binding IsCreateMode, Converter={StaticResource BoolToVis}}"
           Foreground="{DynamicResource MutedBrush}"
           Margin="0,0,0,6"/>

                <controls:PasswordRevealBox x:Name="ConfirmMasterPasswordBox"
                                       PasswordChanged="ConfirmMasterPasswordBox_PasswordChanged"
                                       ShowRevealButton="{Binding IsCreateMode}"
                                       Margin="0,0,0,12"
                                       Visibility="{Binding IsCreateMode, Converter={StaticResource BoolToVis}}"/>

                <TextBlock Style="{StaticResource ValidationErrorText}"
           Text="{Binding ConfirmPasswordError, StringFormat=⚠ {0}}"
           Visibility="{Binding ConfirmPasswordError, Converter={StaticResource NullOrEmptyToVis}}"
           Margin="0,0,0,12"/>

                <!-- Create mode guidance -->
                <TextBlock Text="This password protects your entire vault. PejPass cannot recover it if you forget it."
                           Visibility="{Binding IsCreateMode, Converter={StaticResource BoolToVis}}"
                           Foreground="{DynamicResource MutedBrush}"
                           TextWrapping="Wrap"
                           FontSize="{DynamicResource AppFontSize12}"
                           Margin="0,0,0,12"/>

                <!-- Strength (create mode) -->
                <controls:PasswordStrengthIndicator
    Visibility="{Binding ShowMasterPasswordStrength, Converter={StaticResource BoolToVis}}"
    StrengthLabel="{Binding MasterPasswordStrengthLabel}"
    StrengthLevel="{Binding MasterPasswordStrengthLevel}"
    StrengthProgress="{Binding MasterPasswordStrengthProgress}"
    Margin="0,0,0,20"/>

                <TextBlock Text="Tip: Use a memorable combination of words and characters without spaces."
                           Visibility="{Binding IsCreateMode, Converter={StaticResource BoolToVis}}"
                           Foreground="{DynamicResource MutedBrush}"
                           FontSize="{DynamicResource AppFontSize12}"
                           TextWrapping="Wrap"
                           Margin="0,0,0,12"/>

                <TextBlock Style="{StaticResource ValidationErrorText}"
                           Text="{Binding PasswordError, StringFormat=⚠ {0}}"
                           Visibility="{Binding PasswordError, Converter={StaticResource NullOrEmptyToVis}}"
                           Margin="0,0,0,12"/>

                <TextBlock Text="{Binding StatusMessage}"
                           Foreground="{DynamicResource AccentBrush}"
                           TextWrapping="Wrap"
                           Margin="0,0,0,12"/>

                <Button Style="{StaticResource PrimaryButton}"
                        Content="{Binding SubmitButtonText}"
                        Command="{Binding SubmitCommand}"
                        IsDefault="True"
                        Height="40"
                        Margin="0,0,0,12"/>

                <Button Style="{StaticResource SecondaryButton}"
                        Content="Unlock with Windows Hello"
                        Command="{Binding UnlockWithHelloCommand}"
                        Visibility="{Binding ShowWindowsHello, Converter={StaticResource BoolToVis}}"
                        Background="{DynamicResource SurfaceAltBrush}"
                        Foreground="{DynamicResource TextBrush}"
                        Height="40"/>

            </StackPanel>
        </ScrollViewer>
    </DockPanel>
</Window>
