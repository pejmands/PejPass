<Window x:Class="PejPass.Wpf.Views.LoginWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:PejPass.Wpf.ViewModels"
        Title="PejPass — Unlock or Create Vault"
        Height="520" Width="440"
        WindowStartupLocation="CenterScreen"
        ResizeMode="NoResize"
        Background="{StaticResource BgBrush}">

    <Grid Margin="32">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <StackPanel Grid.Row="0" Margin="0,0,0,24">
            <TextBlock Text="PejPass" FontSize="36" FontWeight="Bold"
                       Foreground="{StaticResource TextBrush}" HorizontalAlignment="Center"/>
            <TextBlock Text="Local • Offline • Secure" FontSize="13"
                       Foreground="{StaticResource MutedBrush}" HorizontalAlignment="Center" Margin="0,4,0,0"/>
        </StackPanel>

        <!-- Form -->
        <StackPanel Grid.Row="1">
            <TextBlock Text="Vault Path" Foreground="{StaticResource MutedBrush}" Margin="0,0,0,4"/>
            <Grid Margin="0,0,0,16">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBox Text="{Binding VaultPath, UpdateSourceTrigger=PropertyChanged}"
                         IsReadOnly="True"/>
                <Button Grid.Column="1" Content="Browse" Margin="8,0,0,0"
                        Command="{Binding BrowseCommand}" Padding="12,8"/>
            </Grid>

            <TextBlock Text="Master Password" Foreground="{StaticResource MutedBrush}" Margin="0,0,0,4"/>
            <PasswordBox x:Name="PasswordBox" Margin="0,0,0,8"
                         PasswordChanged="PasswordBox_OnPasswordChanged"/>

            <TextBlock Text="{Binding PasswordError}" Foreground="{StaticResource DangerBrush}"
                       TextWrapping="Wrap" Margin="0,0,0,16" MinHeight="20"/>

            <!-- Mode toggle -->
            <StackPanel Orientation="Horizontal" Margin="0,0,0,16">
                <RadioButton Content="Open existing" IsChecked="{Binding IsOpenMode}"
                             Foreground="{StaticResource TextBrush}" Margin="0,0,16,0"/>
                <RadioButton Content="Create new" IsChecked="{Binding IsCreateMode}"
                             Foreground="{StaticResource TextBrush}"/>
            </StackPanel>

            <TextBlock Text="{Binding StatusMessage}" Foreground="{StaticResource AccentBrush}"
                       TextWrapping="Wrap" Margin="0,0,0,8"/>
        </StackPanel>

        <!-- Actions -->
        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right">
            <Button Content="Unlock / Create" Command="{Binding SubmitCommand}"
                    IsDefault="True" Padding="24,10"/>
        </StackPanel>
    </Grid>
</Window>
