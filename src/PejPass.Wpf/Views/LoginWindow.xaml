<Window x:Class="PejPass.Wpf.Views.LoginWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="PejPass — Unlock or Create Vault"
        Height="520" Width="480"
        MinHeight="440" MinWidth="400"
        WindowStartupLocation="CenterScreen"
        ResizeMode="CanMinimize"
        Background="{DynamicResource BgBrush}">

    <ScrollViewer VerticalScrollBarVisibility="Auto"
                  HorizontalScrollBarVisibility="Disabled"
                  Padding="32,28">
        <StackPanel VerticalAlignment="Center" MaxWidth="416">

            <TextBlock Text="PejPass" FontSize="28" FontWeight="Bold"
                       Foreground="{DynamicResource TextBrush}" HorizontalAlignment="Center" Margin="0,0,0,8"/>
            <TextBlock Text="Local • Offline • Secure" FontSize="13"
                       Foreground="{DynamicResource MutedBrush}" HorizontalAlignment="Center" Margin="0,0,0,24"/>

            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,0,0,20">
                <RadioButton Content="Open vault" IsChecked="{Binding IsOpenMode}" Margin="0,0,20,0"
                             Foreground="{DynamicResource TextBrush}"/>
                <RadioButton Content="Create vault" IsChecked="{Binding IsCreateMode}"
                             Foreground="{DynamicResource TextBrush}"/>
            </StackPanel>

            <TextBlock Text="Vault path" Foreground="{DynamicResource MutedBrush}" Margin="0,0,0,4"/>
            <Grid Margin="0,0,0,16">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBox Text="{Binding VaultPath, UpdateSourceTrigger=PropertyChanged}"
                         VerticalContentAlignment="Center" Padding="8,6"/>
                <Button Grid.Column="1" Content="Browse" Command="{Binding BrowseCommand}"
                        Margin="8,0,0,0" Padding="12,6"
                        Background="{DynamicResource SurfaceAltBrush}" Foreground="{DynamicResource TextBrush}"/>
            </Grid>

            <TextBlock Text="Master password" Foreground="{DynamicResource MutedBrush}" Margin="0,0,0,4"/>
            <PasswordBox x:Name="MasterPasswordBox"
                         PasswordChanged="MasterPasswordBox_PasswordChanged"
                         Margin="0,0,0,12" Padding="8,6"/>

            <Button Content="Unlock with Windows Hello"
                    Command="{Binding UnlockWithHelloCommand}"
                    Margin="0,0,0,12" Padding="16,10"
                    Background="{DynamicResource SurfaceAltBrush}"
                    Foreground="{DynamicResource TextBrush}"
                    Visibility="{Binding ShowWindowsHello, Converter={StaticResource BoolToVis}}"/>

            <Border Background="{DynamicResource SurfaceBrush}"
                    BorderBrush="{DynamicResource DangerBrush}"
                    BorderThickness="1"
                    CornerRadius="6"
                    Padding="12,10"
                    Margin="0,0,0,12"
                    Visibility="{Binding PasswordError, Converter={StaticResource NullOrEmptyToVis}}">
                <TextBlock Text="{Binding PasswordError}"
                           Foreground="{DynamicResource DangerBrush}"
                           TextWrapping="Wrap"
                           FontSize="13"/>
            </Border>

            <TextBlock Text="{Binding StatusMessage}"
                       Foreground="{DynamicResource AccentBrush}"
                       TextWrapping="Wrap"
                       Margin="0,0,0,16"
                       MinHeight="18"/>

            <Button Content="Continue" Command="{Binding SubmitCommand}" IsDefault="True"
                    HorizontalAlignment="Stretch" Padding="16,10"/>
        </StackPanel>
    </ScrollViewer>
</Window>
