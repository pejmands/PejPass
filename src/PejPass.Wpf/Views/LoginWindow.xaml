<Window x:Class="PejPass.Wpf.Views.LoginWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="PejPass — Unlock or Create Vault"
        Height="520"
        Width="480"
        MinHeight="440"
        MinWidth="400"
        WindowStartupLocation="CenterScreen"
        ResizeMode="CanMinimize"
        Background="{DynamicResource BgBrush}">

    <ScrollViewer VerticalScrollBarVisibility="Auto"
                  HorizontalScrollBarVisibility="Disabled"
                  Padding="32">

        <StackPanel VerticalAlignment="Center"
                    MaxWidth="416">

            <TextBlock Text="PejPass"
                       FontSize="28"
                       FontWeight="Bold"
                       Foreground="{DynamicResource TextBrush}"
                       HorizontalAlignment="Center"
                       Margin="0,0,0,8"/>

            <TextBlock Text="Local • Offline • Secure"
                       FontSize="13"
                       Foreground="{DynamicResource MutedBrush}"
                       HorizontalAlignment="Center"
                       Margin="0,0,0,24"/>

            <StackPanel Orientation="Horizontal"
                        HorizontalAlignment="Center"
                        Margin="0,0,0,20">

                <RadioButton Content="Open vault"
                             IsChecked="{Binding IsOpenMode}"
                             Margin="0,0,20,0"
                             Foreground="{DynamicResource TextBrush}"/>

                <RadioButton Content="Create vault"
                             IsChecked="{Binding IsCreateMode}"
                             Foreground="{DynamicResource TextBrush}"/>
            </StackPanel>

            <TextBlock Text="Vault path"
                       Foreground="{DynamicResource MutedBrush}"
                       Margin="0,0,0,6"/>

            <Grid Margin="0,0,0,16">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <TextBox Text="{Binding VaultPath, UpdateSourceTrigger=PropertyChanged}"
                         VerticalContentAlignment="Center"/>

                <Button Grid.Column="1"
                        Content="Browse"
                        Command="{Binding BrowseCommand}"
                        Margin="8,0,0,0"
                        Background="{DynamicResource SurfaceAltBrush}"
                        Foreground="{DynamicResource TextBrush}"/>
            </Grid>

            <TextBlock Text="Master password"
                       Foreground="{DynamicResource MutedBrush}"
                       Margin="0,0,0,6"/>

            <PasswordBox x:Name="MasterPasswordBox"
                         PasswordChanged="MasterPasswordBox_PasswordChanged"/>

            <Grid Margin="2,8,2,0"
                  Visibility="{Binding ShowMasterPasswordStrength, Converter={StaticResource BoolToVis}}">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <ProgressBar Height="6"
                             Minimum="0"
                             Maximum="100"
                             Value="{Binding MasterPasswordStrengthProgress}"
                             Background="{DynamicResource SurfaceAltBrush}"/>

                <TextBlock Grid.Column="1"
                           Margin="10,0,0,0"
                           FontSize="11"
                           VerticalAlignment="Center"
                           Text="{Binding MasterPasswordStrengthLabel}">

                    <TextBlock.Style>
                        <Style TargetType="TextBlock">
                            <Setter Property="Foreground"
                                    Value="{DynamicResource MutedBrush}"/>

                            <Style.Triggers>
                                <DataTrigger Binding="{Binding MasterPasswordStrengthLevel}"
                                             Value="1">
                                    <Setter Property="Foreground"
                                            Value="{DynamicResource DangerBrush}"/>
                                </DataTrigger>

                                <DataTrigger Binding="{Binding MasterPasswordStrengthLevel}"
                                             Value="2">
                                    <Setter Property="Foreground"
                                            Value="{DynamicResource DangerBrush}"/>
                                </DataTrigger>

                                <DataTrigger Binding="{Binding MasterPasswordStrengthLevel}"
                                             Value="3">
                                    <Setter Property="Foreground"
                                            Value="{DynamicResource WarningBrush}"/>
                                </DataTrigger>

                                <DataTrigger Binding="{Binding MasterPasswordStrengthLevel}"
                                             Value="4">
                                    <Setter Property="Foreground"
                                            Value="{DynamicResource SuccessBrush}"/>
                                </DataTrigger>

                                <DataTrigger Binding="{Binding MasterPasswordStrengthLevel}"
                                             Value="5">
                                    <Setter Property="Foreground"
                                            Value="{DynamicResource SuccessBrush}"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBlock.Style>
                </TextBlock>
            </Grid>

            <Button Content="Unlock with Windows Hello"
                    Margin="0,16,0,0"
                    Command="{Binding UnlockWithHelloCommand}"
                    Background="{DynamicResource SurfaceAltBrush}"
                    Foreground="{DynamicResource TextBrush}"
                    Visibility="{Binding ShowWindowsHello, Converter={StaticResource BoolToVis}}"/>

            <Border Margin="0,8,0,0"
                Visibility="{Binding PasswordError, Converter={StaticResource NullOrEmptyToVis}}">

                <TextBlock Text="{Binding PasswordError}"
                           Foreground="{DynamicResource DangerBrush}"
                           TextWrapping="Wrap"
                           FontSize="13"/>
            </Border>

            <TextBlock Text="{Binding StatusMessage}"
                       Foreground="{DynamicResource AccentBrush}"
                       TextWrapping="Wrap"
                       Margin="0,8,0,16"
                       MinHeight="18"/>

            <Button Content="Continue"
                    Command="{Binding SubmitCommand}"
                    IsDefault="True"
                    HorizontalAlignment="Stretch"/>
        </StackPanel>
    </ScrollViewer>
</Window>
