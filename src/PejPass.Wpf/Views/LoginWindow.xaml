<Window x:Class="PejPass.Wpf.Views.LoginWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="clr-namespace:PejPass.Wpf.Controls"
        Title="PejPass — Unlock or Create Vault"
        Height="520"
        Width="480"
        MinHeight="440"
        MinWidth="400"
        WindowStartupLocation="CenterScreen"
        ResizeMode="CanMinimize"
        Background="{DynamicResource BgBrush}">
    <DockPanel>
        <controls:AppTitleBar DockPanel.Dock="Top" ShowMinimize="true" ShowMaximize="false"/>

    <ScrollViewer VerticalScrollBarVisibility="Auto"
                  HorizontalScrollBarVisibility="Disabled"
                  Padding="32">

        <StackPanel VerticalAlignment="Center"
                    MaxWidth="416">

            <TextBlock Text="PejPass"
                       FontSize="28"
                       FontWeight="Bold"
                       Foreground="{DynamicResource TextBrush}"
                       HorizontalAlignment="Center"
                       Margin="0,0,0,8"/>

            <TextBlock Text="Local encrypted vault"
                       FontSize="13"
                       Foreground="{DynamicResource MutedBrush}"
                       HorizontalAlignment="Center"
                       Margin="0,0,0,28"/>

            <!-- Mode -->
            <StackPanel Orientation="Horizontal"
                        HorizontalAlignment="Center"
                        Margin="0,0,0,20">
                <RadioButton Content="Open vault"
                             IsChecked="{Binding IsOpenMode}"
                             Margin="0,0,16,0"/>
                <RadioButton Content="Create vault"
                             IsChecked="{Binding IsCreateMode}"/>
            </StackPanel>

            <!-- Path -->
            <TextBlock Text="Vault file"
                       Foreground="{DynamicResource MutedBrush}"
                       Margin="0,0,0,6"/>

            <Grid Margin="0,0,0,16">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBox Text="{Binding VaultPath, UpdateSourceTrigger=PropertyChanged}"
                         TextWrapping="NoWrap"
                         HorizontalScrollBarVisibility="Auto"
                         VerticalScrollBarVisibility="Disabled"/>
                <Button Grid.Column="1"
                        Content="Browse…"
                        Command="{Binding BrowseCommand}"
                        Margin="8,0,0,0"
                        Background="{DynamicResource SurfaceAltBrush}"
                        Foreground="{DynamicResource TextBrush}"/>
            </Grid>

            <!-- Password -->
            <TextBlock Text="Master password"
                       Foreground="{DynamicResource MutedBrush}"
                       Margin="0,0,0,6"/>

            <PasswordBox x:Name="MasterPasswordBox"
                         PasswordChanged="MasterPasswordBox_PasswordChanged"
                         Margin="0,0,0,8"/>

            <!-- Strength (create mode) -->
            <StackPanel Visibility="{Binding ShowMasterPasswordStrength, Converter={StaticResource BoolToVis}}"
                        Margin="0,0,0,12">
                <ProgressBar Height="6"
                             Minimum="0" Maximum="100"
                             Value="{Binding MasterPasswordStrengthProgress}"
                             Background="{DynamicResource SurfaceAltBrush}"/>
                <TextBlock Text="{Binding MasterPasswordStrengthLabel}"
                           FontSize="11"
                           Foreground="{DynamicResource MutedBrush}"
                           Margin="0,4,0,0"/>
            </StackPanel>

            <TextBlock Text="{Binding PasswordError}"
                       Foreground="{DynamicResource DangerBrush}"
                       TextWrapping="Wrap"
                       Margin="0,0,0,12"/>

            <TextBlock Text="{Binding StatusMessage}"
                       Foreground="{DynamicResource AccentBrush}"
                       TextWrapping="Wrap"
                       Margin="0,0,0,12"/>

            <Button Content="Continue"
                    Command="{Binding SubmitCommand}"
                    IsDefault="True"
                    Height="40"
                    Margin="0,0,0,12"/>

            <Button Content="Unlock with Windows Hello"
                    Command="{Binding UnlockWithHelloCommand}"
                    Visibility="{Binding ShowWindowsHello, Converter={StaticResource BoolToVis}}"
                    Background="{DynamicResource SurfaceAltBrush}"
                    Foreground="{DynamicResource TextBrush}"
                    Height="40"/>
        </StackPanel>
    </ScrollViewer>
    </DockPanel>
</Window>
