<Window x:Class="PejPass.Wpf.Views.TrashWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Trash"
        Height="480" Width="640"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource BgBrush}">

    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Grid Margin="0,0,0,16">
            <TextBlock Text="Trash" FontSize="22" FontWeight="Bold"
                       Foreground="{DynamicResource TextBrush}"/>
            <Button Content="Empty Trash" Command="{Binding EmptyTrashCommand}"
                    HorizontalAlignment="Right" Padding="12,6"
                    Background="{DynamicResource DangerBrush}"/>
        </Grid>

        <ListBox Grid.Row="1" ItemsSource="{Binding Items}" Background="Transparent" BorderThickness="0">
            <ListBox.ItemContainerStyle>
                <Style TargetType="ListBoxItem">
                    <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                    <Setter Property="Padding" Value="0"/>
                    <Setter Property="Margin" Value="0,0,0,6"/>
                    <Setter Property="Template">
                        <Setter.Value>
                            <ControlTemplate TargetType="ListBoxItem">
                                <Border Background="{DynamicResource SurfaceBrush}" CornerRadius="8" Padding="14,12">
                                    <ContentPresenter/>
                                </Border>
                            </ControlTemplate>
                        </Setter.Value>
                    </Setter>
                </Style>
            </ListBox.ItemContainerStyle>
            <ListBox.ItemTemplate>
                <DataTemplate>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel>
                            <TextBlock Text="{Binding Title}" FontWeight="SemiBold"
                                       Foreground="{DynamicResource TextBrush}"/>
                            <!-- Run.Text defaults to TwoWay; TrashRow props are get-only → must use OneWay -->
                            <TextBlock FontSize="12" Foreground="{DynamicResource MutedBrush}" Margin="0,2,0,0">
                                <Run Text="{Binding Username, Mode=OneWay}"/>
                                <Run Text=" · deleted "/>
                                <Run Text="{Binding DeletedAtText, Mode=OneWay}"/>
                                <Run Text=" · "/>
                                <Run Text="{Binding DaysLeftText, Mode=OneWay}"/>
                            </TextBlock>
                        </StackPanel>
                        <Button Grid.Column="1" Content="Restore" Margin="8,0,0,0" Padding="12,6"
                                Command="{Binding DataContext.RestoreCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                CommandParameter="{Binding}"/>
                        <Button Grid.Column="2" Content="Purge" Margin="8,0,0,0" Padding="12,6"
                                Command="{Binding DataContext.PurgeCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                CommandParameter="{Binding}"
                                Background="{DynamicResource DangerBrush}"/>
                    </Grid>
                </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>

        <Grid Grid.Row="2" Margin="0,16,0,0">
            <TextBlock Text="{Binding StatusMessage}" Foreground="{DynamicResource MutedBrush}"
                       VerticalAlignment="Center"/>
            <Button Content="Close" HorizontalAlignment="Right" Click="Close_Click" Padding="20,8"
                    Background="{DynamicResource SurfaceAltBrush}" Foreground="{DynamicResource TextBrush}"/>
        </Grid>
    </Grid>
</Window>
