<Window x:Class="PejPass.Wpf.Views.TrashWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="clr-namespace:PejPass.Wpf.Controls"
        Title="Trash"
        Height="545"
        Width="700"
        MinWidth="520"
        MinHeight="440"
        WindowStartupLocation="CenterOwner"
        ResizeMode="CanResize"
        ShowInTaskbar="False"
        Background="{DynamicResource BgBrush}">

    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <Grid Margin="0,0,0,12">
            <TextBlock Text="Trash"
                       FontSize="{DynamicResource AppFontSize22}"
                       FontWeight="Bold"
                       Foreground="{DynamicResource TextBrush}"/>

            <Button Style="{StaticResource DestructiveButton}"
                    Content="Empty Trash"
                    Command="{Binding EmptyTrashCommand}"
                    HorizontalAlignment="Right"
                    Background="{DynamicResource DangerBrush}"/>
        </Grid>

        <!-- Search -->
        <controls:SearchBox x:Name="TrashSearchBox"
                          Grid.Row="1"
                          Margin="0,0,0,12"
                          Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"
                          Placeholder="Search trash..."
                          ToolTip="Search trash by title, username, or URL"/>

        <!-- Trash items -->
        <Grid Grid.Row="2">
            <ListBox x:Name="TrashList"
                 ItemsSource="{Binding Items}"
                 SelectionMode="Extended"
                 Background="Transparent"
                 ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                 BorderThickness="0">

            <ListBox.ItemContainerStyle>
                <Style TargetType="ListBoxItem">
                    <Setter Property="HorizontalContentAlignment"
                            Value="Stretch"/>
                    <Setter Property="Padding"
                            Value="0"/>
                    <Setter Property="Margin"
                            Value="0,0,0,6"/>

                    <Setter Property="Template">
                        <Setter.Value>
                            <ControlTemplate TargetType="ListBoxItem">
                                <Border x:Name="ItemBorder"
                                        Background="{DynamicResource SurfaceBrush}"
                                        BorderBrush="Transparent"
                                        BorderThickness="1"
                                        CornerRadius="8"
                                        Padding="12,10">
                                    <ContentPresenter/>
                                </Border>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsSelected" Value="True">
                                        <Setter TargetName="ItemBorder"
                                                Property="Background"
                                                Value="{DynamicResource SurfaceAltBrush}"/>
                                        <Setter TargetName="ItemBorder"
                                                Property="BorderBrush"
                                                Value="{DynamicResource AccentBrush}"/>
                                    </Trigger>
                                    <Trigger Property="IsKeyboardFocusWithin" Value="True">
                                        <Setter TargetName="ItemBorder"
                                                Property="BorderBrush"
                                                Value="{DynamicResource AccentBrush}"/>
                                    </Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </Setter.Value>
                    </Setter>
                </Style>
            </ListBox.ItemContainerStyle>

            <ListBox.ItemTemplate>
                <DataTemplate>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <Border Width="28"
                                Height="28"
                                CornerRadius="6"
                                ClipToBounds="True"
                                Background="{DynamicResource SurfaceAltBrush}"
                                VerticalAlignment="Center"
                                Margin="0,0,10,0">
                            <Image Source="{Binding Converter={StaticResource FaviconConv}}"
                                   Stretch="UniformToFill"
                                   RenderOptions.BitmapScalingMode="HighQuality"/>
                        </Border>

                        <StackPanel Grid.Column="1"
                                    VerticalAlignment="Center">

                            <TextBlock Text="{Binding Title}"
                                       FontWeight="SemiBold"
                                       Foreground="{DynamicResource TextBrush}"
                                       TextTrimming="CharacterEllipsis"/>

                                <TextBlock Text="{Binding Username, Mode=OneWay}"
                                       FontSize="{DynamicResource AppFontSize12}"
                                       Foreground="{DynamicResource MutedBrush}"
                                       Margin="0,2,0,0"
                                       TextTrimming="CharacterEllipsis">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock">
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding Username}" Value="">
                                                    <Setter Property="Visibility" Value="Collapsed"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                            
                                <TextBlock FontSize="{DynamicResource AppFontSize11}"
                                       Foreground="{DynamicResource MutedBrush}"
                                       Margin="0,2,0,0"
                                       TextTrimming="CharacterEllipsis">
                                <Run Text="Deleted"/>
                                <Run Text="{Binding DeletedAtText, Mode=OneWay}"/>
                                <Run Text=" · "/>
                                <Run Text="{Binding DaysLeftText, Mode=OneWay}"/>
                            </TextBlock>
                        </StackPanel>

                        <Button Grid.Column="2"
                                Style="{StaticResource SecondaryButton}"
                                Content="Restore"
                                Height="32"
                                Margin="8,0,0,0"
                                Padding="12,4"
                                Command="{Binding DataContext.RestoreCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                CommandParameter="{Binding}"/>

                        <Button Grid.Column="3"
                                Style="{StaticResource DestructiveButton}"
                                Content="Delete permanently"
                                Height="32"
                                Margin="8,0,0,0"
                                Padding="12,4"
                                Command="{Binding DataContext.PurgeCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                CommandParameter="{Binding}"
                                Background="{DynamicResource DangerBrush}"
                                ToolTip="Permanently delete this entry. It cannot be recovered."/>
                    </Grid>
                </DataTemplate>
            </ListBox.ItemTemplate>
            </ListBox>

            <StackPanel HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        Visibility="{Binding IsTrashEmpty, Converter={StaticResource BoolToVis}}">
                <TextBlock Text="Trash is empty"
                           FontSize="{DynamicResource AppFontSize16}"
                           FontWeight="SemiBold"
                           Foreground="{DynamicResource TextBrush}"
                           HorizontalAlignment="Center"/>
                <TextBlock Text="Deleted entries you remove will appear here."
                           FontSize="{DynamicResource AppFontSize13}"
                           Margin="0,8,0,0"
                           Foreground="{DynamicResource MutedBrush}"
                           HorizontalAlignment="Center"/>
            </StackPanel>

            <StackPanel HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        Visibility="{Binding HasNoSearchResults, Converter={StaticResource BoolToVis}}">
                <TextBlock Text="No matching items"
                           FontSize="{DynamicResource AppFontSize16}"
                           FontWeight="SemiBold"
                           Foreground="{DynamicResource TextBrush}"
                           HorizontalAlignment="Center"/>
                <TextBlock Text="Try a different search."
                           FontSize="{DynamicResource AppFontSize13}"
                           Margin="0,8,0,0"
                           Foreground="{DynamicResource MutedBrush}"
                           HorizontalAlignment="Center"/>
            </StackPanel>
        </Grid>

        <!-- Footer -->
        <Grid Grid.Row="3"
              Margin="0,16,0,0">

            <TextBlock Text="{Binding StatusMessage}"
                       Foreground="{DynamicResource MutedBrush}"
                       VerticalAlignment="Center"/>

            <Button Style="{StaticResource SecondaryButton}"
                    Content="Close"
                    HorizontalAlignment="Right"
                    Click="Close_Click"
                    Background="{DynamicResource SurfaceAltBrush}"
                    Foreground="{DynamicResource TextBrush}"/>
        </Grid>

    </Grid>
</Window>
