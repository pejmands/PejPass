<Window
	x:Class="PejPass.Wpf.Views.TrashWindow"
	xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
	xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
	xmlns:controls="clr-namespace:PejPass.Wpf.Controls"
	Title="Trash"
	Width="700"
	Height="545"
	MinWidth="520"
	MinHeight="440"
	Background="{DynamicResource BgBrush}"
	ResizeMode="CanResize"
	ShowInTaskbar="False"
	WindowStartupLocation="CenterOwner">

	<Grid Margin="24">
		<Grid.RowDefinitions>
			<RowDefinition Height="Auto" />
			<RowDefinition Height="Auto" />
			<RowDefinition Height="*" />
			<RowDefinition Height="Auto" />
		</Grid.RowDefinitions>

		<!--  Header  -->
		<Grid Margin="0,0,0,12">
			<TextBlock
				FontSize="{DynamicResource AppFontSize22}"
				FontWeight="Bold"
				Foreground="{DynamicResource TextBrush}"
				Text="Trash" />

			<Button
				HorizontalAlignment="Right"
				Background="{DynamicResource DangerBrush}"
				Command="{Binding EmptyTrashCommand}"
				Content="Empty Trash"
				Style="{StaticResource DestructiveButton}" />
		</Grid>

		<!--  Search  -->
		<controls:SearchBox
			x:Name="TrashSearchBox"
			Grid.Row="1"
			Margin="0,0,0,12"
			Placeholder="Search trash..."
			Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"
			ToolTip="Search trash by title, username, or URL" />

		<!--  Trash items  -->
		<Grid Grid.Row="2">
			<ListBox
				x:Name="TrashList"
				Background="Transparent"
				BorderThickness="0"
				ItemsSource="{Binding Items}"
				ScrollViewer.HorizontalScrollBarVisibility="Disabled"
				SelectionMode="Extended">

				<ListBox.ItemContainerStyle>
					<Style TargetType="ListBoxItem">
						<Setter Property="HorizontalContentAlignment" Value="Stretch" />
						<Setter Property="Padding" Value="0" />
						<Setter Property="Margin" Value="0,0,0,6" />

						<Setter Property="Template">
							<Setter.Value>
								<ControlTemplate TargetType="ListBoxItem">
									<Border
										x:Name="ItemBorder"
										Padding="12,10"
										Background="{DynamicResource SurfaceBrush}"
										BorderBrush="Transparent"
										BorderThickness="1"
										CornerRadius="8">
										<ContentPresenter />
									</Border>
									<ControlTemplate.Triggers>
										<Trigger Property="IsSelected" Value="True">
											<Setter TargetName="ItemBorder" Property="Background" Value="{DynamicResource SurfaceAltBrush}" />
											<Setter TargetName="ItemBorder" Property="BorderBrush" Value="{DynamicResource AccentBrush}" />
										</Trigger>
										<Trigger Property="IsKeyboardFocusWithin" Value="True">
											<Setter TargetName="ItemBorder" Property="BorderBrush" Value="{DynamicResource AccentBrush}" />
										</Trigger>
									</ControlTemplate.Triggers>
								</ControlTemplate>
							</Setter.Value>
						</Setter>
					</Style>
				</ListBox.ItemContainerStyle>

				<ListBox.ItemTemplate>
					<DataTemplate>
						<Grid>
							<Grid.ColumnDefinitions>
								<ColumnDefinition Width="Auto" />
								<ColumnDefinition Width="*" />
								<ColumnDefinition Width="Auto" />
								<ColumnDefinition Width="Auto" />
							</Grid.ColumnDefinitions>

							<Border
								Width="28"
								Height="28"
								Margin="0,0,10,0"
								VerticalAlignment="Center"
								Background="{DynamicResource SurfaceAltBrush}"
								ClipToBounds="True"
								CornerRadius="6">
								<Image
									RenderOptions.BitmapScalingMode="HighQuality"
									Source="{Binding Converter={StaticResource FaviconConv}}"
									Stretch="UniformToFill" />
							</Border>

							<StackPanel Grid.Column="1" VerticalAlignment="Center">

								<TextBlock
									FontWeight="SemiBold"
									Foreground="{DynamicResource TextBrush}"
									Text="{Binding Title}"
									TextTrimming="CharacterEllipsis" />

								<TextBlock
									Margin="0,2,0,0"
									FontSize="{DynamicResource AppFontSize12}"
									Foreground="{DynamicResource MutedBrush}"
									Text="{Binding Username, Mode=OneWay}"
									TextTrimming="CharacterEllipsis">
									<TextBlock.Style>
										<Style TargetType="TextBlock">
											<Style.Triggers>
												<DataTrigger Binding="{Binding Username}" Value="">
													<Setter Property="Visibility" Value="Collapsed" />
												</DataTrigger>
											</Style.Triggers>
										</Style>
									</TextBlock.Style>
								</TextBlock>

								<TextBlock
									Margin="0,2,0,0"
									FontSize="{DynamicResource AppFontSize11}"
									Foreground="{DynamicResource MutedBrush}"
									TextTrimming="CharacterEllipsis">
									<Run Text="Deleted" />
									<Run Text="{Binding DeletedAtText, Mode=OneWay}" />
									<Run Text=" · " />
									<Run Text="{Binding DaysLeftText, Mode=OneWay}" />
								</TextBlock>
							</StackPanel>

							<Button
								Grid.Column="2"
								Height="32"
								Margin="8,0,0,0"
								Padding="12,4"
								Command="{Binding DataContext.RestoreCommand, RelativeSource={RelativeSource AncestorType=Window}}"
								CommandParameter="{Binding}"
								Content="Restore"
								Style="{StaticResource SecondaryButton}" />

							<Button
								Grid.Column="3"
								Height="32"
								Margin="8,0,0,0"
								Padding="12,4"
								Background="{DynamicResource DangerBrush}"
								Command="{Binding DataContext.PurgeCommand, RelativeSource={RelativeSource AncestorType=Window}}"
								CommandParameter="{Binding}"
								Content="Delete permanently"
								Style="{StaticResource DestructiveButton}"
								ToolTip="Permanently delete this entry. It cannot be recovered." />
						</Grid>
					</DataTemplate>
				</ListBox.ItemTemplate>
			</ListBox>

			<StackPanel
				HorizontalAlignment="Center"
				VerticalAlignment="Center"
				Visibility="{Binding IsTrashEmpty, Converter={StaticResource BoolToVis}}">
				<TextBlock
					HorizontalAlignment="Center"
					FontSize="{DynamicResource AppFontSize16}"
					FontWeight="SemiBold"
					Foreground="{DynamicResource TextBrush}"
					Text="Trash is empty" />
				<TextBlock
					Margin="0,8,0,0"
					HorizontalAlignment="Center"
					FontSize="{DynamicResource AppFontSize13}"
					Foreground="{DynamicResource MutedBrush}"
					Text="Deleted entries you remove will appear here." />
			</StackPanel>

			<StackPanel
				HorizontalAlignment="Center"
				VerticalAlignment="Center"
				Visibility="{Binding HasNoSearchResults, Converter={StaticResource BoolToVis}}">
				<TextBlock
					HorizontalAlignment="Center"
					FontSize="{DynamicResource AppFontSize16}"
					FontWeight="SemiBold"
					Foreground="{DynamicResource TextBrush}"
					Text="No matching items" />
				<TextBlock
					Margin="0,8,0,0"
					HorizontalAlignment="Center"
					FontSize="{DynamicResource AppFontSize13}"
					Foreground="{DynamicResource MutedBrush}"
					Text="Try a different search." />
			</StackPanel>
		</Grid>

		<!--  Footer  -->
		<Grid Grid.Row="3" Margin="0,16,0,0">
			<Grid.ColumnDefinitions>
				<ColumnDefinition Width="*" />
				<ColumnDefinition Width="Auto" />
				<ColumnDefinition Width="Auto" />
			</Grid.ColumnDefinitions>

			<StackPanel VerticalAlignment="Center">
				<TextBlock
					VerticalAlignment="Center"
					Foreground="{DynamicResource MutedBrush}"
					Text="{Binding StatusMessage}" />
				<TextBlock
					x:Name="SelectedTrashCountText"
					Margin="0,4,0,0"
					FontSize="{DynamicResource AppFontSize12}"
					Foreground="{DynamicResource AccentBrush}"
					Visibility="Collapsed" />
			</StackPanel>

			<StackPanel
				Grid.Column="1"
				Margin="8,0,8,0"
				VerticalAlignment="Center"
				Orientation="Horizontal">
				<Button
					x:Name="RestoreSelectedButton"
					Margin="0,0,6,0"
					Click="RestoreSelected_Click"
					Content="Restore selected"
					IsEnabled="False"
					Style="{StaticResource SecondaryButton}" />
				<Button
					x:Name="PurgeSelectedButton"
					Background="{DynamicResource DangerBrush}"
					Click="PurgeSelected_Click"
					Content="Delete selected"
					IsEnabled="False"
					Style="{StaticResource DestructiveButton}"
					ToolTip="Permanently delete selected items." />
			</StackPanel>

			<Button
				Grid.Column="2"
				VerticalAlignment="Center"
				Background="{DynamicResource SurfaceAltBrush}"
				Click="Close_Click"
				Content="Close"
				Foreground="{DynamicResource TextBrush}"
				Style="{StaticResource SecondaryButton}" />
		</Grid>

	</Grid>
</Window>
