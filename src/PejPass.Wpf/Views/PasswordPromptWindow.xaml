<Window
	x:Class="PejPass.Wpf.Views.PasswordPromptWindow"
	xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
	xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
	xmlns:controls="clr-namespace:PejPass.Wpf.Controls"
	Title="Password"
	Width="440"
	MaxHeight="720"
	Background="{DynamicResource BgBrush}"
	ResizeMode="NoResize"
	ShowInTaskbar="False"
	SizeToContent="Height"
	WindowStartupLocation="CenterOwner">
	<DockPanel>
		<controls:AppTitleBar
			DockPanel.Dock="Top"
			ShowMaximize="false"
			ShowMinimize="false" />

		<Border
			Padding="24"
			Background="{DynamicResource SurfaceBrush}"
			BorderBrush="{DynamicResource BorderBrush}"
			BorderThickness="1">
			<Grid>
				<Grid.RowDefinitions>
					<RowDefinition Height="*" />
					<RowDefinition Height="Auto" />
				</Grid.RowDefinitions>

				<ScrollViewer
					Grid.Row="0"
					Margin="0,0,0,8"
					HorizontalScrollBarVisibility="Disabled"
					VerticalScrollBarVisibility="Auto">
					<StackPanel>
						<TextBlock
							x:Name="TitleText"
							Margin="0,0,0,10"
							FontSize="{DynamicResource AppFontSize18}"
							FontWeight="SemiBold"
							Foreground="{DynamicResource TextBrush}"
							TextWrapping="Wrap" />

						<TextBlock
							x:Name="MessageText"
							Margin="0,0,0,20"
							FontSize="{DynamicResource AppFontSize14}"
							Foreground="{DynamicResource MutedBrush}"
							TextWrapping="Wrap" />

						<PasswordBox
							x:Name="PasswordInput"
							Margin="0,0,0,8"
							VerticalContentAlignment="Center" />

						<TextBlock
							x:Name="PasswordErrorText"
							Margin="0,0,0,24"
							Style="{StaticResource ValidationErrorText}"
							TextWrapping="Wrap"
							Visibility="Collapsed" />
					</StackPanel>
				</ScrollViewer>

				<StackPanel
					Grid.Row="1"
					HorizontalAlignment="Right"
					Orientation="Horizontal">
					<Button
						Margin="0,0,8,0"
						Padding="16,8"
						Click="Cancel_Click"
						Content="Cancel"
						IsCancel="True"
						Style="{StaticResource SecondaryButton}" />
					<Button
						x:Name="OkButton"
						Padding="16,8"
						Click="Ok_Click"
						Content="OK"
						IsDefault="True"
						Style="{StaticResource PrimaryButton}" />
				</StackPanel>
			</Grid>
		</Border>
	</DockPanel>
</Window>
