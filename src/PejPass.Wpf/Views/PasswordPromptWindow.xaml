<Window x:Class="PejPass.Wpf.Views.PasswordPromptWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="clr-namespace:PejPass.Wpf.Controls"
        Title="Password"
        Width="440"
        Height="520"
        MinHeight="360"
        MaxHeight="720"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        Background="{DynamicResource BgBrush}">
    <DockPanel>
        <controls:AppTitleBar DockPanel.Dock="Top"
                              ShowMinimize="false"
                              ShowMaximize="false"/>

        <Border BorderBrush="{DynamicResource BorderBrush}"
                BorderThickness="1"
                Background="{DynamicResource SurfaceBrush}"
                Padding="24">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <ScrollViewer Grid.Row="0"
                              VerticalScrollBarVisibility="Auto"
                              HorizontalScrollBarVisibility="Disabled"
                              Margin="0,0,0,20">
                    <StackPanel>
                        <TextBlock x:Name="TitleText"
                                   FontSize="{DynamicResource AppFontSize18}"
                                   FontWeight="SemiBold"
                                   Foreground="{DynamicResource TextBrush}"
                                   Margin="0,0,0,10"
                                   TextWrapping="Wrap"/>

                        <TextBlock x:Name="MessageText"
                                   FontSize="{DynamicResource AppFontSize14}"
                                   Foreground="{DynamicResource MutedBrush}"
                                   TextWrapping="Wrap"
                                   Margin="0,0,0,20"/>

                        <PasswordBox x:Name="PasswordInput"
                                     VerticalContentAlignment="Center"
                                     Margin="0,0,0,8"/>

                        <TextBlock x:Name="PasswordErrorText"
                                   Style="{StaticResource ValidationErrorText}"
                                   TextWrapping="Wrap"
                                   Margin="0,0,0,24"
                                   Visibility="Collapsed"/>
                    </StackPanel>
                </ScrollViewer>

                <StackPanel Grid.Row="1"
                            Orientation="Horizontal"
                            HorizontalAlignment="Right">
                    <Button Style="{StaticResource SecondaryButton}"
                            Content="Cancel"
                            Click="Cancel_Click"
                            IsCancel="True"
                            Margin="0,0,8,0"
                            Padding="16,8"/>
                    <Button x:Name="OkButton"
                            Style="{StaticResource PrimaryButton}"
                            Content="OK"
                            Click="Ok_Click"
                            Padding="16,8"
                            IsDefault="True"/>
                </StackPanel>
            </Grid>
        </Border>
    </DockPanel>
</Window>