<Window
	x:Class="PejPass.Wpf.Views.AboutWindow"
	xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
	xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
	Title="About PejPass"
	Width="480"
	Height="620"
	MinWidth="440"
	MinHeight="520"
	Background="{DynamicResource BgBrush}"
	ResizeMode="NoResize"
	ShowInTaskbar="False"
	WindowStartupLocation="CenterOwner">

	<Window.Resources>
		<Style TargetType="{x:Type Hyperlink}">
			<Setter Property="Foreground" Value="{DynamicResource AccentBrush}" />
			<Setter Property="TextDecorations" Value="Underline" />
			<Setter Property="Cursor" Value="Hand" />
			<Style.Triggers>
				<Trigger Property="IsMouseOver" Value="True">
					<Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
				</Trigger>
			</Style.Triggers>
		</Style>
	</Window.Resources>

	<Grid Margin="28,20,28,20">
		<Grid.RowDefinitions>
			<RowDefinition Height="Auto" />
			<RowDefinition Height="*" />
			<RowDefinition Height="Auto" />
		</Grid.RowDefinitions>

		<!--  Header  -->
		<StackPanel>
			<StackPanel HorizontalAlignment="Center">
				<Image
					Width="56"
					Height="56"
					Margin="0,0,0,10"
					Source="/Assets/PejPass.ico" />

				<TextBlock
					HorizontalAlignment="Center"
					FontSize="{DynamicResource AppFontSize22}"
					FontWeight="Bold"
					Foreground="{DynamicResource TextBrush}"
					Text="{Binding AppName}" />

				<!--  Installed build: Version + release date  -->
				<TextBlock
					Margin="0,4,0,0"
					HorizontalAlignment="Center"
					FontSize="{DynamicResource AppFontSize12}"
					Foreground="{DynamicResource MutedBrush}"
					Text="{Binding VersionDisplay}"
					TextAlignment="Center"
					TextWrapping="Wrap" />

				<TextBlock
					Margin="0,10,0,0"
					HorizontalAlignment="Center"
					FontSize="{DynamicResource AppFontSize11}"
					Foreground="{DynamicResource MutedBrush}"
					Text="{Binding StatusMessage}"
					TextAlignment="Center"
					TextWrapping="Wrap" />

				<ProgressBar
					Width="200"
					Height="3"
					Margin="0,8,0,0"
					IsIndeterminate="{Binding IsChecking}"
					Maximum="1"
					Visibility="{Binding IsBusy, Converter={StaticResource BoolToVis}}"
					Value="{Binding DownloadProgress}" />
			</StackPanel>

			<StackPanel Margin="0,14,0,4" HorizontalAlignment="Center">
				<StackPanel HorizontalAlignment="Center" Orientation="Horizontal">
					<Button
						Width="148"
						Margin="0,0,8,0"
						Command="{Binding CheckForUpdatesCommand}"
						Content="Check for Updates"
						Style="{StaticResource SecondaryButton}" />

					<Button
						Width="120"
						Command="{Binding ShowWhatsNewCommand}"
						Content="What's New"
						Style="{StaticResource SecondaryButton}" />
				</StackPanel>

				<StackPanel
					Margin="0,10,0,0"
					HorizontalAlignment="Center"
					Visibility="{Binding HasUpdate, Converter={StaticResource BoolToVis}}">

					<Button
						Width="180"
						HorizontalAlignment="Center"
						Command="{Binding DownloadUpdateCommand}"
						Content="Download &amp; Install"
						Style="{StaticResource PrimaryButton}"
						ToolTip="Download the update package and install it" />

					<TextBlock
						Margin="0,8,0,0"
						HorizontalAlignment="Center"
						FontSize="{DynamicResource AppFontSize11}"
						TextAlignment="Center"
						ToolTip="Open the download URL in your browser">
						<Hyperlink
							Command="{Binding OpenDownloadPageCommand}">
							Open download in browser
						</Hyperlink>
					</TextBlock>
				</StackPanel>
			</StackPanel>
		</StackPanel>

		<!--  Body  -->
		<ScrollViewer
			Grid.Row="1"
			Margin="0,12,0,12"
			HorizontalScrollBarVisibility="Disabled"
			VerticalScrollBarVisibility="Auto">

			<StackPanel>
				<TextBlock
					HorizontalAlignment="Center"
					FontSize="{DynamicResource AppFontSize13}"
					Foreground="{DynamicResource TextBrush}"
					Text="A simple, secure, privacy-focused password manager."
					TextAlignment="Center"
					TextWrapping="Wrap" />

				<TextBlock
					Margin="0,6,0,14"
					HorizontalAlignment="Center"
					FontSize="{DynamicResource AppFontSize11}"
					Foreground="{DynamicResource MutedBrush}"
					Text="Your vault stays encrypted, local, and under your control."
					TextAlignment="Center"
					TextWrapping="Wrap" />

				<Border
					Margin="0,0,0,8"
					Padding="12"
					Background="{DynamicResource SurfaceBrush}"
					CornerRadius="8">
					<StackPanel>
						<TextBlock
							FontWeight="SemiBold"
							Foreground="{DynamicResource TextBrush}"
							Text="Security" />
						<TextBlock
							Margin="0,4,0,0"
							FontSize="{DynamicResource AppFontSize11}"
							Foreground="{DynamicResource MutedBrush}"
							Text="Argon2id key derivation&#10;AES-256-GCM vault encryption" />
					</StackPanel>
				</Border>

				<Border
					Margin="0,0,0,8"
					Padding="12"
					Background="{DynamicResource SurfaceBrush}"
					CornerRadius="8">
					<StackPanel>
						<TextBlock
							FontWeight="SemiBold"
							Foreground="{DynamicResource TextBrush}"
							Text="Local First" />
						<TextBlock
							Margin="0,4,0,0"
							FontSize="{DynamicResource AppFontSize11}"
							Foreground="{DynamicResource MutedBrush}"
							Text="No account. No cloud dependency.&#10;Update checks and downloads only when you ask." />
					</StackPanel>
				</Border>

				<Border
					Padding="12"
					Background="{DynamicResource SurfaceBrush}"
					CornerRadius="8">
					<StackPanel>
						<TextBlock
							FontWeight="SemiBold"
							Foreground="{DynamicResource TextBrush}"
							Text="Built With" />
						<TextBlock
							Margin="0,4,0,0"
							FontSize="{DynamicResource AppFontSize11}"
							Foreground="{DynamicResource MutedBrush}"
							Text=".NET 10 • WPF • CommunityToolkit.Mvvm" />
					</StackPanel>
				</Border>
			</StackPanel>
		</ScrollViewer>

		<!--  Footer  -->
		<Grid Grid.Row="2">

			<Grid.ColumnDefinitions>
				<ColumnDefinition Width="*" />
				<ColumnDefinition Width="Auto" />
				<ColumnDefinition Width="*" />
			</Grid.ColumnDefinitions>

			<TextBlock
				Grid.Column="0"
				HorizontalAlignment="Left"
				VerticalAlignment="Center"
				FontSize="{DynamicResource AppFontSize11}">
				<Hyperlink
					Command="{Binding OpenGitHubCommand}">
					GitHub
				</Hyperlink>
			</TextBlock>

			<Button
				Grid.Column="1"
				Width="100"
				Click="CloseButton_Click"
				Content="Close"
				IsCancel="True"
				IsDefault="True"
				Style="{StaticResource SecondaryButton}" />
		</Grid>
	</Grid>
</Window>
