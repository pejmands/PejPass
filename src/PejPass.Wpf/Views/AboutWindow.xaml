<Window
	x:Class="PejPass.Wpf.Views.AboutWindow"
	xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
	xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
	Title="About PejPass"
	Width="460"
	Height="600"
	MinWidth="460"
	MinHeight="580"
	Background="{DynamicResource BgBrush}"
	ResizeMode="NoResize"
	ShowInTaskbar="False"
	WindowStartupLocation="CenterOwner">

	<Grid Margin="32,20">

		<Grid.RowDefinitions>
			<RowDefinition Height="Auto" />
			<RowDefinition Height="*" />
			<RowDefinition Height="Auto" />
		</Grid.RowDefinitions>


		<!--  Header  -->

		<StackPanel HorizontalAlignment="Center">

			<Image
				Width="64"
				Height="64"
				Margin="0,0,0,10"
				Source="/Assets/PejPass.ico" />

			<TextBlock
				HorizontalAlignment="Center"
				FontSize="{DynamicResource AppFontSize24}"
				FontWeight="Bold"
				Foreground="{DynamicResource TextBrush}"
				Text="PejPass" />

			<TextBlock
				x:Name="VersionText"
				Margin="0,4,0,0"
				HorizontalAlignment="Center"
				FontSize="{DynamicResource AppFontSize12}"
				Foreground="{DynamicResource MutedBrush}" />

			<TextBlock
				Margin="0,6,0,0"
				HorizontalAlignment="Center"
				FontSize="{DynamicResource AppFontSize11}"
				Foreground="{DynamicResource MutedBrush}"
				Text="{Binding UpdateStatus}" />

			<Button
				Width="150"
				Margin="0,8,0,0"
				HorizontalAlignment="Center"
				Command="{Binding CheckForUpdatesCommand}"
				Content="Check for Updates"
				Style="{StaticResource SecondaryButton}" />

		</StackPanel>


		<!--  Main content  -->

		<StackPanel Grid.Row="1" Margin="0,18,0,18">

			<TextBlock
				HorizontalAlignment="Center"
				FontSize="{DynamicResource AppFontSize13}"
				Foreground="{DynamicResource TextBrush}"
				Text="A simple, secure, privacy-focused password manager."
				TextAlignment="Center"
				TextWrapping="Wrap" />

			<TextBlock
				Margin="0,6,0,14"
				HorizontalAlignment="Center"
				FontSize="{DynamicResource AppFontSize11}"
				Foreground="{DynamicResource MutedBrush}"
				Text="Your vault stays encrypted, local, and under your control."
				TextAlignment="Center"
				TextWrapping="Wrap" />


			<!--  Security  -->

			<Border
				Margin="0,0,0,8"
				Padding="12"
				Background="{DynamicResource SurfaceBrush}"
				CornerRadius="8">

				<StackPanel>

					<TextBlock
						FontWeight="SemiBold"
						Foreground="{DynamicResource TextBrush}"
						Text="Security" />

					<TextBlock
						Margin="0,4,0,0"
						FontSize="{DynamicResource AppFontSize11}"
						Foreground="{DynamicResource MutedBrush}"
						Text="Argon2id key derivation&#10;AES-256-GCM vault encryption" />

				</StackPanel>

			</Border>


			<!--  Local First  -->

			<Border
				Margin="0,0,0,8"
				Padding="12"
				Background="{DynamicResource SurfaceBrush}"
				CornerRadius="8">

				<StackPanel>

					<TextBlock
						FontWeight="SemiBold"
						Foreground="{DynamicResource TextBrush}"
						Text="Local First" />

					<TextBlock
						Margin="0,4,0,0"
						FontSize="{DynamicResource AppFontSize11}"
						Foreground="{DynamicResource MutedBrush}"
						Text="No account. No cloud dependency.&#10;Your data remains on your device." />

				</StackPanel>

			</Border>


			<!--  Built With  -->

			<Border
				Padding="12"
				Background="{DynamicResource SurfaceBrush}"
				CornerRadius="8">

				<StackPanel>

					<TextBlock
						FontWeight="SemiBold"
						Foreground="{DynamicResource TextBrush}"
						Text="Built With" />

					<TextBlock
						Margin="0,4,0,0"
						FontSize="{DynamicResource AppFontSize11}"
						Foreground="{DynamicResource MutedBrush}"
						Text=".NET 10 • WPF • CommunityToolkit.Mvvm" />

				</StackPanel>

			</Border>

		</StackPanel>


		<!--  Footer  -->

		<Grid Grid.Row="2">

			<Grid.ColumnDefinitions>
				<ColumnDefinition Width="*" />
				<ColumnDefinition Width="Auto" />
				<ColumnDefinition Width="*" />
			</Grid.ColumnDefinitions>


			<TextBlock
				Grid.Column="0"
				HorizontalAlignment="Left"
				VerticalAlignment="Center"
				Cursor="Hand"
				FontSize="{DynamicResource AppFontSize11}"
				Foreground="{DynamicResource AccentBrush}"
				MouseLeftButtonUp="GitHub_Click"
				Text="GitHub" />


			<Button
				Grid.Column="1"
				Width="100"
				Click="CloseButton_Click"
				Content="Close"
				IsDefault="True"
				Style="{StaticResource SecondaryButton}" />

		</Grid>

	</Grid>

</Window>
