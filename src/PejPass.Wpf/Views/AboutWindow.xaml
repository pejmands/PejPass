<Window
	x:Class="PejPass.Wpf.Views.AboutWindow"
	xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
	xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
	Title="About PejPass"
	Width="460"
	Height="580"
	MinWidth="460"
	MinHeight="560"
	Background="{DynamicResource BgBrush}"
	ResizeMode="NoResize"
	ShowInTaskbar="False"
	WindowStartupLocation="CenterOwner">

	<Grid Margin="32">
		<Grid.RowDefinitions>
			<RowDefinition Height="Auto" />
			<RowDefinition Height="*" />
			<RowDefinition Height="Auto" />
		</Grid.RowDefinitions>

		<StackPanel HorizontalAlignment="Center">

			<Image
				Width="80"
				Height="80"
				Margin="0,0,0,14"
				Source="/Assets/PejPass.ico" />

			<TextBlock
				HorizontalAlignment="Center"
				FontSize="{DynamicResource AppFontSize24}"
				FontWeight="Bold"
				Foreground="{DynamicResource TextBrush}"
				Text="PejPass" />

			<TextBlock
				x:Name="VersionText"
				Margin="0,6,0,0"
				HorizontalAlignment="Center"
				FontSize="{DynamicResource AppFontSize12}"
				Foreground="{DynamicResource MutedBrush}" />
		</StackPanel>


		<StackPanel Grid.Row="1" Margin="0,32,0,24">

			<TextBlock
				HorizontalAlignment="Center"
				FontSize="{DynamicResource AppFontSize13}"
				Foreground="{DynamicResource TextBrush}"
				Text="A simple, secure, privacy-focused password manager."
				TextAlignment="Center"
				TextWrapping="Wrap" />

			<TextBlock
				Margin="0,10,0,24"
				HorizontalAlignment="Center"
				FontSize="{DynamicResource AppFontSize11}"
				Foreground="{DynamicResource MutedBrush}"
				Text="Your vault stays encrypted, local, and under your control."
				TextAlignment="Center"
				TextWrapping="Wrap" />


			<Border
				Margin="0,0,0,12"
				Padding="16"
				Background="{DynamicResource SurfaceBrush}"
				CornerRadius="8">

				<StackPanel>

					<TextBlock
						FontWeight="SemiBold"
						Foreground="{DynamicResource TextBrush}"
						Text="Security" />

					<TextBlock
						Margin="0,6,0,0"
						FontSize="{DynamicResource AppFontSize11}"
						Foreground="{DynamicResource MutedBrush}"
						Text="Argon2id key derivation&#10;AES-256-GCM vault encryption" />
				</StackPanel>

			</Border>


			<Border
				Margin="0,0,0,12"
				Padding="16"
				Background="{DynamicResource SurfaceBrush}"
				CornerRadius="8">

				<StackPanel>

					<TextBlock
						FontWeight="SemiBold"
						Foreground="{DynamicResource TextBrush}"
						Text="Local First" />

					<TextBlock
						Margin="0,6,0,0"
						FontSize="{DynamicResource AppFontSize11}"
						Foreground="{DynamicResource MutedBrush}"
						Text="No account. No cloud dependency.&#10;Your data remains on your device." />
				</StackPanel>

			</Border>


			<Border
				Padding="16"
				Background="{DynamicResource SurfaceBrush}"
				CornerRadius="8">

				<StackPanel>

					<TextBlock
						FontWeight="SemiBold"
						Foreground="{DynamicResource TextBrush}"
						Text="Built With" />

					<TextBlock
						Margin="0,6,0,0"
						FontSize="{DynamicResource AppFontSize11}"
						Foreground="{DynamicResource MutedBrush}"
						Text=".NET 10 • WPF • CommunityToolkit.Mvvm" />
				</StackPanel>

			</Border>


			<Button
				Margin="0,20,0,0"
				HorizontalAlignment="Center"
				Click="GitHub_Click"
				Content="GitHub"
				Style="{StaticResource SecondaryButton}" />

		</StackPanel>


		<Button
			Grid.Row="2"
			Width="100"
			HorizontalAlignment="Center"
			Click="CloseButton_Click"
			Content="Close"
			IsDefault="True"
			Style="{StaticResource SecondaryButton}" />

	</Grid>

</Window>
