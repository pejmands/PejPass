<Window
	x:Class="PejPass.Wpf.Views.AboutWindow"
	xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
	xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
	Title="About PejPass"
	Width="420"
	Height="400"
	MinWidth="380"
	MinHeight="360"
	Background="{DynamicResource BgBrush}"
	ResizeMode="NoResize"
	ShowInTaskbar="False"
	WindowStartupLocation="CenterOwner">
	<Grid Margin="28">
		<Grid.RowDefinitions>
			<RowDefinition Height="Auto" />
			<RowDefinition Height="*" />
			<RowDefinition Height="Auto" />
		</Grid.RowDefinitions>

		<StackPanel HorizontalAlignment="Center" VerticalAlignment="Top">
			<Image
				Width="72"
				Height="72"
				Margin="0,0,0,14"
				HorizontalAlignment="Center"
				Source="/Assets/PejPass.ico" />
			<TextBlock
				HorizontalAlignment="Center"
				FontSize="{DynamicResource AppFontSize24}"
				FontWeight="Bold"
				Foreground="{DynamicResource TextBrush}"
				Text="PejPass" />
			<TextBlock
				x:Name="VersionText"
				Margin="0,4,0,0"
				HorizontalAlignment="Center"
				FontSize="{DynamicResource AppFontSize12}"
				Foreground="{DynamicResource MutedBrush}" />
		</StackPanel>

		<StackPanel Grid.Row="1" VerticalAlignment="Center">
			<TextBlock
				Margin="20,0"
				FontSize="{DynamicResource AppFontSize13}"
				Foreground="{DynamicResource TextBrush}"
				Text="A simple, secure password manager."
				TextAlignment="Center"
				TextWrapping="Wrap" />
			<TextBlock
				Margin="20,8,20,0"
				FontSize="{DynamicResource AppFontSize11}"
				Foreground="{DynamicResource MutedBrush}"
				Text="Your vault stays encrypted and under your control."
				TextAlignment="Center"
				TextWrapping="Wrap" />
		</StackPanel>

		<StackPanel Grid.Row="2">
			<Button
				Width="100"
				HorizontalAlignment="Center"
				Click="CloseButton_Click"
				Content="Close"
				IsDefault="True"
				Style="{StaticResource SecondaryButton}" />
		</StackPanel>
	</Grid>
</Window>
