<Window x:Class="PejPass.Wpf.Views.VaultHealthWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Vault Health"
        Height="560"
        Width="720"
        MinHeight="420"
        MinWidth="560"
        WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False"
        Background="{DynamicResource BgBrush}">

    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <Grid Margin="0,0,0,12">
            <TextBlock Text="Vault Health"
                       FontSize="22"
                       FontWeight="Bold"
                       Foreground="{DynamicResource TextBrush}"/>

            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Content="Cancel"
                        Command="{Binding CancelScanCommand}"
                        Margin="0,0,8,0"
                        Background="{DynamicResource SurfaceAltBrush}"
                        Foreground="{DynamicResource TextBrush}"
                        ToolTip="Cancel the running health scan">
                    <Button.Style>
                        <Style TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
                            <Setter Property="Visibility" Value="Collapsed"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsScanning}" Value="True">
                                    <Setter Property="Visibility" Value="Visible"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Button.Style>
                </Button>
                <Button Content="Rescan"
                        Command="{Binding RefreshCommand}"
                        Background="{DynamicResource SurfaceAltBrush}"
                        Foreground="{DynamicResource TextBrush}"
                        ToolTip="Run health scan again">
                    <Button.Style>
                        <Style TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
                            <Setter Property="Visibility" Value="Visible"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsScanning}" Value="True">
                                    <Setter Property="Visibility" Value="Collapsed"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Button.Style>
                </Button>
            </StackPanel>
        </Grid>

        <!-- Summary -->
        <StackPanel Grid.Row="1"
                    Orientation="Horizontal"
                    Margin="0,0,0,12">

            <Border Background="{DynamicResource SurfaceBrush}"
                    CornerRadius="8"
                    Padding="12,10"
                    Margin="0,0,8,0">
                <StackPanel>
                    <TextBlock Text="Total"
                               FontSize="11"
                               Foreground="{DynamicResource MutedBrush}"/>
                    <TextBlock Text="{Binding TotalIssues}"
                               FontSize="20"
                               FontWeight="Bold"
                               Foreground="{DynamicResource TextBrush}"/>
                </StackPanel>
            </Border>

            <Border Background="{DynamicResource SurfaceBrush}"
                    CornerRadius="8"
                    Padding="12,10"
                    Margin="0,0,8,0">
                <StackPanel>
                    <TextBlock Text="Duplicates"
                               FontSize="11"
                               Foreground="{DynamicResource MutedBrush}"/>
                    <TextBlock Text="{Binding DuplicateCount}"
                               FontSize="20"
                               FontWeight="Bold"
                               Foreground="{DynamicResource DangerBrush}"/>
                </StackPanel>
            </Border>

            <Border Background="{DynamicResource SurfaceBrush}"
                    CornerRadius="8"
                    Padding="12,10"
                    Margin="0,0,8,0">
                <StackPanel>
                    <TextBlock Text="Weak"
                               FontSize="11"
                               Foreground="{DynamicResource MutedBrush}"/>
                    <TextBlock Text="{Binding WeakCount}"
                               FontSize="20"
                               FontWeight="Bold"
                               Foreground="{DynamicResource WarningBrush}"/>
                </StackPanel>
            </Border>

            <Border Background="{DynamicResource SurfaceBrush}"
                    CornerRadius="8"
                    Padding="12,10"
                    Margin="0,0,8,0">
                <StackPanel>
                    <TextBlock Text="No TOTP"
                               FontSize="11"
                               Foreground="{DynamicResource MutedBrush}"/>
                    <TextBlock Text="{Binding MissingTotpCount}"
                               FontSize="20"
                               FontWeight="Bold"
                               Foreground="{DynamicResource AccentBrush}"/>
                </StackPanel>
            </Border>

            <Border Background="{DynamicResource SurfaceBrush}"
                    CornerRadius="8"
                    Padding="12,10">
                <StackPanel>
                    <TextBlock Text="Stale"
                               FontSize="11"
                               Foreground="{DynamicResource MutedBrush}"/>
                    <TextBlock Text="{Binding StaleCount}"
                               FontSize="20"
                               FontWeight="Bold"
                               Foreground="{DynamicResource MutedBrush}"/>
                </StackPanel>
            </Border>
        </StackPanel>

        <!-- Scan status and filter -->
        <DockPanel Grid.Row="2"
                   Margin="0,0,0,12">

            <ComboBox DockPanel.Dock="Right"
                      Width="180"
                      Height="40"
                      ItemsSource="{Binding FilterOptions}"
                      SelectedIndex="{Binding SelectedFilterIndex}"
                      IsEnabled="{Binding IsReady}"/>

            <StackPanel Margin="0,0,12,0">
                <TextBlock Text="{Binding ScanStatus}"
                           FontSize="12"
                           Foreground="{DynamicResource MutedBrush}"
                           Margin="0,0,0,4"/>

                <ProgressBar Height="6"
                             Minimum="0"
                             Maximum="100"
                             Value="{Binding ScanProgress}"
                             Background="{DynamicResource SurfaceAltBrush}"/>
            </StackPanel>
        </DockPanel>

        <!-- Issues -->
        <DockPanel Grid.Row="3">
            <ListBox ItemsSource="{Binding Issues}"
                     Background="Transparent"
                     BorderThickness="0"
                     ScrollViewer.HorizontalScrollBarVisibility="Disabled">

                <ListBox.ItemContainerStyle>
                    <Style TargetType="ListBoxItem">
                        <Setter Property="HorizontalContentAlignment"
                                Value="Stretch"/>
                        <Setter Property="Padding"
                                Value="0"/>
                        <Setter Property="Margin"
                                Value="0,0,0,6"/>

                        <Setter Property="Template">
                            <Setter.Value>
                                <ControlTemplate TargetType="ListBoxItem">
                                    <Border Background="{DynamicResource SurfaceBrush}"
                                            CornerRadius="8"
                                            Padding="12,10">
                                        <ContentPresenter/>
                                    </Border>
                                </ControlTemplate>
                            </Setter.Value>
                        </Setter>
                    </Style>
                </ListBox.ItemContainerStyle>

                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="88"/>
                                <ColumnDefinition Width="*"
                                                  MinWidth="80"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <Border Background="{DynamicResource SurfaceAltBrush}"
                                    CornerRadius="4"
                                    Padding="8,3"
                                    HorizontalAlignment="Left"
                                    VerticalAlignment="Top"
                                    Margin="0,2,0,0">
                                <TextBlock Text="{Binding KindLabel}"
                                           FontSize="11"
                                           FontWeight="SemiBold"
                                           Foreground="{DynamicResource TextBrush}"/>
                            </Border>

                            <StackPanel Grid.Column="1"
                                        Margin="10,0,10,0"
                                        VerticalAlignment="Center">

                                <TextBlock Text="{Binding EntryTitle}"
                                           FontWeight="SemiBold"
                                           Foreground="{DynamicResource TextBrush}"
                                           TextTrimming="CharacterEllipsis"/>

                                <TextBlock Text="{Binding Detail}"
                                           FontSize="12"
                                           Margin="0,2,0,0"
                                           Foreground="{DynamicResource MutedBrush}"
                                           TextWrapping="Wrap"/>
                            </StackPanel>

                            <Button Grid.Column="2"
                                    Content="Open"
                                    Height="32"
                                    MinWidth="64"
                                    Padding="12,4"
                                    VerticalAlignment="Center"
                                    IsEnabled="{Binding DataContext.IsReady, RelativeSource={RelativeSource AncestorType=Window}}"
                                    Command="{Binding DataContext.OpenEntryCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                    CommandParameter="{Binding}"/>
                        </Grid>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>
        </DockPanel>

        <!-- Footer -->
        <Button Grid.Row="4"
                Content="Close"
                HorizontalAlignment="Right"
                Margin="0,16,0,0"
                Background="{DynamicResource SurfaceAltBrush}"
                Foreground="{DynamicResource TextBrush}"
                Click="Close_Click"/>

    </Grid>
</Window>
