<Window
	x:Class="PejPass.Wpf.Views.VaultHealthWindow"
	xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
	xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
	Title="Vault Health"
	Width="720"
	Height="720"
	MinWidth="560"
	MinHeight="560"
	Background="{DynamicResource BgBrush}"
	ResizeMode="CanResize"
	ShowInTaskbar="False"
	WindowStartupLocation="CenterOwner">

	<Grid Margin="24">
		<Grid.RowDefinitions>
			<RowDefinition Height="Auto" />
			<RowDefinition Height="Auto" />
			<RowDefinition Height="Auto" />
			<RowDefinition Height="*" />
		</Grid.RowDefinitions>

		<!--  Header  -->
		<Grid Margin="0,0,0,18">
			<TextBlock
				FontSize="{DynamicResource AppFontSize22}"
				FontWeight="Bold"
				Foreground="{DynamicResource TextBrush}"
				Text="Vault Health" />

			<StackPanel HorizontalAlignment="Right" Orientation="Horizontal">
				<Button
					Width="70"
					Command="{Binding CancelScanCommand}"
					Content="Cancel"
					ToolTip="Cancel the running health scan">
					<Button.Style>
						<Style BasedOn="{StaticResource SecondaryButton}" TargetType="Button">
							<Setter Property="Visibility" Value="Collapsed" />
							<Style.Triggers>
								<DataTrigger Binding="{Binding IsScanning}" Value="True">
									<Setter Property="Visibility" Value="Visible" />
								</DataTrigger>
							</Style.Triggers>
						</Style>
					</Button.Style>
				</Button>
				<Button
					Width="70"
					Command="{Binding RefreshCommand}"
					Content="Rescan"
					ToolTip="Run health scan again">
					<Button.Style>
						<Style BasedOn="{StaticResource SecondaryButton}" TargetType="Button">
							<Setter Property="Visibility" Value="Visible" />
							<Style.Triggers>
								<DataTrigger Binding="{Binding IsScanning}" Value="True">
									<Setter Property="Visibility" Value="Collapsed" />
								</DataTrigger>
							</Style.Triggers>
						</Style>
					</Button.Style>
				</Button>
			</StackPanel>
		</Grid>

		<!--  Health summary  -->
		<Border
			Grid.Row="1"
			Margin="0,0,0,16"
			Padding="20,16"
			Background="{DynamicResource SurfaceBrush}"
			CornerRadius="10">
			<Grid>
				<Grid.ColumnDefinitions>
					<ColumnDefinition Width="1*" />
					<ColumnDefinition Width="2*" />
				</Grid.ColumnDefinitions>

				<StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
					<StackPanel
						Margin="0,0,0,4"
						HorizontalAlignment="Center"
						VerticalAlignment="Center"
						Orientation="Horizontal">
						<TextBlock
							VerticalAlignment="Center"
							FontSize="{DynamicResource AppFontSize11}"
							Foreground="{DynamicResource MutedBrush}"
							Text="Vault health" />
						<Border
							Margin="8,0,0,0"
							Padding="7,3"
							VerticalAlignment="Center"
							CornerRadius="4">
							<Border.Style>
								<Style TargetType="Border">
									<Setter Property="Background" Value="{DynamicResource SurfaceAltBrush}" />
									<Style.Triggers>
										<DataTrigger Binding="{Binding HealthLabel}" Value="Excellent">
											<Setter Property="Background" Value="{DynamicResource SuccessBrush}" />
										</DataTrigger>
										<DataTrigger Binding="{Binding HealthLabel}" Value="Good">
											<Setter Property="Background" Value="{DynamicResource AccentBrush}" />
										</DataTrigger>
										<DataTrigger Binding="{Binding HealthLabel}" Value="Needs attention">
											<Setter Property="Background" Value="{DynamicResource WarningBrush}" />
										</DataTrigger>
										<DataTrigger Binding="{Binding HealthLabel}" Value="At risk">
											<Setter Property="Background" Value="{DynamicResource DangerBrush}" />
										</DataTrigger>
									</Style.Triggers>
								</Style>
							</Border.Style>
							<TextBlock
								FontSize="{DynamicResource AppFontSize10}"
								FontWeight="SemiBold"
								Foreground="{DynamicResource ButtonTextBrush}"
								Text="{Binding HealthLabel}" />
						</Border>
					</StackPanel>
					<TextBlock
						HorizontalAlignment="Center"
						FontSize="{DynamicResource AppFontSize30}"
						FontWeight="Bold"
						Foreground="{DynamicResource TextBrush}"
						Text="{Binding HealthScore, StringFormat={}{0}%}" />
				</StackPanel>

				<StackPanel
					Grid.Column="1"
					Margin="18,0,0,0"
					VerticalAlignment="Center">
					<TextBlock
						FontSize="{DynamicResource AppFontSize14}"
						FontWeight="SemiBold"
						Foreground="{DynamicResource TextBrush}"
						Text="{Binding TotalIssues, StringFormat={}{0} issues found}" />
					<TextBlock
						Margin="0,4,0,0"
						FontSize="{DynamicResource AppFontSize11}"
						Foreground="{DynamicResource MutedBrush}"
						Text="Review the issues below to improve your vault security."
						TextWrapping="Wrap" />
				</StackPanel>
			</Grid>
		</Border>

		<!--  Issue summary  -->
		<Grid Grid.Row="2" Margin="0,0,0,16">
			<Grid.ColumnDefinitions>
				<ColumnDefinition Width="*" />
				<ColumnDefinition Width="*" />
				<ColumnDefinition Width="*" />
				<ColumnDefinition Width="*" />
				<ColumnDefinition Width="*" />
			</Grid.ColumnDefinitions>

			<StackPanel Grid.Column="0">
				<TextBlock
					FontSize="{DynamicResource AppFontSize20}"
					FontWeight="Bold"
					Foreground="{DynamicResource WarningBrush}"
					Text="{Binding WeakCount}" />
				<TextBlock
					Margin="0,2,0,0"
					FontSize="{DynamicResource AppFontSize11}"
					Foreground="{DynamicResource MutedBrush}"
					Text="Weak passwords" />
			</StackPanel>

			<StackPanel Grid.Column="1">
				<TextBlock
					FontSize="{DynamicResource AppFontSize20}"
					FontWeight="Bold"
					Foreground="{DynamicResource DangerBrush}"
					Text="{Binding DuplicateCount}" />
				<TextBlock
					Margin="0,2,0,0"
					FontSize="{DynamicResource AppFontSize11}"
					Foreground="{DynamicResource MutedBrush}"
					Text="Duplicate passwords" />
			</StackPanel>

			<StackPanel Grid.Column="2">
				<TextBlock
					FontSize="{DynamicResource AppFontSize20}"
					FontWeight="Bold"
					Foreground="{DynamicResource AccentBrush}"
					Text="{Binding MissingTotpCount}" />
				<TextBlock
					Margin="0,2,0,0"
					FontSize="{DynamicResource AppFontSize11}"
					Foreground="{DynamicResource MutedBrush}"
					Text="Missing TOTP" />
			</StackPanel>

			<StackPanel Grid.Column="3">
				<TextBlock
					FontSize="{DynamicResource AppFontSize20}"
					FontWeight="Bold"
					Foreground="{DynamicResource MutedBrush}"
					Text="{Binding StaleCount}" />
				<TextBlock
					Margin="0,2,0,0"
					FontSize="{DynamicResource AppFontSize11}"
					Foreground="{DynamicResource MutedBrush}"
					Text="Old passwords" />
			</StackPanel>

			<StackPanel Grid.Column="4">
				<TextBlock
					FontSize="{DynamicResource AppFontSize20}"
					FontWeight="Bold"
					Foreground="{DynamicResource WarningBrush}"
					Text="{Binding UsernameEqualsPasswordCount}" />
				<TextBlock
					Margin="0,2,0,0"
					FontSize="{DynamicResource AppFontSize11}"
					Foreground="{DynamicResource MutedBrush}"
					Text="Username = password" />
			</StackPanel>
		</Grid>

		<!--  Issues  -->
		<Grid Grid.Row="3">
			<Grid.RowDefinitions>
				<RowDefinition Height="Auto" />
				<RowDefinition Height="*" />
			</Grid.RowDefinitions>

			<!--  Scan status and filter  -->
			<DockPanel Grid.Row="0" Margin="0,0,0,12">
				<ComboBox
					Width="200"
					Height="40"
					DockPanel.Dock="Right"
					IsEnabled="{Binding IsReady}"
					ItemsSource="{Binding FilterOptions}"
					SelectedIndex="{Binding SelectedFilterIndex}" />

				<StackPanel Margin="0,0,12,0">
					<TextBlock
						Margin="0,0,0,4"
						FontSize="{DynamicResource AppFontSize12}"
						Foreground="{DynamicResource MutedBrush}"
						Text="{Binding ScanStatus}" />

					<ProgressBar
						Height="6"
						Background="{DynamicResource SurfaceAltBrush}"
						Maximum="100"
						Minimum="0"
						Value="{Binding ScanProgress}" />
				</StackPanel>
			</DockPanel>

			<Grid Grid.Row="1">
				<ListBox
					Background="Transparent"
					BorderThickness="0"
					ItemsSource="{Binding Issues}"
					ScrollViewer.HorizontalScrollBarVisibility="Disabled">

					<ListBox.ItemContainerStyle>
						<Style TargetType="ListBoxItem">
							<Setter Property="HorizontalContentAlignment" Value="Stretch" />
							<Setter Property="Padding" Value="0" />
							<Setter Property="Margin" Value="0,0,0,6" />
							<Setter Property="Template">
								<Setter.Value>
									<ControlTemplate TargetType="ListBoxItem">
										<Border
											x:Name="ItemBorder"
											Padding="12,10"
											Background="{DynamicResource SurfaceBrush}"
											BorderBrush="Transparent"
											BorderThickness="1"
											CornerRadius="8">
											<ContentPresenter />
										</Border>
										<ControlTemplate.Triggers>
											<Trigger Property="IsKeyboardFocusWithin" Value="True">
												<Setter TargetName="ItemBorder" Property="BorderBrush" Value="{DynamicResource AccentBrush}" />
											</Trigger>
										</ControlTemplate.Triggers>
									</ControlTemplate>
								</Setter.Value>
							</Setter>
						</Style>
					</ListBox.ItemContainerStyle>

					<ListBox.ItemTemplate>
						<DataTemplate>
							<Grid>
								<Grid.ColumnDefinitions>
									<ColumnDefinition Width="88" />
									<ColumnDefinition Width="*" MinWidth="80" />
									<ColumnDefinition Width="Auto" />
								</Grid.ColumnDefinitions>

								<Border
									Margin="0,2,0,0"
									Padding="8,3"
									HorizontalAlignment="Left"
									VerticalAlignment="Top"
									Background="{DynamicResource SurfaceAltBrush}"
									CornerRadius="4">
									<TextBlock
										FontSize="{DynamicResource AppFontSize11}"
										FontWeight="SemiBold"
										Foreground="{DynamicResource TextBrush}"
										Text="{Binding KindLabel}" />
								</Border>

								<StackPanel
									Grid.Column="1"
									Margin="10,0,10,0"
									VerticalAlignment="Center">
									<TextBlock
										FontWeight="SemiBold"
										Foreground="{DynamicResource TextBrush}"
										Text="{Binding EntryTitle}"
										TextTrimming="CharacterEllipsis" />
									<TextBlock
										MaxHeight="48"
										Margin="0,2,0,0"
										FontSize="{DynamicResource AppFontSize12}"
										Foreground="{DynamicResource MutedBrush}"
										Text="{Binding Detail}"
										TextTrimming="CharacterEllipsis"
										TextWrapping="Wrap" />
								</StackPanel>

								<Button
									Grid.Column="2"
									Height="32"
									MinWidth="64"
									Padding="12,4"
									VerticalAlignment="Center"
									Command="{Binding DataContext.OpenEntryCommand, RelativeSource={RelativeSource AncestorType=Window}}"
									CommandParameter="{Binding}"
									Content="Open"
									IsEnabled="{Binding DataContext.IsReady, RelativeSource={RelativeSource AncestorType=Window}}"
									Style="{StaticResource SecondaryButton}" />
							</Grid>
						</DataTemplate>
					</ListBox.ItemTemplate>
				</ListBox>

				<StackPanel
					HorizontalAlignment="Center"
					VerticalAlignment="Center"
					Visibility="{Binding IsEmptyVault, Converter={StaticResource BoolToVis}}">
					<TextBlock
						HorizontalAlignment="Center"
						FontSize="{DynamicResource AppFontSize16}"
						FontWeight="SemiBold"
						Foreground="{DynamicResource TextBrush}"
						Text="No entries to scan" />
					<TextBlock
						Margin="0,8,0,0"
						HorizontalAlignment="Center"
						FontSize="{DynamicResource AppFontSize13}"
						Foreground="{DynamicResource MutedBrush}"
						Text="Add entries to run a vault health check." />
				</StackPanel>

				<StackPanel
					HorizontalAlignment="Center"
					VerticalAlignment="Center"
					Visibility="{Binding HasNoIssues, Converter={StaticResource BoolToVis}}">
					<TextBlock
						HorizontalAlignment="Center"
						FontSize="{DynamicResource AppFontSize16}"
						FontWeight="SemiBold"
						Foreground="{DynamicResource TextBrush}"
						Text="No issues found" />
					<TextBlock
						Margin="0,8,0,0"
						HorizontalAlignment="Center"
						FontSize="{DynamicResource AppFontSize13}"
						Foreground="{DynamicResource MutedBrush}"
						Text="Your current entries passed all health checks." />
				</StackPanel>

				<StackPanel
					HorizontalAlignment="Center"
					VerticalAlignment="Center"
					Visibility="{Binding HasNoMatchingIssues, Converter={StaticResource BoolToVis}}">
					<TextBlock
						HorizontalAlignment="Center"
						FontSize="{DynamicResource AppFontSize16}"
						FontWeight="SemiBold"
						Foreground="{DynamicResource TextBrush}"
						Text="No matching issues" />
					<TextBlock
						Margin="0,8,0,0"
						HorizontalAlignment="Center"
						FontSize="{DynamicResource AppFontSize13}"
						Foreground="{DynamicResource MutedBrush}"
						Text="Try a different issue filter." />
				</StackPanel>
			</Grid>
		</Grid>

	</Grid>
</Window>
