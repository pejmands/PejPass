<Window x:Class="PejPass.Wpf.Views.VaultHealthWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Vault Health"
        Height="560" Width="720"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource BgBrush}">

    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <!-- Fixed-height status strip: never collapses → no layout jump -->
            <RowDefinition Height="48"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Text="Vault Health" FontSize="22" FontWeight="Bold"
                   Foreground="{DynamicResource TextBrush}" Margin="0,0,0,8"/>

        <!-- Always visible strip (status + bar). Opacity dims when idle. -->
        <StackPanel Grid.Row="1" VerticalAlignment="Center">
            <TextBlock Text="{Binding ScanStatus}" FontSize="13"
                       Foreground="{DynamicResource MutedBrush}" Margin="0,0,0,6"/>
            <ProgressBar Height="8" Minimum="0" Maximum="100"
                         Value="{Binding ScanProgress}"
                         Background="{DynamicResource SurfaceAltBrush}"
                         Foreground="{DynamicResource AccentBrush}"/>
        </StackPanel>

        <UniformGrid Grid.Row="2" Columns="4" Margin="0,12,0,16">
            <Border Background="{DynamicResource SurfaceBrush}" CornerRadius="8" Padding="12" Margin="0,0,8,0">
                <StackPanel>
                    <TextBlock Text="{Binding DuplicateCount}" FontSize="22" FontWeight="Bold" Foreground="{DynamicResource DangerBrush}"/>
                    <TextBlock Text="Duplicates" FontSize="12" Foreground="{DynamicResource MutedBrush}"/>
                </StackPanel>
            </Border>
            <Border Background="{DynamicResource SurfaceBrush}" CornerRadius="8" Padding="12" Margin="0,0,8,0">
                <StackPanel>
                    <TextBlock Text="{Binding WeakCount}" FontSize="22" FontWeight="Bold" Foreground="{DynamicResource WarningBrush}"/>
                    <TextBlock Text="Weak" FontSize="12" Foreground="{DynamicResource MutedBrush}"/>
                </StackPanel>
            </Border>
            <Border Background="{DynamicResource SurfaceBrush}" CornerRadius="8" Padding="12" Margin="0,0,8,0">
                <StackPanel>
                    <TextBlock Text="{Binding MissingTotpCount}" FontSize="22" FontWeight="Bold" Foreground="{DynamicResource AccentBrush}"/>
                    <TextBlock Text="No TOTP" FontSize="12" Foreground="{DynamicResource MutedBrush}"/>
                </StackPanel>
            </Border>
            <Border Background="{DynamicResource SurfaceBrush}" CornerRadius="8" Padding="12">
                <StackPanel>
                    <TextBlock Text="{Binding StaleCount}" FontSize="22" FontWeight="Bold" Foreground="{DynamicResource MutedBrush}"/>
                    <TextBlock Text="Stale (1y+)" FontSize="12" Foreground="{DynamicResource MutedBrush}"/>
                </StackPanel>
            </Border>
        </UniformGrid>

        <DockPanel Grid.Row="3">
            <Grid DockPanel.Dock="Top" Margin="0,0,0,10">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <ComboBox ItemsSource="{Binding FilterOptions}" SelectedIndex="{Binding SelectedFilterIndex}"
                          Width="200" HorizontalAlignment="Left" Padding="8,6"
                          IsEnabled="{Binding IsReady}"/>
                <TextBlock Grid.Column="1" Text="{Binding Issues.Count, StringFormat={}{0} issues}"
                           Foreground="{DynamicResource MutedBrush}" VerticalAlignment="Center" Margin="0,0,12,0"/>
                <Button Grid.Column="2" Content="Rescan" Command="{Binding RefreshCommand}"
                        Padding="12,6"
                        Background="{DynamicResource SurfaceAltBrush}" Foreground="{DynamicResource TextBrush}"
                        IsEnabled="{Binding IsReady}"/>
            </Grid>

            <ListBox ItemsSource="{Binding Issues}" Background="Transparent" BorderThickness="0"
                     IsEnabled="{Binding IsReady}">
                <ListBox.ItemContainerStyle>
                    <Style TargetType="ListBoxItem">
                        <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                        <Setter Property="Padding" Value="0"/>
                        <Setter Property="Margin" Value="0,0,0,6"/>
                        <Setter Property="Template">
                            <Setter.Value>
                                <ControlTemplate TargetType="ListBoxItem">
                                    <Border Background="{DynamicResource SurfaceBrush}" CornerRadius="8" Padding="14,12">
                                        <ContentPresenter/>
                                    </Border>
                                </ControlTemplate>
                            </Setter.Value>
                        </Setter>
                    </Style>
                </ListBox.ItemContainerStyle>
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="100"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <Border Background="{DynamicResource SurfaceAltBrush}" CornerRadius="4" Padding="8,3"
                                    HorizontalAlignment="Left" VerticalAlignment="Center">
                                <TextBlock Text="{Binding KindLabel}" FontSize="11" FontWeight="SemiBold"
                                           Foreground="{DynamicResource TextBrush}"/>
                            </Border>
                            <StackPanel Grid.Column="1" Margin="12,0,12,0">
                                <TextBlock Text="{Binding EntryTitle}" FontWeight="SemiBold"
                                           Foreground="{DynamicResource TextBrush}"/>
                                <TextBlock Text="{Binding Detail}" FontSize="12" Margin="0,2,0,0"
                                           Foreground="{DynamicResource MutedBrush}" TextTrimming="CharacterEllipsis"/>
                            </StackPanel>
                            <Button Grid.Column="2" Content="Open" Padding="12,6"
                                    Command="{Binding DataContext.OpenEntryCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                    CommandParameter="{Binding}"/>
                        </Grid>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>
        </DockPanel>

        <Button Grid.Row="4" Content="Close" HorizontalAlignment="Right" Margin="0,16,0,0"
                Click="Close_Click" Padding="20,8"
                Background="{DynamicResource SurfaceAltBrush}" Foreground="{DynamicResource TextBrush}"/>
    </Grid>
</Window>
