<Window x:Class="PejPass.Wpf.Views.VaultHealthWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Vault Health"
        Height="720"
        Width="720"
        MinHeight="560"
        MinWidth="560"
        WindowStartupLocation="CenterOwner"
        ResizeMode="CanResize"
        ShowInTaskbar="False"
        Background="{DynamicResource BgBrush}">

    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <Grid Margin="0,0,0,18">
            <TextBlock Text="Vault Health"
                       FontSize="22"
                       FontWeight="Bold"
                       Foreground="{DynamicResource TextBrush}"/>

            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Content="Cancel"
                        Command="{Binding CancelScanCommand}"
                        Width="70"
                        ToolTip="Cancel the running health scan">
                    <Button.Style>
                        <Style TargetType="Button"
                               BasedOn="{StaticResource SecondaryButton}">
                            <Setter Property="Visibility" Value="Collapsed"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsScanning}" Value="True">
                                    <Setter Property="Visibility" Value="Visible"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Button.Style>
                </Button>
                <Button Content="Rescan"
                        Width="70"
                        Command="{Binding RefreshCommand}"
                        ToolTip="Run health scan again">
                    <Button.Style>
                        <Style TargetType="Button"
                               BasedOn="{StaticResource SecondaryButton}">
                            <Setter Property="Visibility" Value="Visible"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsScanning}" Value="True">
                                    <Setter Property="Visibility" Value="Collapsed"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Button.Style>
                </Button>
            </StackPanel>
        </Grid>

        <!-- Health summary -->
        <Border Grid.Row="1"
                Background="{DynamicResource SurfaceBrush}"
                CornerRadius="10"
                Padding="20,16"
                Margin="0,0,0,16">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="190"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <StackPanel HorizontalAlignment="Center"
                            VerticalAlignment="Center">
                    <StackPanel Orientation="Horizontal"
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center"
                                Margin="0,0,0,4">
                        <TextBlock Text="Vault health"
                                   FontSize="11"
                                   Foreground="{DynamicResource MutedBrush}"
                                   VerticalAlignment="Center"/>
                        <Border CornerRadius="4"
                                Padding="7,3"
                                Margin="8,0,0,0"
                                VerticalAlignment="Center">
                            <Border.Style>
                                <Style TargetType="Border">
                                    <Setter Property="Background"
                                            Value="{DynamicResource SurfaceAltBrush}"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding HealthLabel}"
                                                     Value="Excellent">
                                            <Setter Property="Background"
                                                    Value="{DynamicResource SuccessBrush}"/>
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding HealthLabel}"
                                                     Value="Good">
                                            <Setter Property="Background"
                                                    Value="{DynamicResource AccentBrush}"/>
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding HealthLabel}"
                                                     Value="Needs attention">
                                            <Setter Property="Background"
                                                    Value="{DynamicResource WarningBrush}"/>
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding HealthLabel}"
                                                     Value="At risk">
                                            <Setter Property="Background"
                                                    Value="{DynamicResource DangerBrush}"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Border.Style>
                            <TextBlock Text="{Binding HealthLabel}"
                                       FontSize="10"
                                       FontWeight="SemiBold"
                                       Foreground="{DynamicResource ButtonTextBrush}"/>
                        </Border>
                    </StackPanel>
                    <TextBlock Text="{Binding HealthScore, StringFormat={}{0}%}"
                               FontSize="30"
                               FontWeight="Bold"
                               Foreground="{DynamicResource TextBrush}"
                               HorizontalAlignment="Center"/>
                </StackPanel>

                <StackPanel Grid.Column="1"
                            VerticalAlignment="Center"
                            Margin="18,0,0,0">
                    <TextBlock Text="{Binding TotalIssues, StringFormat={}{0} issues found}"
                               FontSize="14"
                               FontWeight="SemiBold"
                               Foreground="{DynamicResource TextBrush}"/>
                    <TextBlock Text="Review the issues below to improve your vault security."
                               FontSize="11"
                               Foreground="{DynamicResource MutedBrush}"
                               TextWrapping="Wrap"
                               Margin="0,4,0,0"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- Issue summary -->
        <Grid Grid.Row="2"
              Margin="0,0,0,16">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <StackPanel Grid.Column="0">
                <TextBlock Text="{Binding WeakCount}"
                           FontSize="20"
                           FontWeight="Bold"
                           Foreground="{DynamicResource WarningBrush}"/>
                <TextBlock Text="Weak passwords"
                           FontSize="11"
                           Foreground="{DynamicResource MutedBrush}"
                           Margin="0,2,0,0"/>
            </StackPanel>

            <StackPanel Grid.Column="1">
                <TextBlock Text="{Binding DuplicateCount}"
                           FontSize="20"
                           FontWeight="Bold"
                           Foreground="{DynamicResource DangerBrush}"/>
                <TextBlock Text="Duplicate passwords"
                           FontSize="11"
                           Foreground="{DynamicResource MutedBrush}"
                           Margin="0,2,0,0"/>
            </StackPanel>

            <StackPanel Grid.Column="2">
                <TextBlock Text="{Binding MissingTotpCount}"
                           FontSize="20"
                           FontWeight="Bold"
                           Foreground="{DynamicResource AccentBrush}"/>
                <TextBlock Text="Missing TOTP"
                           FontSize="11"
                           Foreground="{DynamicResource MutedBrush}"
                           Margin="0,2,0,0"/>
            </StackPanel>

            <StackPanel Grid.Column="3">
                <TextBlock Text="{Binding StaleCount}"
                           FontSize="20"
                           FontWeight="Bold"
                           Foreground="{DynamicResource MutedBrush}"/>
                <TextBlock Text="Old passwords"
                           FontSize="11"
                           Foreground="{DynamicResource MutedBrush}"
                           Margin="0,2,0,0"/>
            </StackPanel>

            <StackPanel Grid.Column="4">
                <TextBlock Text="{Binding UsernameEqualsPasswordCount}"
                           FontSize="20"
                           FontWeight="Bold"
                           Foreground="{DynamicResource WarningBrush}"/>
                <TextBlock Text="Username = password"
                           FontSize="11"
                           Foreground="{DynamicResource MutedBrush}"
                           Margin="0,2,0,0"/>
            </StackPanel>
        </Grid>

        <!-- Issues -->
        <Grid Grid.Row="3">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- Scan status and filter -->
            <DockPanel Grid.Row="0"
                       Margin="0,0,0,12">
                <ComboBox DockPanel.Dock="Right"
                          Width="200"
                          Height="40"
                          ItemsSource="{Binding FilterOptions}"
                          SelectedIndex="{Binding SelectedFilterIndex}"
                          IsEnabled="{Binding IsReady}"/>

                <StackPanel Margin="0,0,12,0">
                    <TextBlock Text="{Binding ScanStatus}"
                               FontSize="12"
                               Foreground="{DynamicResource MutedBrush}"
                               Margin="0,0,0,4"/>

                    <ProgressBar Height="6"
                                 Minimum="0"
                                 Maximum="100"
                                 Value="{Binding ScanProgress}"
                                 Background="{DynamicResource SurfaceAltBrush}"/>
                </StackPanel>
            </DockPanel>

            <Grid Grid.Row="1">
                <ListBox ItemsSource="{Binding Issues}"
                     Background="Transparent"
                     BorderThickness="0"
                     ScrollViewer.HorizontalScrollBarVisibility="Disabled">

                <ListBox.ItemContainerStyle>
                    <Style TargetType="ListBoxItem">
                        <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                        <Setter Property="Padding" Value="0"/>
                        <Setter Property="Margin" Value="0,0,0,6"/>
                        <Setter Property="Template">
                            <Setter.Value>
                                <ControlTemplate TargetType="ListBoxItem">
                                    <Border x:Name="ItemBorder"
                                            Background="{DynamicResource SurfaceBrush}"
                                            BorderBrush="Transparent"
                                            BorderThickness="1"
                                            CornerRadius="8"
                                            Padding="12,10">
                                        <ContentPresenter/>
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsKeyboardFocusWithin" Value="True">
                                            <Setter TargetName="ItemBorder"
                                                    Property="BorderBrush"
                                                    Value="{DynamicResource AccentBrush}"/>
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Setter.Value>
                        </Setter>
                    </Style>
                </ListBox.ItemContainerStyle>

                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="88"/>
                                <ColumnDefinition Width="*"
                                                  MinWidth="80"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <Border Background="{DynamicResource SurfaceAltBrush}"
                                    CornerRadius="4"
                                    Padding="8,3"
                                    HorizontalAlignment="Left"
                                    VerticalAlignment="Top"
                                    Margin="0,2,0,0">
                                <TextBlock Text="{Binding KindLabel}"
                                           FontSize="11"
                                           FontWeight="SemiBold"
                                           Foreground="{DynamicResource TextBrush}"/>
                            </Border>

                            <StackPanel Grid.Column="1"
                                        Margin="10,0,10,0"
                                        VerticalAlignment="Center">
                                <TextBlock Text="{Binding EntryTitle}"
                                           FontWeight="SemiBold"
                                           Foreground="{DynamicResource TextBrush}"
                                           TextTrimming="CharacterEllipsis"/>
                                <TextBlock Text="{Binding Detail}"
                                           FontSize="12"
                                           Margin="0,2,0,0"
                                           Foreground="{DynamicResource MutedBrush}"
                                           TextWrapping="Wrap"/>
                            </StackPanel>

                            <Button Grid.Column="2"
                                    Style="{StaticResource SecondaryButton}"
                                    Content="Open"
                                    Height="32"
                                    MinWidth="64"
                                    Padding="12,4"
                                    VerticalAlignment="Center"
                                    IsEnabled="{Binding DataContext.IsReady, RelativeSource={RelativeSource AncestorType=Window}}"
                                    Command="{Binding DataContext.OpenEntryCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                    CommandParameter="{Binding}"/>
                        </Grid>
                    </DataTemplate>
                </ListBox.ItemTemplate>
                </ListBox>

                <StackPanel HorizontalAlignment="Center"
                            VerticalAlignment="Center"
                            Visibility="{Binding IsEmptyVault, Converter={StaticResource BoolToVis}}">
                    <TextBlock Text="No entries to scan"
                               FontSize="16"
                               FontWeight="SemiBold"
                               Foreground="{DynamicResource TextBrush}"
                               HorizontalAlignment="Center"/>
                    <TextBlock Text="Add entries to run a vault health check."
                               FontSize="13"
                               Margin="0,8,0,0"
                               Foreground="{DynamicResource MutedBrush}"
                               HorizontalAlignment="Center"/>
                </StackPanel>

                <StackPanel HorizontalAlignment="Center"
                            VerticalAlignment="Center"
                            Visibility="{Binding HasNoIssues, Converter={StaticResource BoolToVis}}">
                    <TextBlock Text="No issues found"
                               FontSize="16"
                               FontWeight="SemiBold"
                               Foreground="{DynamicResource TextBrush}"
                               HorizontalAlignment="Center"/>
                    <TextBlock Text="Your current entries passed all health checks."
                               FontSize="13"
                               Margin="0,8,0,0"
                               Foreground="{DynamicResource MutedBrush}"
                               HorizontalAlignment="Center"/>
                </StackPanel>

                <StackPanel HorizontalAlignment="Center"
                            VerticalAlignment="Center"
                            Visibility="{Binding HasNoMatchingIssues, Converter={StaticResource BoolToVis}}">
                    <TextBlock Text="No matching issues"
                               FontSize="16"
                               FontWeight="SemiBold"
                               Foreground="{DynamicResource TextBrush}"
                               HorizontalAlignment="Center"/>
                    <TextBlock Text="Try a different issue filter."
                               FontSize="13"
                               Margin="0,8,0,0"
                               Foreground="{DynamicResource MutedBrush}"
                               HorizontalAlignment="Center"/>
                </StackPanel>
            </Grid>
        </Grid>

        <!-- Footer -->
        <Button Grid.Row="4"
                Style="{StaticResource SecondaryButton}"
                Content="Close"
                HorizontalAlignment="Right"
                Margin="0,16,0,0"
                Background="{DynamicResource SurfaceAltBrush}"
                Foreground="{DynamicResource TextBrush}"
                Click="Close_Click"/>
    </Grid>
</Window>
