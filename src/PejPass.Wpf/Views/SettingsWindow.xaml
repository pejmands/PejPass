<Window x:Class="PejPass.Wpf.Views.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Settings"
        Height="500" Width="460"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        Background="{DynamicResource BgBrush}">

    <Grid Margin="28">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Text="Settings" FontSize="22" FontWeight="Bold"
                   Foreground="{DynamicResource TextBrush}" Margin="0,0,0,24"/>

        <StackPanel Grid.Row="1">

            <!-- Theme -->
            <TextBlock Text="THEME" FontSize="11" FontWeight="SemiBold"
                       Foreground="{DynamicResource MutedBrush}" Margin="0,0,0,8"/>
            <ComboBox ItemsSource="{Binding ThemeOptions}"
                      SelectedIndex="{Binding SelectedThemeIndex}"
                      Margin="0,0,0,24" Padding="10,8"
                      Background="{DynamicResource SurfaceBrush}"
                      Foreground="{DynamicResource TextBrush}"
                      BorderBrush="{DynamicResource BorderBrush}"/>

            <!-- Auto-lock -->
            <TextBlock Text="AUTO-LOCK (MINUTES)" FontSize="11" FontWeight="SemiBold"
                       Foreground="{DynamicResource MutedBrush}" Margin="0,0,0,8"/>
            <TextBox Text="{Binding AutoLockMinutes, UpdateSourceTrigger=PropertyChanged}"
                     Margin="0,0,0,4"/>
            <TextBlock Text="0 = disabled. Vault locks after this many minutes of inactivity."
                       FontSize="11" Foreground="{DynamicResource MutedBrush}" Margin="0,0,0,24"/>

            <!-- Clipboard -->
            <TextBlock Text="CLIPBOARD CLEAR (SECONDS)" FontSize="11" FontWeight="SemiBold"
                       Foreground="{DynamicResource MutedBrush}" Margin="0,0,0,8"/>
            <TextBox Text="{Binding ClipboardClearSeconds, UpdateSourceTrigger=PropertyChanged}"
                     Margin="0,0,0,4"/>
            <TextBlock Text="Copied secrets are cleared from the clipboard after this time (5–300)."
                       FontSize="11" Foreground="{DynamicResource MutedBrush}"/>
        </StackPanel>

        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,24,0,0">
            <Button Content="Cancel" Command="{Binding CancelCommand}" Margin="0,0,8,0"
                    Background="{DynamicResource SurfaceAltBrush}"
                    Foreground="{DynamicResource TextBrush}"/>
            <Button Content="Save" Command="{Binding SaveCommand}" IsDefault="True"/>
        </StackPanel>
    </Grid>
</Window>
