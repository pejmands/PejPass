<Window x:Class="PejPass.Wpf.Views.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="clr-namespace:PejPass.Wpf.Controls"
        Title="Settings"
        Height="680"
        Width="520"
        MinWidth="460"
        MinHeight="560"
        WindowStartupLocation="CenterOwner"
        ResizeMode="CanResize"
        ShowInTaskbar="False"
        Background="{DynamicResource BgBrush}">

    <ScrollViewer VerticalScrollBarVisibility="Auto"
                  HorizontalScrollBarVisibility="Disabled">
        <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Text="Settings"
                   FontSize="{DynamicResource AppFontSize22}"
                   FontWeight="Bold"
                   Foreground="{DynamicResource TextBrush}"
                   Margin="0,0,0,20"/>

        <ScrollViewer Grid.Row="1"
                      VerticalScrollBarVisibility="Disabled">
            <StackPanel Margin="0,0,12,0">

                <!-- Appearance -->
                <Border BorderBrush="{DynamicResource BorderBrush}"
                        BorderThickness="0,0,0,1"
                        Margin="0,0,0,12"
                        Padding="0,0,0,8">
                    <TextBlock Text="Appearance"
                               FontSize="{DynamicResource AppFontSize13}"
                               FontWeight="SemiBold"
                               Foreground="{DynamicResource TextBrush}"/>
                </Border>

                <Grid Margin="0,0,0,20">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="180"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="Theme"
                                   FontSize="{DynamicResource AppFontSize12}"
                                   Foreground="{DynamicResource TextBrush}"/>
                    </StackPanel>

                    <ComboBox Grid.Column="1"
                              ItemsSource="{Binding ThemeOptions}"
                              SelectedIndex="{Binding SelectedThemeIndex}"
                              Height="36"/>
                </Grid>

                <Grid Margin="0,0,0,20">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="180"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel VerticalAlignment="Top">
                        <TextBlock Text="Font size"
                                   FontSize="{DynamicResource AppFontSize12}"
                                   Foreground="{DynamicResource TextBrush}"/>
                        <TextBlock Text="Adjust the default application text size."
                                   FontSize="{DynamicResource AppFontSize11}"
                                   Foreground="{DynamicResource MutedBrush}"
                                   TextWrapping="Wrap"
                                   Margin="0,4,12,0"/>
                    </StackPanel>

                    <ComboBox Grid.Column="1"
                              ItemsSource="{Binding FontSizeOptions}"
                              SelectedIndex="{Binding SelectedFontSizeIndex}"
                              Height="36"/>
                </Grid>

                <!-- Security -->
                <Border BorderBrush="{DynamicResource BorderBrush}"
                        BorderThickness="0,0,0,1"
                        Margin="0,0,0,12"
                        Padding="0,0,0,8">
                    <TextBlock Text="Security"
                               FontSize="{DynamicResource AppFontSize13}"
                               FontWeight="SemiBold"
                               Foreground="{DynamicResource TextBrush}"/>
                </Border>

                <Grid Margin="0,0,0,20">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="180"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel VerticalAlignment="Top">
                        <TextBlock Text="Auto-lock"
                                   FontSize="{DynamicResource AppFontSize12}"
                                   Foreground="{DynamicResource TextBrush}"/>
                        <TextBlock Text="Lock the vault after this many minutes of inactivity. Use 0 to disable."
                                   FontSize="{DynamicResource AppFontSize11}"
                                   Foreground="{DynamicResource MutedBrush}"
                                   TextWrapping="Wrap"
                                   Margin="0,4,12,0"/>
                    </StackPanel>

                    <StackPanel Grid.Column="1"
                                VerticalAlignment="Top">
                        <StackPanel Orientation="Horizontal"
                                    Height="36">
                            <TextBox x:Name="AutoLockTextBox"
                                     Text="{Binding AutoLockMinutes, UpdateSourceTrigger=PropertyChanged}"
                                     Width="70"
                                     Height="36"
                                     VerticalContentAlignment="Center"/>
                            <TextBlock Text="min"
                                       VerticalAlignment="Center"
                                       Margin="10,0,0,0"
                                       Foreground="{DynamicResource MutedBrush}"/>
                        </StackPanel>
                        <TextBlock Style="{StaticResource ValidationErrorText}"
                                   Text="{Binding AutoLockError, StringFormat=⚠ {0}}"
                                   Visibility="{Binding AutoLockError, Converter={StaticResource NullOrEmptyToVis}}"
                                   Margin="0,5,0,0"
                                   TextWrapping="Wrap"/>
                    </StackPanel>
                </Grid>

                <Grid Margin="0,0,0,20">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="180"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="Windows Hello"
                                   FontSize="{DynamicResource AppFontSize12}"
                                   Foreground="{DynamicResource TextBrush}"/>
                        <TextBlock Text="Unlock with Windows Hello after the first password unlock."
                                   FontSize="{DynamicResource AppFontSize11}"
                                   Foreground="{DynamicResource MutedBrush}"
                                   TextWrapping="Wrap"
                                   Margin="0,4,12,0"/>
                    </StackPanel>

                    <CheckBox Grid.Column="1"
                              IsChecked="{Binding WindowsHelloEnabled}"
                              HorizontalAlignment="Left"
                              VerticalAlignment="Center"
                              ToolTip="Unlock with Windows Hello after first password unlock"/>
                </Grid>

                <!-- Clipboard -->
                <Border BorderBrush="{DynamicResource BorderBrush}"
                        BorderThickness="0,0,0,1"
                        Margin="0,0,0,12"
                        Padding="0,0,0,8">
                    <TextBlock Text="Clipboard"
                               FontSize="{DynamicResource AppFontSize13}"
                               FontWeight="SemiBold"
                               Foreground="{DynamicResource TextBrush}"/>
                </Border>

                <Grid Margin="0,0,0,20">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="180"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel VerticalAlignment="Top">
                        <TextBlock Text="Clear after"
                                   FontSize="{DynamicResource AppFontSize12}"
                                   Foreground="{DynamicResource TextBrush}"/>
                        <TextBlock Text="Clear copied secrets from the clipboard after this delay."
                                   FontSize="{DynamicResource AppFontSize11}"
                                   Foreground="{DynamicResource MutedBrush}"
                                   TextWrapping="Wrap"
                                   Margin="0,4,12,0"/>
                    </StackPanel>

                    <StackPanel Grid.Column="1"
                                VerticalAlignment="Top">
                        <StackPanel Orientation="Horizontal"
                                    Height="36">
                            <TextBox x:Name="ClipboardTextBox"
                                     Text="{Binding ClipboardClearSeconds, UpdateSourceTrigger=PropertyChanged}"
                                     Width="70"
                                     Height="36"
                                     VerticalContentAlignment="Center"/>
                            <TextBlock Text="sec"
                                       VerticalAlignment="Center"
                                       Margin="10,0,0,0"
                                       Foreground="{DynamicResource MutedBrush}"/>
                        </StackPanel>
                        <TextBlock Style="{StaticResource ValidationErrorText}"
                                   Text="{Binding ClipboardError, StringFormat=⚠ {0}}"
                                   Visibility="{Binding ClipboardError, Converter={StaticResource NullOrEmptyToVis}}"
                                   Margin="0,5,0,0"
                                   TextWrapping="Wrap"/>
                    </StackPanel>
                </Grid>

                <!-- Vault -->
                <Border BorderBrush="{DynamicResource BorderBrush}"
                        BorderThickness="0,0,0,1"
                        Margin="0,0,0,12"
                        Padding="0,0,0,8">
                    <TextBlock Text="Vault"
                               FontSize="{DynamicResource AppFontSize13}"
                               FontWeight="SemiBold"
                               Foreground="{DynamicResource TextBrush}"/>
                </Border>

                <Grid Margin="0,0,0,20">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="180"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="Master password"
                                   FontSize="{DynamicResource AppFontSize12}"
                                   Foreground="{DynamicResource TextBrush}"/>
                        <TextBlock Text="Re-encrypt this vault with a new master password."
                                   FontSize="{DynamicResource AppFontSize11}"
                                   Foreground="{DynamicResource MutedBrush}"
                                   TextWrapping="Wrap"
                                   Margin="0,4,12,0"/>
                    </StackPanel>

                    <Button Grid.Column="1"
                            Style="{StaticResource SecondaryButton}"
                            Content="Change password…"
                            Command="{Binding ChangeMasterPasswordCommand}"
                            HorizontalAlignment="Left"
                            Padding="12,7"
                            ToolTip="Verify current password and set a new one"/>
                </Grid>

                <!-- Keyboard Shortcuts -->
                <Border BorderBrush="{DynamicResource BorderBrush}"
                        BorderThickness="0,0,0,1"
                        Margin="0,0,0,12"
                        Padding="0,0,0,8">
                    <TextBlock Text="Keyboard shortcuts"
                               FontSize="{DynamicResource AppFontSize13}"
                               FontWeight="SemiBold"
                               Foreground="{DynamicResource TextBrush}"/>
                </Border>

                <Border Background="{DynamicResource SurfaceBrush}"
                        CornerRadius="8"
                        Padding="16,12"
                        Margin="0,0,0,8">
                    <StackPanel>
                        <TextBlock Foreground="{DynamicResource TextBrush}" Margin="0,0,0,6" FontFamily="Consolas" FontSize="{DynamicResource AppFontSize12}"><Run FontWeight="SemiBold" Text="Ctrl+N"/><Run Foreground="{DynamicResource MutedBrush}" Text="  New entry"/></TextBlock>
                        <TextBlock Foreground="{DynamicResource TextBrush}" Margin="0,0,0,6" FontFamily="Consolas" FontSize="{DynamicResource AppFontSize12}"><Run FontWeight="SemiBold" Text="Ctrl+E"/><Run Foreground="{DynamicResource MutedBrush}" Text="  Edit entry"/></TextBlock>
                        <TextBlock Foreground="{DynamicResource TextBrush}" Margin="0,0,0,6" FontFamily="Consolas" FontSize="{DynamicResource AppFontSize12}"><Run FontWeight="SemiBold" Text="Enter"/><Run Foreground="{DynamicResource MutedBrush}" Text="  Edit selected entry"/></TextBlock>
                        <TextBlock Foreground="{DynamicResource TextBrush}" Margin="0,0,0,6" FontFamily="Consolas" FontSize="{DynamicResource AppFontSize12}"><Run FontWeight="SemiBold" Text="Delete"/><Run Foreground="{DynamicResource MutedBrush}" Text="  Move selected entry to trash"/></TextBlock>
                        <TextBlock Foreground="{DynamicResource TextBrush}" Margin="0,0,0,6" FontFamily="Consolas" FontSize="{DynamicResource AppFontSize12}"><Run FontWeight="SemiBold" Text="Ctrl+K"/><Run Foreground="{DynamicResource MutedBrush}" Text="  Search"/></TextBlock>
                        <TextBlock Foreground="{DynamicResource TextBrush}" Margin="0,0,0,6" FontFamily="Consolas" FontSize="{DynamicResource AppFontSize12}"><Run FontWeight="SemiBold" Text="Ctrl+C"/><Run Foreground="{DynamicResource MutedBrush}" Text="  Copy password"/></TextBlock>
                        <TextBlock Foreground="{DynamicResource TextBrush}" Margin="0,0,0,6" FontFamily="Consolas" FontSize="{DynamicResource AppFontSize12}"><Run FontWeight="SemiBold" Text="Ctrl+Shift+C"/><Run Foreground="{DynamicResource MutedBrush}" Text="  Copy username"/></TextBlock>
                        <TextBlock Foreground="{DynamicResource TextBrush}" Margin="0,0,0,6" FontFamily="Consolas" FontSize="{DynamicResource AppFontSize12}"><Run FontWeight="SemiBold" Text="Ctrl+T"/><Run Foreground="{DynamicResource MutedBrush}" Text="  Copy TOTP"/></TextBlock>
                        <TextBlock Foreground="{DynamicResource TextBrush}" Margin="0,0,0,6" FontFamily="Consolas" FontSize="{DynamicResource AppFontSize12}"><Run FontWeight="SemiBold" Text="Ctrl+L"/><Run Foreground="{DynamicResource MutedBrush}" Text="  Lock vault"/></TextBlock>
                        <TextBlock Foreground="{DynamicResource TextBrush}" Margin="0,0,0,6" FontFamily="Consolas" FontSize="{DynamicResource AppFontSize12}"><Run FontWeight="SemiBold" Text="Ctrl+B"/><Run Foreground="{DynamicResource MutedBrush}" Text="  Backup"/></TextBlock>
                        <TextBlock Foreground="{DynamicResource TextBrush}" Margin="0,0,0,6" FontFamily="Consolas" FontSize="{DynamicResource AppFontSize12}"><Run FontWeight="SemiBold" Text="Ctrl+H"/><Run Foreground="{DynamicResource MutedBrush}" Text="  Vault Health"/></TextBlock>
                        <TextBlock Foreground="{DynamicResource TextBrush}" Margin="0,0,0,6" FontFamily="Consolas" FontSize="{DynamicResource AppFontSize12}"><Run FontWeight="SemiBold" Text="Ctrl+Shift+T"/><Run Foreground="{DynamicResource MutedBrush}" Text="  Trash"/></TextBlock>
                        <TextBlock Foreground="{DynamicResource TextBrush}" Margin="0,0,0,6" FontFamily="Consolas" FontSize="{DynamicResource AppFontSize12}"><Run FontWeight="SemiBold" Text="Ctrl+S"/><Run Foreground="{DynamicResource MutedBrush}" Text="  Settings"/></TextBlock>
                        <TextBlock Foreground="{DynamicResource TextBrush}" FontFamily="Consolas" FontSize="{DynamicResource AppFontSize12}"><Run FontWeight="SemiBold" Text="Esc"/><Run Foreground="{DynamicResource MutedBrush}" Text="  Clear selection"/></TextBlock>
                    </StackPanel>
                </Border>
            </StackPanel>
        </ScrollViewer>

        <StackPanel Grid.Row="2"
                    Orientation="Horizontal"
                    HorizontalAlignment="Right"
                    Margin="0,16,0,0">
            <Button Style="{StaticResource SecondaryButton}"
                    Content="Cancel"
                    Command="{Binding CancelCommand}"
                    IsCancel="True"
                    Margin="0,0,8,0"
                    Background="{DynamicResource SurfaceAltBrush}"
                    Foreground="{DynamicResource TextBrush}"/>
            <Button Style="{StaticResource PrimaryButton}"
                    Content="Save"
                    Command="{Binding SaveCommand}"
                    IsDefault="True"/>
        </StackPanel>
            </Grid>
    </ScrollViewer>
</Window>
