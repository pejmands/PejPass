<Window
	x:Class="PejPass.Wpf.Views.SettingsWindow"
	xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
	xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
	xmlns:controls="clr-namespace:PejPass.Wpf.Controls"
	Title="Settings"
	Width="520"
	Height="680"
	MinWidth="460"
	MinHeight="560"
	Background="{DynamicResource BgBrush}"
	ResizeMode="CanResize"
	ShowInTaskbar="False"
	WindowStartupLocation="CenterOwner">

	<Grid Margin="24">
		<Grid.RowDefinitions>
			<RowDefinition Height="Auto" />
			<RowDefinition Height="*" />
			<RowDefinition Height="Auto" />
		</Grid.RowDefinitions>

		<TextBlock
			Margin="0,0,0,20"
			FontSize="{DynamicResource AppFontSize22}"
			FontWeight="Bold"
			Foreground="{DynamicResource TextBrush}"
			Text="Settings" />

		<ScrollViewer
			Grid.Row="1"
			HorizontalScrollBarVisibility="Disabled"
			VerticalScrollBarVisibility="Auto">
			<StackPanel Margin="0,0,12,0">

				<!--  Appearance  -->
				<Border
					Margin="0,0,0,12"
					Padding="0,0,0,8"
					BorderBrush="{DynamicResource BorderBrush}"
					BorderThickness="0,0,0,1">
					<TextBlock
						FontSize="{DynamicResource AppFontSize13}"
						FontWeight="SemiBold"
						Foreground="{DynamicResource TextBrush}"
						Text="Appearance" />
				</Border>

				<Grid Margin="0,0,0,20">
					<Grid.ColumnDefinitions>
						<ColumnDefinition Width="*" />
						<ColumnDefinition Width="180" />
					</Grid.ColumnDefinitions>

					<StackPanel VerticalAlignment="Center">
						<TextBlock
							FontSize="{DynamicResource AppFontSize12}"
							Foreground="{DynamicResource TextBrush}"
							Text="Theme" />
					</StackPanel>

					<ComboBox
						Grid.Column="1"
						Height="36"
						ItemsSource="{Binding ThemeOptions}"
						SelectedIndex="{Binding SelectedThemeIndex}" />
				</Grid>

				<!-- Advanced: startup and tray behavior (hidden pre-login) -->
				<StackPanel Visibility="{Binding ShowAdvancedSettings, Converter={StaticResource BoolToVis}}">
					<Grid Margin="0,0,0,20">
						<Grid.ColumnDefinitions>
							<ColumnDefinition Width="*" />
							<ColumnDefinition Width="180" />
						</Grid.ColumnDefinitions>
						<StackPanel VerticalAlignment="Center">
							<TextBlock
								FontSize="{DynamicResource AppFontSize12}"
								Foreground="{DynamicResource TextBrush}"
								Text="Check for updates at startup" />
							<TextBlock
								Margin="0,4,12,0"
								FontSize="{DynamicResource AppFontSize11}"
								Foreground="{DynamicResource MutedBrush}"
								Text="When enabled, PejPass checks once when the app starts. Install still requires your confirmation."
								TextWrapping="Wrap" />
						</StackPanel>
						<CheckBox
							Grid.Column="1"
							HorizontalAlignment="Left"
							VerticalAlignment="Center"
							IsChecked="{Binding AutoCheckForUpdates}" />
					</Grid>

					<Grid Margin="0,0,0,20">
						<Grid.ColumnDefinitions>
							<ColumnDefinition Width="*" />
							<ColumnDefinition Width="180" />
						</Grid.ColumnDefinitions>
						<StackPanel VerticalAlignment="Center">
							<TextBlock
								FontSize="{DynamicResource AppFontSize12}"
								Foreground="{DynamicResource TextBrush}"
								Text="Start with Windows" />
							<TextBlock
								Margin="0,4,12,0"
								FontSize="{DynamicResource AppFontSize11}"
								Foreground="{DynamicResource MutedBrush}"
								Text="Start PejPass in the background when you sign in to Windows. The vault remains locked."
								TextWrapping="Wrap" />
						</StackPanel>
						<CheckBox
							Grid.Column="1"
							HorizontalAlignment="Left"
							VerticalAlignment="Center"
							IsChecked="{Binding StartWithWindows}" />
					</Grid>

					<Grid Margin="0,0,0,20">
						<Grid.ColumnDefinitions>
							<ColumnDefinition Width="*" />
							<ColumnDefinition Width="180" />
						</Grid.ColumnDefinitions>
						<StackPanel VerticalAlignment="Center">
							<TextBlock
								FontSize="{DynamicResource AppFontSize12}"
								Foreground="{DynamicResource TextBrush}"
								Text="Minimize to system tray" />
							<TextBlock
								Margin="0,4,12,0"
								FontSize="{DynamicResource AppFontSize11}"
								Foreground="{DynamicResource MutedBrush}"
								Text="When minimized, hide the window to the tray instead of leaving it minimized."
								TextWrapping="Wrap" />
						</StackPanel>
						<CheckBox
							Grid.Column="1"
							HorizontalAlignment="Left"
							VerticalAlignment="Center"
							IsChecked="{Binding MinimizeToSystemTray}" />
					</Grid>

					<Grid Margin="0,0,0,20">
						<Grid.ColumnDefinitions>
							<ColumnDefinition Width="*" />
							<ColumnDefinition Width="180" />
						</Grid.ColumnDefinitions>
						<StackPanel VerticalAlignment="Center">
							<TextBlock
								FontSize="{DynamicResource AppFontSize12}"
								Foreground="{DynamicResource TextBrush}"
								Text="Close to system tray" />
							<TextBlock
								Margin="0,4,12,0"
								FontSize="{DynamicResource AppFontSize11}"
								Foreground="{DynamicResource MutedBrush}"
								Text="When closed, hide the window to the tray instead of exiting."
								TextWrapping="Wrap" />
						</StackPanel>
						<CheckBox
							Grid.Column="1"
							HorizontalAlignment="Left"
							VerticalAlignment="Center"
							IsChecked="{Binding CloseToSystemTray}" />
					</Grid>

				</StackPanel>

				<!-- Advanced: favicon (hidden pre-login) -->
				<StackPanel Visibility="{Binding ShowAdvancedSettings, Converter={StaticResource BoolToVis}}">
					<Grid Margin="0,0,0,20">
						<Grid.ColumnDefinitions>
							<ColumnDefinition Width="*" />
							<ColumnDefinition Width="180" />
						</Grid.ColumnDefinitions>
						<StackPanel VerticalAlignment="Center">
							<TextBlock
								FontSize="{DynamicResource AppFontSize12}"
								Foreground="{DynamicResource TextBrush}"
								Text="Download website icons" />
							<TextBlock
								Margin="0,4,12,0"
								FontSize="{DynamicResource AppFontSize11}"
								Foreground="{DynamicResource MutedBrush}"
								Text="When enabled, website domains may be shared with external icon providers to download favicons."
								TextWrapping="Wrap" />
						</StackPanel>
						<CheckBox
							Grid.Column="1"
							HorizontalAlignment="Left"
							VerticalAlignment="Center"
							IsChecked="{Binding OnlineFaviconFetchingEnabled}" />
					</Grid>

					<Grid Margin="0,0,0,20">
						<Grid.ColumnDefinitions>
							<ColumnDefinition Width="*" />
							<ColumnDefinition Width="180" />
						</Grid.ColumnDefinitions>
						<StackPanel VerticalAlignment="Top">
							<TextBlock
								FontSize="{DynamicResource AppFontSize12}"
								Foreground="{DynamicResource TextBrush}"
								Text="Favicon cache" />
							<TextBlock
								Margin="0,4,12,0"
								FontSize="{DynamicResource AppFontSize11}"
								Foreground="{DynamicResource MutedBrush}"
								Text="Stored website icons are removed automatically over time."
								TextWrapping="Wrap" />
						</StackPanel>
						<Button
							Grid.Column="1"
							Height="36"
							Padding="12,6"
							HorizontalAlignment="Left"
							Command="{Binding ClearFaviconCacheCommand}"
							Content="Clear cache"
							Style="{StaticResource SecondaryButton}"
							ToolTip="Remove all stored website icons" />
					</Grid>
				</StackPanel>

				<Grid Margin="0,0,0,20">
					<Grid.ColumnDefinitions>
						<ColumnDefinition Width="*" />
						<ColumnDefinition Width="180" />
					</Grid.ColumnDefinitions>

					<StackPanel VerticalAlignment="Top">
						<TextBlock
							FontSize="{DynamicResource AppFontSize12}"
							Foreground="{DynamicResource TextBrush}"
							Text="Font size" />
						<TextBlock
							Margin="0,4,12,0"
							FontSize="{DynamicResource AppFontSize11}"
							Foreground="{DynamicResource MutedBrush}"
							Text="Adjust the default application text size."
							TextWrapping="Wrap" />
					</StackPanel>

					<ComboBox
						Grid.Column="1"
						Height="36"
						ItemsSource="{Binding FontSizeOptions}"
						SelectedIndex="{Binding SelectedFontSizeIndex}" />
				</Grid>

				<Grid Margin="0,0,0,20">
					<Grid.ColumnDefinitions>
						<ColumnDefinition Width="*" />
						<ColumnDefinition Width="180" />
					</Grid.ColumnDefinitions>

					<StackPanel VerticalAlignment="Top">
						<TextBlock
							FontSize="{DynamicResource AppFontSize12}"
							Foreground="{DynamicResource TextBrush}"
							Text="Zoom" />
						<TextBlock
							Margin="0,4,12,0"
							FontSize="{DynamicResource AppFontSize11}"
							Foreground="{DynamicResource MutedBrush}"
							Text="Adjust the application interface scale."
							TextWrapping="Wrap" />
					</StackPanel>

					<ComboBox
						Grid.Column="1"
						Height="36"
						ItemsSource="{Binding ZoomOptions}"
						SelectedIndex="{Binding SelectedZoomIndex}" />
				</Grid>

				<!-- Advanced: Security + Clipboard (hidden pre-login) -->
				<StackPanel Visibility="{Binding ShowAdvancedSettings, Converter={StaticResource BoolToVis}}">
					<!--  Security  -->
					<Border
						Margin="0,0,0,12"
						Padding="0,0,0,8"
						BorderBrush="{DynamicResource BorderBrush}"
						BorderThickness="0,0,0,1">
						<TextBlock
							FontSize="{DynamicResource AppFontSize13}"
							FontWeight="SemiBold"
							Foreground="{DynamicResource TextBrush}"
							Text="Security" />
					</Border>

					<Grid Margin="0,0,0,20">
						<Grid.ColumnDefinitions>
							<ColumnDefinition Width="*" />
							<ColumnDefinition Width="180" />
						</Grid.ColumnDefinitions>
						<StackPanel VerticalAlignment="Top">
							<TextBlock
								FontSize="{DynamicResource AppFontSize12}"
								Foreground="{DynamicResource TextBrush}"
								Text="Hide revealed secrets after" />
							<TextBlock
								Margin="0,4,12,0"
								FontSize="{DynamicResource AppFontSize11}"
								Foreground="{DynamicResource MutedBrush}"
								Text="Automatically hide passwords and secret keys after they are revealed."
								TextWrapping="Wrap" />
						</StackPanel>
						<ComboBox
							Grid.Column="1"
							Height="36"
							ItemsSource="{Binding RevealSecretOptions}"
							SelectedIndex="{Binding SelectedRevealSecretIndex}" />
					</Grid>

					<Grid Margin="0,0,0,20">
						<Grid.ColumnDefinitions>
							<ColumnDefinition Width="*" />
							<ColumnDefinition Width="180" />
						</Grid.ColumnDefinitions>
						<StackPanel VerticalAlignment="Top">
							<TextBlock
								FontSize="{DynamicResource AppFontSize12}"
								Foreground="{DynamicResource TextBrush}"
								Text="Auto-lock" />
							<TextBlock
								Margin="0,4,12,0"
								FontSize="{DynamicResource AppFontSize11}"
								Foreground="{DynamicResource MutedBrush}"
								Text="Lock the vault after this many minutes of inactivity. Use 0 to disable."
								TextWrapping="Wrap" />
						</StackPanel>
						<StackPanel Grid.Column="1" VerticalAlignment="Top">
							<StackPanel Height="36" Orientation="Horizontal">
								<TextBox
									x:Name="AutoLockTextBox"
									Width="70"
									Height="36"
									VerticalContentAlignment="Center"
									MaxLength="4"
									Text="{Binding AutoLockMinutes, UpdateSourceTrigger=PropertyChanged}" />
								<TextBlock
									Margin="10,0,0,0"
									VerticalAlignment="Center"
									Foreground="{DynamicResource MutedBrush}"
									Text="min" />
							</StackPanel>
							<TextBlock
								Margin="0,5,0,0"
								Style="{StaticResource ValidationErrorText}"
								Text="{Binding AutoLockError, StringFormat=⚠ {0}}"
								TextWrapping="Wrap"
								Visibility="{Binding AutoLockError, Converter={StaticResource NullOrEmptyToVis}}" />
						</StackPanel>
					</Grid>

					<Grid Margin="0,0,0,20">
						<Grid.ColumnDefinitions>
							<ColumnDefinition Width="*" />
							<ColumnDefinition Width="180" />
						</Grid.ColumnDefinitions>
						<StackPanel VerticalAlignment="Center">
							<TextBlock
								FontSize="{DynamicResource AppFontSize12}"
								Foreground="{DynamicResource TextBrush}"
								Text="Windows Hello" />
							<TextBlock
								Margin="0,4,12,0"
								FontSize="{DynamicResource AppFontSize11}"
								Foreground="{DynamicResource MutedBrush}"
								Text="Unlock with Windows Hello after the first password unlock."
								TextWrapping="Wrap" />
						</StackPanel>
						<CheckBox
							Grid.Column="1"
							HorizontalAlignment="Left"
							VerticalAlignment="Center"
							IsChecked="{Binding WindowsHelloEnabled}"
							ToolTip="Unlock with Windows Hello after first password unlock" />
					</Grid>
					<Grid Margin="0,0,0,20">
						<Grid.ColumnDefinitions>
							<ColumnDefinition Width="*" />
							<ColumnDefinition Width="180" />
						</Grid.ColumnDefinitions>
						<StackPanel VerticalAlignment="Top">
							<TextBlock
								FontSize="{DynamicResource AppFontSize12}"
								Foreground="{DynamicResource TextBrush}"
								Text="Require master password again after" />
							<TextBlock
								Margin="0,4,12,0"
								FontSize="{DynamicResource AppFontSize11}"
								Foreground="{DynamicResource MutedBrush}"
								Text="The timer starts after successful master-password authentication. Windows Hello does not extend it. Windows lock or suspend clears the cache immediately."
								TextWrapping="Wrap" />
						</StackPanel>
						<ComboBox
							Grid.Column="1"
							Height="36"
							ItemsSource="{Binding WindowsHelloTimeoutOptions}"
							SelectedIndex="{Binding SelectedWindowsHelloTimeoutIndex}" />
					</Grid>

					<Grid Margin="0,0,0,20">
						<Grid.ColumnDefinitions>
							<ColumnDefinition Width="*" />
							<ColumnDefinition Width="180" />
						</Grid.ColumnDefinitions>
						<StackPanel VerticalAlignment="Top">
							<TextBlock
								FontSize="{DynamicResource AppFontSize12}"
								Foreground="{DynamicResource TextBrush}"
								Text="Master password" />
							<TextBlock
								Margin="0,4,12,0"
								FontSize="{DynamicResource AppFontSize11}"
								Foreground="{DynamicResource MutedBrush}"
								Text="Change the password used to encrypt and unlock your vault."
								TextWrapping="Wrap" />
						</StackPanel>
						<Button
							Grid.Column="1"
							Height="36"
							Padding="12,6"
							HorizontalAlignment="Left"
							Command="{Binding ChangeMasterPasswordCommand}"
							Content="Change password"
							Style="{StaticResource SecondaryButton}"
							ToolTip="Change the master password used to protect the vault" />
					</Grid>

					<!--  Clipboard  -->
					<Border
						Margin="0,0,0,12"
						Padding="0,0,0,8"
						BorderBrush="{DynamicResource BorderBrush}"
						BorderThickness="0,0,0,1">
						<TextBlock
							FontSize="{DynamicResource AppFontSize13}"
							FontWeight="SemiBold"
							Foreground="{DynamicResource TextBrush}"
							Text="Clipboard" />
					</Border>

					<Grid Margin="0,0,0,20">
						<Grid.ColumnDefinitions>
							<ColumnDefinition Width="*" />
							<ColumnDefinition Width="180" />
						</Grid.ColumnDefinitions>
						<StackPanel VerticalAlignment="Top">
							<TextBlock
								FontSize="{DynamicResource AppFontSize12}"
								Foreground="{DynamicResource TextBrush}"
								Text="Clear after" />
							<TextBlock
								Margin="0,4,12,0"
								FontSize="{DynamicResource AppFontSize11}"
								Foreground="{DynamicResource MutedBrush}"
								Text="Clear copied secrets from the clipboard after this delay."
								TextWrapping="Wrap" />
						</StackPanel>
						<StackPanel Grid.Column="1" VerticalAlignment="Top">
							<StackPanel Height="36" Orientation="Horizontal">
								<TextBox
									x:Name="ClipboardTextBox"
									Width="70"
									Height="36"
									VerticalContentAlignment="Center"
									MaxLength="3"
									Text="{Binding ClipboardClearSeconds, UpdateSourceTrigger=PropertyChanged}" />
								<TextBlock
									Margin="10,0,0,0"
									VerticalAlignment="Center"
									Foreground="{DynamicResource MutedBrush}"
									Text="sec" />
							</StackPanel>
							<TextBlock
								Margin="0,5,0,0"
								Style="{StaticResource ValidationErrorText}"
								Text="{Binding ClipboardError, StringFormat=⚠ {0}}"
								TextWrapping="Wrap"
								Visibility="{Binding ClipboardError, Converter={StaticResource NullOrEmptyToVis}}" />
						</StackPanel>
					</Grid>
				</StackPanel>

				<!--  Keyboard Shortcuts (always visible, including pre-login)  -->
				<Border
					Margin="0,0,0,12"
					Padding="0,0,0,8"
					BorderBrush="{DynamicResource BorderBrush}"
					BorderThickness="0,0,0,1">
					<TextBlock
						FontSize="{DynamicResource AppFontSize13}"
						FontWeight="SemiBold"
						Foreground="{DynamicResource TextBrush}"
						Text="Keyboard shortcuts" />
				</Border>

				<Border
					Margin="0,0,0,8"
					Padding="16,12"
					Background="{DynamicResource SurfaceBrush}"
					CornerRadius="8">
					<StackPanel>
						<TextBlock Margin="0,0,0,6" FontFamily="Consolas" FontSize="{DynamicResource AppFontSize12}" Foreground="{DynamicResource TextBrush}"><Run FontWeight="SemiBold" Text="Ctrl+N" /><Run Foreground="{DynamicResource MutedBrush}" Text="  New entry" /></TextBlock>
						<TextBlock Margin="0,0,0,6" FontFamily="Consolas" FontSize="{DynamicResource AppFontSize12}" Foreground="{DynamicResource TextBrush}"><Run FontWeight="SemiBold" Text="Ctrl+E" /><Run Foreground="{DynamicResource MutedBrush}" Text="  Edit entry" /></TextBlock>
						<TextBlock Margin="0,0,0,6" FontFamily="Consolas" FontSize="{DynamicResource AppFontSize12}" Foreground="{DynamicResource TextBrush}"><Run FontWeight="SemiBold" Text="Enter" /><Run Foreground="{DynamicResource MutedBrush}" Text="  Edit selected entry" /></TextBlock>
						<TextBlock Margin="0,0,0,6" FontFamily="Consolas" FontSize="{DynamicResource AppFontSize12}" Foreground="{DynamicResource TextBrush}"><Run FontWeight="SemiBold" Text="Delete" /><Run Foreground="{DynamicResource MutedBrush}" Text="  Move selected entry to trash" /></TextBlock>
						<TextBlock Margin="0,0,0,6" FontFamily="Consolas" FontSize="{DynamicResource AppFontSize12}" Foreground="{DynamicResource TextBrush}"><Run FontWeight="SemiBold" Text="Ctrl+K" /><Run Foreground="{DynamicResource MutedBrush}" Text="  Search" /></TextBlock>
						<TextBlock Margin="0,0,0,6" FontFamily="Consolas" FontSize="{DynamicResource AppFontSize12}" Foreground="{DynamicResource TextBrush}"><Run FontWeight="SemiBold" Text="Ctrl+C" /><Run Foreground="{DynamicResource MutedBrush}" Text="  Copy password" /></TextBlock>
						<TextBlock Margin="0,0,0,6" FontFamily="Consolas" FontSize="{DynamicResource AppFontSize12}" Foreground="{DynamicResource TextBrush}"><Run FontWeight="SemiBold" Text="Ctrl+Shift+C" /><Run Foreground="{DynamicResource MutedBrush}" Text="  Copy username" /></TextBlock>
						<TextBlock Margin="0,0,0,6" FontFamily="Consolas" FontSize="{DynamicResource AppFontSize12}" Foreground="{DynamicResource TextBrush}"><Run FontWeight="SemiBold" Text="Ctrl+T" /><Run Foreground="{DynamicResource MutedBrush}" Text="  Copy TOTP" /></TextBlock>
						<TextBlock Margin="0,0,0,6" FontFamily="Consolas" FontSize="{DynamicResource AppFontSize12}" Foreground="{DynamicResource TextBrush}"><Run FontWeight="SemiBold" Text="Ctrl+L" /><Run Foreground="{DynamicResource MutedBrush}" Text="  Lock vault" /></TextBlock>
						<TextBlock Margin="0,0,0,6" FontFamily="Consolas" FontSize="{DynamicResource AppFontSize12}" Foreground="{DynamicResource TextBrush}"><Run FontWeight="SemiBold" Text="Ctrl+B" /><Run Foreground="{DynamicResource MutedBrush}" Text="  Backup" /></TextBlock>
						<TextBlock Margin="0,0,0,6" FontFamily="Consolas" FontSize="{DynamicResource AppFontSize12}" Foreground="{DynamicResource TextBrush}"><Run FontWeight="SemiBold" Text="Ctrl+H" /><Run Foreground="{DynamicResource MutedBrush}" Text="  Vault Health" /></TextBlock>
						<TextBlock Margin="0,0,0,6" FontFamily="Consolas" FontSize="{DynamicResource AppFontSize12}" Foreground="{DynamicResource TextBrush}"><Run FontWeight="SemiBold" Text="Ctrl+Shift+T" /><Run Foreground="{DynamicResource MutedBrush}" Text="  Trash" /></TextBlock>
						<TextBlock Margin="0,0,0,6" FontFamily="Consolas" FontSize="{DynamicResource AppFontSize12}" Foreground="{DynamicResource TextBrush}"><Run FontWeight="SemiBold" Text="Ctrl+S" /><Run Foreground="{DynamicResource MutedBrush}" Text="  Settings" /></TextBlock>
					</StackPanel>
				</Border>

			</StackPanel>
		</ScrollViewer>

		<StackPanel
			Grid.Row="2"
			Margin="0,16,0,0"
			HorizontalAlignment="Right"
			Orientation="Horizontal">
			<Button
				Width="100"
				Height="36"
				Margin="0,0,8,0"
				Command="{Binding CancelCommand}"
				Content="Cancel"
				Style="{StaticResource SecondaryButton}" />
			<Button
				Width="100"
				Height="36"
				Command="{Binding SaveCommand}"
				Content="Save"
				Style="{StaticResource PrimaryButton}" />
		</StackPanel>
	</Grid>
</Window>
