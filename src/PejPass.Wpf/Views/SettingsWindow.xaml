<Window x:Class="PejPass.Wpf.Views.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Settings"
        Height="640"
        Width="480"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        Background="{DynamicResource BgBrush}">

    <Grid Margin="18">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Text="Settings"
                   FontSize="22"
                   FontWeight="Bold"
                   Foreground="{DynamicResource TextBrush}"
                   Margin="0,0,0,20"/>

        <ScrollViewer Grid.Row="1"
                      VerticalScrollBarVisibility="Auto">
            <StackPanel Margin="0,0,12,0">

                <TextBlock Text="THEME"
                           FontSize="11"
                           FontWeight="SemiBold"
                           Foreground="{DynamicResource MutedBrush}"
                           Margin="0,0,0,6"/>

                <ComboBox ItemsSource="{Binding ThemeOptions}"
                          SelectedIndex="{Binding SelectedThemeIndex}"
                          Height="40"
                          Margin="0,0,0,20"/>

                <TextBlock Text="AUTO-LOCK"
                           FontSize="11"
                           FontWeight="SemiBold"
                           Foreground="{DynamicResource MutedBrush}"
                           Margin="0,0,0,6"/>

                <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                    <TextBox Text="{Binding AutoLockMinutes, UpdateSourceTrigger=PropertyChanged}"
                             Width="80" Height="36" VerticalContentAlignment="Center"/>
                    <TextBlock Text="minutes (0 = never)"
                               VerticalAlignment="Center"
                               Margin="10,0,0,0"
                               Foreground="{DynamicResource MutedBrush}"/>
                </StackPanel>

                <TextBlock Text="Lock the vault after this many minutes of inactivity."
                           FontSize="11"
                           Foreground="{DynamicResource MutedBrush}"
                           Margin="0,0,0,20"
                           TextWrapping="Wrap"/>

                <TextBlock Text="CLIPBOARD"
                           FontSize="11"
                           FontWeight="SemiBold"
                           Foreground="{DynamicResource MutedBrush}"
                           Margin="0,0,0,6"/>

                <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                    <TextBox Text="{Binding ClipboardClearSeconds, UpdateSourceTrigger=PropertyChanged}"
                             Width="80" Height="36" VerticalContentAlignment="Center"/>
                    <TextBlock Text="seconds"
                               VerticalAlignment="Center"
                               Margin="10,0,0,0"
                               Foreground="{DynamicResource MutedBrush}"/>
                </StackPanel>

                <TextBlock Text="Clear copied secrets from the clipboard after this delay."
                           FontSize="11"
                           Foreground="{DynamicResource MutedBrush}"
                           Margin="0,0,0,20"
                           TextWrapping="Wrap"/>

                <TextBlock Text="WINDOWS HELLO"
                           FontSize="11"
                           FontWeight="SemiBold"
                           Foreground="{DynamicResource MutedBrush}"
                           Margin="0,0,0,6"/>

                <CheckBox Content="Unlock with Windows Hello after first password unlock"
                          IsChecked="{Binding WindowsHelloEnabled}"
                          Margin="0,0,0,4"/>

                <TextBlock Text="Requires a successful master-password unlock in this session. Cache is cleared when you exit the app or turn this off."
                           FontSize="11"
                           Foreground="{DynamicResource MutedBrush}"
                           Margin="0,0,0,20"
                           TextWrapping="Wrap"/>

                <TextBlock Text="MASTER PASSWORD"
                           FontSize="11"
                           FontWeight="SemiBold"
                           Foreground="{DynamicResource MutedBrush}"
                           Margin="0,8,0,8"/>

                <TextBlock Text="Re-encrypt this vault with a new master password. You must enter the current password."
                           FontSize="12"
                           TextWrapping="Wrap"
                           Foreground="{DynamicResource MutedBrush}"
                           Margin="0,0,0,10"/>

                <Button Content="Change master password…"
                        Command="{Binding ChangeMasterPasswordCommand}"
                        HorizontalAlignment="Left"
                        Padding="14,8"
                        Margin="0,0,0,20"
                        Background="{DynamicResource SurfaceAltBrush}"
                        Foreground="{DynamicResource TextBrush}"
                        ToolTip="Verify current password and set a new one"/>

                <TextBlock Text="KEYBOARD SHORTCUTS"
                           FontSize="11"
                           FontWeight="SemiBold"
                           Foreground="{DynamicResource MutedBrush}"
                           Margin="0,8,0,8"/>

                <Border Background="{DynamicResource SurfaceBrush}"
                        CornerRadius="8"
                        Padding="14,12"
                        Margin="0,0,0,8">
                    <StackPanel>
                        <TextBlock Foreground="{DynamicResource TextBrush}" Margin="0,0,0,6" FontFamily="Consolas" FontSize="12">
                            <Run FontWeight="SemiBold" Text="Ctrl+N"/><Run Foreground="{DynamicResource MutedBrush}" Text="  New entry"/>
                        </TextBlock>
                        <TextBlock Foreground="{DynamicResource TextBrush}" Margin="0,0,0,6" FontFamily="Consolas" FontSize="12">
                            <Run FontWeight="SemiBold" Text="Ctrl+E"/><Run Foreground="{DynamicResource MutedBrush}" Text="  Edit entry"/>
                        </TextBlock>
                        <TextBlock Foreground="{DynamicResource TextBrush}" Margin="0,0,0,6" FontFamily="Consolas" FontSize="12">
                            <Run FontWeight="SemiBold" Text="Ctrl+F / Ctrl+K"/><Run Foreground="{DynamicResource MutedBrush}" Text="  Search"/>
                        </TextBlock>
                        <TextBlock Foreground="{DynamicResource TextBrush}" Margin="0,0,0,6" FontFamily="Consolas" FontSize="12">
                            <Run FontWeight="SemiBold" Text="Ctrl+C"/><Run Foreground="{DynamicResource MutedBrush}" Text="  Copy password"/>
                        </TextBlock>
                        <TextBlock Foreground="{DynamicResource TextBrush}" Margin="0,0,0,6" FontFamily="Consolas" FontSize="12">
                            <Run FontWeight="SemiBold" Text="Ctrl+Shift+C"/><Run Foreground="{DynamicResource MutedBrush}" Text="  Copy username"/>
                        </TextBlock>
                        <TextBlock Foreground="{DynamicResource TextBrush}" Margin="0,0,0,6" FontFamily="Consolas" FontSize="12">
                            <Run FontWeight="SemiBold" Text="Ctrl+B"/><Run Foreground="{DynamicResource MutedBrush}" Text="  Backup"/>
                        </TextBlock>
                        <TextBlock Foreground="{DynamicResource TextBrush}" Margin="0,0,0,6" FontFamily="Consolas" FontSize="12">
                            <Run FontWeight="SemiBold" Text="Ctrl+H"/><Run Foreground="{DynamicResource MutedBrush}" Text="  Health"/>
                        </TextBlock>
                        <TextBlock Foreground="{DynamicResource TextBrush}" Margin="0,0,0,6" FontFamily="Consolas" FontSize="12">
                            <Run FontWeight="SemiBold" Text="Ctrl+Shift+T"/><Run Foreground="{DynamicResource MutedBrush}" Text="  Trash"/>
                        </TextBlock>
                        <TextBlock Foreground="{DynamicResource TextBrush}" Margin="0,0,0,6" FontFamily="Consolas" FontSize="12">
                            <Run FontWeight="SemiBold" Text="Ctrl+S"/><Run Foreground="{DynamicResource MutedBrush}" Text="  Settings"/>
                        </TextBlock>
                        <TextBlock Foreground="{DynamicResource TextBrush}" Margin="0,0,0,6" FontFamily="Consolas" FontSize="12">
                            <Run FontWeight="SemiBold" Text="Ctrl+L"/><Run Foreground="{DynamicResource MutedBrush}" Text="  Lock vault"/>
                        </TextBlock>
                        <TextBlock Foreground="{DynamicResource TextBrush}" FontFamily="Consolas" FontSize="12">
                            <Run FontWeight="SemiBold" Text="Delete"/><Run Foreground="{DynamicResource MutedBrush}" Text="  Move to trash"/>
                        </TextBlock>
                        <TextBlock Foreground="{DynamicResource TextBrush}" FontFamily="Consolas" FontSize="12" Margin="0,6,0,0">
                            <Run FontWeight="SemiBold" Text="Esc"/><Run Foreground="{DynamicResource MutedBrush}" Text="  Clear selection"/>
                        </TextBlock>
                    </StackPanel>
                </Border>
            </StackPanel>
        </ScrollViewer>

        <StackPanel Grid.Row="2"
                    Orientation="Horizontal"
                    HorizontalAlignment="Right"
                    Margin="0,16,0,0">
            <Button Content="Cancel"
                    Command="{Binding CancelCommand}"
                    Margin="0,0,8,0"
                    Background="{DynamicResource SurfaceAltBrush}"
                    Foreground="{DynamicResource TextBrush}"/>
            <Button Content="Save"
                    Command="{Binding SaveCommand}"
                    IsDefault="True"/>
        </StackPanel>
    </Grid>
</Window>
