<Window
    x:Class="PejPass.Wpf.Views.SiteProfilesWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="Site Groups"
    Width="820"
    Height="560"
    MinWidth="680"
    MinHeight="420"
    Background="{DynamicResource BgBrush}"
    ResizeMode="CanResize"
    ShowInTaskbar="False"
    WindowStartupLocation="CenterOwner">
    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <TextBlock
            FontSize="{DynamicResource AppFontSize22}"
            FontWeight="Bold"
            Foreground="{DynamicResource TextBrush}"
            Text="Site Groups" />

        <TextBlock
            Grid.Row="1"
            Margin="0,8,0,16"
            Foreground="{DynamicResource MutedTextBrush}"
            Text="Group login domains that belong to the same sign-in flow. Enter one hostname per line, without https:// or a path."
            TextWrapping="Wrap" />

        <DataGrid
            x:Name="ProfilesGrid"
            Grid.Row="2"
            AutoGenerateColumns="False"
            CanUserAddRows="False"
            CanUserDeleteRows="False"
            HeadersVisibility="Column"
            IsReadOnly="False"
            ItemsSource="{Binding Profiles}"
            SelectionMode="Single"
            SelectionUnit="FullRow"
            Background="{DynamicResource SurfaceBrush}"
            Foreground="{DynamicResource TextBrush}"
            BorderBrush="{DynamicResource BorderBrush}"
            GridLinesVisibility="Horizontal"
            RowBackground="{DynamicResource SurfaceBrush}"
            AlternatingRowBackground="{DynamicResource BgBrush}">
            <DataGrid.Columns>
                <DataGridTextColumn
                    Width="190"
                    Header="Group name"
                    Binding="{Binding Name, UpdateSourceTrigger=PropertyChanged}" />
                <DataGridTemplateColumn Width="*" Header="Domains (one per line)">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <TextBox
                                MinHeight="54"
                                Padding="6"
                                AcceptsReturn="True"
                                TextWrapping="Wrap"
                                VerticalScrollBarVisibility="Auto"
                                Background="{DynamicResource InputBrush}"
                                Foreground="{DynamicResource TextBrush}"
                                BorderBrush="{DynamicResource BorderBrush}"
                                Text="{Binding DomainsText, UpdateSourceTrigger=PropertyChanged}" />
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
            </DataGrid.Columns>
        </DataGrid>

        <TextBlock
            x:Name="ValidationText"
            Grid.Row="3"
            Margin="0,10,0,0"
            Foreground="{DynamicResource ValidationErrorBrush}"
            TextWrapping="Wrap"
            Visibility="Collapsed" />

        <Grid Grid.Row="4" Margin="0,18,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <StackPanel Orientation="Horizontal">
                <Button
                    Padding="12,7"
                    Margin="0,0,8,0"
                    Click="AddProfile_Click"
                    Content="Add Group"
                    Style="{StaticResource SecondaryButton}" />
                <Button
                    Padding="12,7"
                    Click="RemoveProfile_Click"
                    Content="Remove Selected"
                    Style="{StaticResource SecondaryButton}" />
            </StackPanel>
            <Button
                Grid.Column="1"
                Padding="14,7"
                Margin="8,0,0,0"
                Click="Cancel_Click"
                Content="Cancel"
                Style="{StaticResource SecondaryButton}" />
            <Button
                Grid.Column="2"
                Padding="14,7"
                Margin="8,0,0,0"
                Click="Save_Click"
                Content="Save"
                Style="{StaticResource PrimaryButton}" />
        </Grid>
    </Grid>
</Window>
