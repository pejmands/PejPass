<Window
	x:Class="PejPass.Wpf.Views.WhatsNewWindow"
	xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
	xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
	Title="What's New"
	Width="520"
	Height="620"
	MinWidth="480"
	MinHeight="480"
	Background="{DynamicResource BgBrush}"
	ResizeMode="NoResize"
	ShowInTaskbar="False"
	WindowStartupLocation="CenterOwner">

	<Grid Margin="28,20">

		<Grid.RowDefinitions>
			<RowDefinition Height="Auto" />
			<RowDefinition Height="*" />
			<RowDefinition Height="Auto" />
		</Grid.RowDefinitions>


		<StackPanel Margin="0,0,0,16">

			<TextBlock
				FontSize="{DynamicResource AppFontSize22}"
				FontWeight="Bold"
				Foreground="{DynamicResource TextBrush}"
				Text="What's New" />

			<TextBlock
				Margin="0,4,0,0"
				FontSize="{DynamicResource AppFontSize12}"
				Foreground="{DynamicResource MutedBrush}"
				Text="{Binding Subtitle}" />

			<ProgressBar
				Height="2"
				Margin="0,10,0,0"
				IsIndeterminate="True"
				Visibility="{Binding IsLoading, Converter={StaticResource BoolToVis}}" />

		</StackPanel>


		<ScrollViewer
			Grid.Row="1"
			Margin="0,0,0,16"
			VerticalScrollBarVisibility="Auto">

			<ItemsControl ItemsSource="{Binding Releases}">

				<ItemsControl.ItemTemplate>

					<DataTemplate>

						<Border
							Margin="0,0,0,12"
							Padding="16"
							Background="{DynamicResource SurfaceBrush}"
							CornerRadius="8">

							<StackPanel>

								<!-- Version row + badges -->
								<Grid>
									<Grid.ColumnDefinitions>
										<ColumnDefinition Width="*" />
										<ColumnDefinition Width="Auto" />
									</Grid.ColumnDefinitions>

									<TextBlock
										VerticalAlignment="Center"
										FontSize="{DynamicResource AppFontSize16}"
										FontWeight="SemiBold"
										Foreground="{DynamicResource TextBrush}"
										Text="{Binding Version}" />

									<StackPanel
										Grid.Column="1"
										Orientation="Horizontal">

										<Border
											Margin="6,0,0,0"
											Padding="6,2"
											Background="{DynamicResource AccentBrush}"
											CornerRadius="4"
											Visibility="{Binding IsAvailableUpdate, Converter={StaticResource BoolToVis}}">
											<TextBlock
												FontSize="{DynamicResource AppFontSize10}"
												FontWeight="SemiBold"
												Foreground="White"
												Text="Update" />
										</Border>

										<Border
											Margin="6,0,0,0"
											Padding="6,2"
											Background="{DynamicResource SurfaceAltBrush}"
											CornerRadius="4"
											Visibility="{Binding IsInstalled, Converter={StaticResource BoolToVis}}">
											<TextBlock
												FontSize="{DynamicResource AppFontSize10}"
												FontWeight="SemiBold"
												Foreground="{DynamicResource MutedBrush}"
												Text="Installed" />
										</Border>

										<Border
											Margin="6,0,0,0"
											Padding="6,2"
											Background="{DynamicResource SurfaceAltBrush}"
											CornerRadius="4"
											Visibility="{Binding IsLatest, Converter={StaticResource BoolToVis}}">
											<TextBlock
												FontSize="{DynamicResource AppFontSize10}"
												FontWeight="SemiBold"
												Foreground="{DynamicResource MutedBrush}"
												Text="Latest" />
										</Border>

									</StackPanel>

								</Grid>

								<TextBlock
									Margin="0,4,0,12"
									FontSize="{DynamicResource AppFontSize11}"
										Foreground="{DynamicResource MutedBrush}"
										Text="{Binding Date}"
										Visibility="{Binding Date, Converter={StaticResource NullOrEmptyToVis}}" />

								<!-- Added -->
								<StackPanel Visibility="{Binding Added, Converter={StaticResource NullOrEmptyToVis}}">
									<TextBlock
										FontWeight="SemiBold"
										Foreground="{DynamicResource TextBrush}"
										Text="Added" />
									<ItemsControl ItemsSource="{Binding Added}">
										<ItemsControl.ItemTemplate>
											<DataTemplate>
												<TextBlock
													Margin="0,4,0,0"
													Foreground="{DynamicResource TextBrush}"
													Text="{Binding StringFormat=• {0}}"
													TextWrapping="Wrap" />
											</DataTemplate>
										</ItemsControl.ItemTemplate>
									</ItemsControl>
								</StackPanel>

								<!-- Improved -->
								<StackPanel Margin="0,12,0,0" Visibility="{Binding Improved, Converter={StaticResource NullOrEmptyToVis}}">
									<TextBlock
										FontWeight="SemiBold"
										Foreground="{DynamicResource TextBrush}"
										Text="Improved" />
									<ItemsControl ItemsSource="{Binding Improved}">
										<ItemsControl.ItemTemplate>
											<DataTemplate>
												<TextBlock
													Margin="0,4,0,0"
													Foreground="{DynamicResource TextBrush}"
													Text="{Binding StringFormat=• {0}}"
													TextWrapping="Wrap" />
											</DataTemplate>
										</ItemsControl.ItemTemplate>
									</ItemsControl>
								</StackPanel>

								<!-- Fixed -->
								<StackPanel Margin="0,12,0,0" Visibility="{Binding Fixed, Converter={StaticResource NullOrEmptyToVis}}">
									<TextBlock
										FontWeight="SemiBold"
										Foreground="{DynamicResource TextBrush}"
										Text="Fixed" />
									<ItemsControl ItemsSource="{Binding Fixed}">
										<ItemsControl.ItemTemplate>
											<DataTemplate>
												<TextBlock
													Margin="0,4,0,0"
													Foreground="{DynamicResource TextBrush}"
													Text="{Binding StringFormat=• {0}}"
													TextWrapping="Wrap" />
											</DataTemplate>
										</ItemsControl.ItemTemplate>
									</ItemsControl>
								</StackPanel>

							</StackPanel>

						</Border>

					</DataTemplate>

				</ItemsControl.ItemTemplate>

			</ItemsControl>

		</ScrollViewer>


		<Button
			Grid.Row="2"
			Width="100"
			HorizontalAlignment="Center"
			Click="CloseButton_Click"
			Content="Close"
			IsCancel="True"
			IsDefault="True"
			Style="{StaticResource SecondaryButton}" />

	</Grid>

</Window>
