<Window
	x:Class="PejPass.Wpf.Views.WhatsNewWindow"
	xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
	xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
	Title="What's New"
	Width="520"
	Height="620"
	MinWidth="520"
	MinHeight="620"
	Background="{DynamicResource BgBrush}"
	ResizeMode="NoResize"
	ShowInTaskbar="False"
	WindowStartupLocation="CenterOwner">

	<Grid Margin="32">

		<Grid.RowDefinitions>
			<RowDefinition Height="Auto" />
			<RowDefinition Height="*" />
			<RowDefinition Height="Auto" />
		</Grid.RowDefinitions>


		<StackPanel>

			<TextBlock
				FontSize="{DynamicResource AppFontSize24}"
				FontWeight="Bold"
				Foreground="{DynamicResource TextBrush}"
				Text="What's New" />

			<TextBlock
				Margin="0,6,0,0"
				FontSize="{DynamicResource AppFontSize12}"
				Foreground="{DynamicResource MutedBrush}"
				Text="Latest changes and improvements" />

		</StackPanel>


		<ScrollViewer
			Grid.Row="1"
			Margin="0,28,0,20"
			VerticalScrollBarVisibility="Auto">

			<ItemsControl ItemsSource="{Binding Releases}">

				<ItemsControl.ItemTemplate>

					<DataTemplate>

						<Border
							Margin="0,0,0,12"
							Padding="16"
							Background="{DynamicResource SurfaceBrush}"
							CornerRadius="8">

							<StackPanel>

								<TextBlock
									FontSize="{DynamicResource AppFontSize16}"
									FontWeight="SemiBold"
									Foreground="{DynamicResource TextBrush}"
									Text="{Binding Version}" />

								<TextBlock
									Margin="0,4,0,16"
									FontSize="{DynamicResource AppFontSize11}"
									Foreground="{DynamicResource MutedBrush}"
									Text="{Binding Date}" />


								<TextBlock
									FontWeight="SemiBold"
									Foreground="{DynamicResource TextBrush}"
									Text="Added" />

								<ItemsControl ItemsSource="{Binding Added}">
									<ItemsControl.ItemTemplate>
										<DataTemplate>
											<TextBlock
												Margin="0,4,0,0"
												Foreground="{DynamicResource TextBrush}"
												Text="{Binding StringFormat=• {0}}" />
										</DataTemplate>
									</ItemsControl.ItemTemplate>
								</ItemsControl>


								<TextBlock
									Margin="0,14,0,0"
									FontWeight="SemiBold"
									Foreground="{DynamicResource TextBrush}"
									Text="Improved" />

								<ItemsControl ItemsSource="{Binding Improved}">
									<ItemsControl.ItemTemplate>
										<DataTemplate>
											<TextBlock
												Margin="0,4,0,0"
												Foreground="{DynamicResource TextBrush}"
												Text="{Binding StringFormat=• {0}}" />
										</DataTemplate>
									</ItemsControl.ItemTemplate>
								</ItemsControl>


								<TextBlock
									Margin="0,14,0,0"
									FontWeight="SemiBold"
									Foreground="{DynamicResource TextBrush}"
									Text="Fixed" />

								<ItemsControl ItemsSource="{Binding Fixed}">
									<ItemsControl.ItemTemplate>
										<DataTemplate>
											<TextBlock
												Margin="0,4,0,0"
												Foreground="{DynamicResource TextBrush}"
												Text="{Binding StringFormat=• {0}}" />
										</DataTemplate>
									</ItemsControl.ItemTemplate>
								</ItemsControl>

							</StackPanel>

						</Border>

					</DataTemplate>

				</ItemsControl.ItemTemplate>

			</ItemsControl>

		</ScrollViewer>


		<Button
			Grid.Row="2"
			Width="100"
			HorizontalAlignment="Center"
			Click="CloseButton_Click"
			Content="Close"
			IsDefault="True"
			Style="{StaticResource SecondaryButton}" />

	</Grid>

</Window>
