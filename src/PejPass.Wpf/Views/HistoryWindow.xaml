<Window x:Class="PejPass.Wpf.Views.HistoryWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="clr-namespace:PejPass.Wpf.Controls"
        Title="History"
        Width="1100"
        Height="700"
        MinWidth="900"
        MinHeight="560"
        WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False"
        Background="{DynamicResource BgBrush}">

    <DockPanel>

        <controls:AppTitleBar DockPanel.Dock="Top"
                              ShowMinimize="false"
                              ShowMaximize="true"/>

        <Grid Margin="24">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- Header -->
            <Grid Grid.Row="0"
                  Margin="0,0,0,16">

                <StackPanel>
                    <TextBlock Text="Entry History"
                               FontSize="22"
                               FontWeight="Bold"
                               Foreground="{DynamicResource TextBrush}"/>

                    <TextBlock Text="Previous versions of your entries"
                               FontSize="12"
                               Foreground="{DynamicResource MutedBrush}"
                               Margin="0,3,0,0"/>
                </StackPanel>
            </Grid>

            <!-- Content -->
            <Grid Grid.Row="1">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="42*"/>
                    <ColumnDefinition Width="58*"/>
                </Grid.ColumnDefinitions>

                <!-- History list -->
                <ListBox Grid.Column="0"
                         ItemsSource="{Binding Items}"
                         SelectedItem="{Binding SelectedItem}"
                         Background="Transparent"
                         BorderThickness="0"
                         ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                         ScrollViewer.VerticalScrollBarVisibility="Auto">

                    <ListBox.ItemContainerStyle>
                        <Style TargetType="ListBoxItem">
                            <Setter Property="HorizontalContentAlignment"
                                    Value="Stretch"/>
                            <Setter Property="Padding"
                                    Value="0"/>
                            <Setter Property="Margin"
                                    Value="0,0,12,6"/>

                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="ListBoxItem">
                                        <Border x:Name="ItemBorder"
                                                Background="{DynamicResource SurfaceBrush}"
                                                CornerRadius="8"
                                                Padding="14,12">

                                            <ContentPresenter/>
                                        </Border>

                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsSelected"
                                                     Value="True">
                                                <Setter TargetName="ItemBorder"
                                                        Property="Background"
                                                        Value="{DynamicResource SurfaceAltBrush}"/>
                                                <Setter TargetName="ItemBorder"
                                                        Property="BorderBrush"
                                                        Value="{DynamicResource AccentBrush}"/>
                                                <Setter TargetName="ItemBorder"
                                                        Property="BorderThickness"
                                                        Value="1"/>
                                            </Trigger>

                                            <Trigger Property="IsMouseOver"
                                                     Value="True">
                                                <Setter TargetName="ItemBorder"
                                                        Property="Background"
                                                        Value="{DynamicResource SurfaceAltBrush}"/>
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                        </Style>
                    </ListBox.ItemContainerStyle>

                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>

                                <StackPanel Grid.Column="0"
                                            VerticalAlignment="Center">

                                    <TextBlock Text="{Binding Title}"
                                               FontWeight="SemiBold"
                                               Foreground="{DynamicResource TextBrush}"
                                               TextTrimming="CharacterEllipsis"/>

                                    <TextBlock Text="{Binding Username}"
                                               FontSize="12"
                                               Foreground="{DynamicResource MutedBrush}"
                                               Margin="0,3,0,0"
                                               TextTrimming="CharacterEllipsis"/>

                                </StackPanel>

                                <TextBlock Grid.Column="1"
                                           Text="{Binding ChangedAtText}"
                                           FontSize="11"
                                           Foreground="{DynamicResource MutedBrush}"
                                           VerticalAlignment="Center"
                                           Margin="12,0,0,0"/>
                            </Grid>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>

                <!-- Snapshot -->
                <Border Grid.Column="1"
        Background="{DynamicResource SurfaceBrush}"
        CornerRadius="8"
        Padding="20">

                    <Grid>

                        <!-- Empty state -->
                        <StackPanel VerticalAlignment="Center"
            HorizontalAlignment="Center">

                            <StackPanel.Style>
                                <Style TargetType="StackPanel">
                                    <Setter Property="Visibility"
                    Value="Collapsed"/>

                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding SelectedItem}"
                             Value="{x:Null}">
                                            <Setter Property="Visibility"
                            Value="Visible"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </StackPanel.Style>

                            <TextBlock Text="No snapshot selected"
               FontSize="18"
               FontWeight="SemiBold"
               Foreground="{DynamicResource TextBrush}"
               HorizontalAlignment="Center"/>

                            <TextBlock Text="Select a history snapshot to view its details."
               FontSize="12"
               Foreground="{DynamicResource MutedBrush}"
               Margin="0,6,0,0"
               HorizontalAlignment="Center"/>
                        </StackPanel>

                        <!-- Snapshot details -->
                        <ScrollViewer VerticalScrollBarVisibility="Auto"
                      HorizontalScrollBarVisibility="Disabled">

                            <ScrollViewer.Style>
                                <Style TargetType="ScrollViewer">
                                    <Setter Property="Visibility"
                            Value="Visible"/>

                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding SelectedItem}"
                                     Value="{x:Null}">
                                            <Setter Property="Visibility"
                                    Value="Collapsed"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </ScrollViewer.Style>

                            <StackPanel>

                                <TextBlock Text="Snapshot"
                           FontSize="18"
                           FontWeight="SemiBold"
                           Foreground="{DynamicResource TextBrush}"
                           Margin="0,0,0,20"/>

                                <!-- Title -->
                                <TextBlock Text="Title"
                           Foreground="{DynamicResource MutedBrush}"
                           Margin="0,0,0,5"/>

                                <TextBlock Text="{Binding SelectedSnapshot.Title}"
                           Foreground="{DynamicResource TextBrush}"
                           TextWrapping="Wrap"
                           Margin="0,0,0,16"/>

                                <!-- Created -->
                                <TextBlock Text="Created"
                           Foreground="{DynamicResource MutedBrush}"
                           Margin="0,0,0,5"/>

                                <TextBlock Text="{Binding SelectedSnapshot.CreatedAt,
                                          StringFormat={}{0:yyyy-MM-dd HH:mm:ss}}"
                           Foreground="{DynamicResource TextBrush}"
                           Margin="0,0,0,16"/>

                                <!-- Username -->
                                <TextBlock Text="Username"
                           Foreground="{DynamicResource MutedBrush}"
                           Margin="0,0,0,5"/>

                                <TextBlock Text="{Binding SelectedSnapshot.Username}"
                           Foreground="{DynamicResource TextBrush}"
                           TextWrapping="Wrap"
                           Margin="0,0,0,16"/>

                                <!-- Password -->
                                <TextBlock Text="Password"
                           Foreground="{DynamicResource MutedBrush}"
                           Margin="0,0,0,5"/>

                                <TextBlock Text="••••••••"
                           FontFamily="Consolas"
                           Foreground="{DynamicResource TextBrush}"
                           Margin="0,0,0,16"/>

                                <!-- URL -->
                                <TextBlock Text="URL"
                           Foreground="{DynamicResource MutedBrush}"
                           Margin="0,0,0,5"/>

                                <TextBlock Text="{Binding SelectedSnapshot.Url}"
                           Foreground="{DynamicResource TextBrush}"
                           TextWrapping="Wrap"
                           Margin="0,0,0,16"/>

                                <!-- TOTP -->
                                <TextBlock Text="TOTP"
                           Foreground="{DynamicResource MutedBrush}"
                           Margin="0,0,0,5"/>

                                <TextBlock Text="••••••••"
                           FontFamily="Consolas"
                           Foreground="{DynamicResource TextBrush}"
                           Margin="0,0,0,16"/>

                                <!-- Notes -->
                                <TextBlock Text="Notes"
                           Foreground="{DynamicResource MutedBrush}"
                           Margin="0,0,0,5"/>

                                <TextBlock Text="{Binding SelectedSnapshot.Notes}"
                           Foreground="{DynamicResource TextBrush}"
                           TextWrapping="Wrap"
                           Margin="0,0,0,16"/>

                                <!-- Tags -->
                                <TextBlock Text="Tags"
                           Foreground="{DynamicResource MutedBrush}"
                           Margin="0,0,0,5"/>

                                <ItemsControl ItemsSource="{Binding SelectedSnapshot.Tags}"
                              Margin="0,0,0,16">

                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Border Background="{DynamicResource SurfaceAltBrush}"
                                    CornerRadius="5"
                                    Padding="8,4"
                                    Margin="0,0,5,5"
                                    HorizontalAlignment="Left">

                                                <TextBlock Text="{Binding}"
                                           FontSize="12"
                                           Foreground="{DynamicResource TextBrush}"/>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>

                                </ItemsControl>

                                <!-- Custom Fields -->
                                <TextBlock Text="Custom Fields"
                           Foreground="{DynamicResource MutedBrush}"
                           Margin="0,0,0,8"/>

                                <ItemsControl ItemsSource="{Binding SelectedSnapshot.CustomFields}"
                              Margin="0,0,0,16">

                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Grid Margin="0,0,0,8">

                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="120"/>
                                                    <ColumnDefinition Width="*"/>
                                                </Grid.ColumnDefinitions>

                                                <TextBlock Grid.Column="0"
                                           Text="{Binding Name}"
                                           FontWeight="SemiBold"
                                           Foreground="{DynamicResource TextBrush}"
                                           TextTrimming="CharacterEllipsis"/>

                                                <TextBlock Grid.Column="1"
                                           TextWrapping="Wrap"
                                           Foreground="{DynamicResource TextBrush}">

                                                    <TextBlock.Style>
                                                        <Style TargetType="TextBlock">
                                                            <Setter Property="Text"
                                                    Value="{Binding Value}"/>

                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding IsSecret}"
                                                             Value="True">
                                                                    <Setter Property="Text"
                                                            Value="••••••••"/>
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </TextBlock.Style>

                                                </TextBlock>

                                            </Grid>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>

                                </ItemsControl>

                                <!-- Changed -->
                                <TextBlock Text="Changed"
                           Foreground="{DynamicResource MutedBrush}"
                           Margin="0,0,0,5"/>

                                <TextBlock Text="{Binding SelectedSnapshot.ChangedAt,
                                          StringFormat={}{0:yyyy-MM-dd HH:mm:ss}}"
                           Foreground="{DynamicResource TextBrush}"/>

                            </StackPanel>

                        </ScrollViewer>

                    </Grid>
                </Border>
            </Grid>

            <!-- Footer -->
            <Grid Grid.Row="2"
                  Margin="0,16,0,0">

                <TextBlock Text="{Binding Items.Count,
                                          StringFormat={}{0} history snapshots}"
                           Foreground="{DynamicResource MutedBrush}"
                           VerticalAlignment="Center"/>

                <Button Content="Restore"
                        Command="{Binding RestoreCommand}"
                        HorizontalAlignment="Right"
                        IsDefault="True"/>
            </Grid>

        </Grid>
    </DockPanel>
</Window>
