<Window x:Class="PejPass.Wpf.Views.HistoryWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="clr-namespace:PejPass.Wpf.Controls"
        Title="History"
        Width="1100"
        Height="700"
        MinWidth="900"
        MinHeight="560"
        WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False"
        Background="{DynamicResource BgBrush}">
    <DockPanel>
        <controls:AppTitleBar DockPanel.Dock="Top"
                              ShowMinimize="false"
                              ShowMaximize="true"/>
        <Grid Margin="24">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- Header & Instruction (Perfect Horizontal Alignment) -->
            <Grid Grid.Row="0"
                  Margin="0,0,0,16">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="42*"/>
                    <ColumnDefinition Width="58*"/>
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- Title -->
                <TextBlock Grid.Row="0"
                           Grid.Column="0"
                           Text="Entry History"
                           FontSize="22"
                           FontWeight="Bold"
                           Foreground="{DynamicResource TextBrush}"
                           Margin="0,0,0,4"/>

                <!-- Subtitle -->
                <TextBlock Grid.Row="1"
                           Grid.Column="0"
                           Text="Compare previous versions and restore selected fields"
                           FontSize="12"
                           Foreground="{DynamicResource MutedBrush}"/>

                <!-- Instruction (Horizontally aligned with the subtitle) -->
                <TextBlock Grid.Row="1"
                           Grid.Column="1"
                           Text="Select the changed fields you want to restore. Fields without changes cannot be selected."
                           FontSize="12"
                           Foreground="{DynamicResource MutedBrush}"
                           TextWrapping="Wrap"
                           Margin="12,0,0,0"/>
            </Grid>

            <!-- Main content -->
            <Grid Grid.Row="1">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="42*"/>
                    <ColumnDefinition Width="58*"/>
                </Grid.ColumnDefinitions>

                <!-- History list -->
                <ListBox Grid.Column="0"
                         ItemsSource="{Binding Items}"
                         SelectedItem="{Binding SelectedItem}"
                         Background="Transparent"
                         BorderThickness="0"
                         ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                         ScrollViewer.VerticalScrollBarVisibility="Auto">
                    <ListBox.Resources>
                        <Style TargetType="TextBlock"
                               x:Key="EmptyHistoryTextStyle">
                            <Setter Property="Foreground"
                                    Value="{DynamicResource MutedBrush}"/>

                            <Setter Property="FontSize"
                                    Value="13"/>

                            <Setter Property="HorizontalAlignment"
                                    Value="Center"/>

                            <Setter Property="TextAlignment"
                                    Value="Center"/>
                        </Style>
                    </ListBox.Resources>

                    <ListBox.Style>
                        <Style TargetType="ListBox">
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="ListBox">
                                        <Grid>
                                            <ScrollViewer VerticalScrollBarVisibility="Auto"
                                                          HorizontalScrollBarVisibility="Disabled">
                                                <ItemsPresenter/>
                                            </ScrollViewer>

                                            <StackPanel HorizontalAlignment="Center"
                                                        VerticalAlignment="Center">
                                                <StackPanel.Style>
                                                    <Style TargetType="StackPanel">
                                                        <Setter Property="Visibility"
                                                                Value="Collapsed"/>
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding Items.Count}"
                                                                         Value="0">
                                                                <Setter Property="Visibility"
                                                                        Value="Visible"/>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </StackPanel.Style>

                                                <TextBlock Text="No history snapshots"
                                                           FontSize="16"
                                                           FontWeight="SemiBold"
                                                           Foreground="{DynamicResource TextBrush}"
                                                           HorizontalAlignment="Center"/>

                                                <TextBlock Text="Changes made to entries will appear here."
                                                           Margin="0,8,0,0"
                                                           Style="{StaticResource EmptyHistoryTextStyle}"/>
                                            </StackPanel>
                                        </Grid>
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                        </Style>
                    </ListBox.Style>
                    <ListBox.ItemContainerStyle>
                        <Style TargetType="ListBoxItem">
                            <EventSetter Event="PreviewMouseLeftButtonDown"
                                         Handler="HistoryListBoxItem_PreviewMouseLeftButtonDown"/>
                            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                            <Setter Property="Padding" Value="0"/>
                            <Setter Property="Margin" Value="0,0,12,6"/>
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="ListBoxItem">
                                        <Border x:Name="ItemBorder"
                                                Background="{DynamicResource SurfaceBrush}"
                                                CornerRadius="8"
                                                Padding="14,12">
                                            <ContentPresenter/>
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsSelected" Value="True">
                                                <Setter TargetName="ItemBorder" Property="Background" Value="{DynamicResource SurfaceAltBrush}"/>
                                                <Setter TargetName="ItemBorder" Property="BorderBrush" Value="{DynamicResource AccentBrush}"/>
                                                <Setter TargetName="ItemBorder" Property="BorderThickness" Value="1"/>
                                            </Trigger>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter TargetName="ItemBorder" Property="Background" Value="{DynamicResource SurfaceAltBrush}"/>
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                        </Style>
                    </ListBox.ItemContainerStyle>
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="24"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>

                                <!-- Timeline -->
                                <Grid Grid.Column="0">
                                    <Border Width="1"
                                            HorizontalAlignment="Center"
                                            VerticalAlignment="Stretch"
                                            Background="{DynamicResource BorderBrush}"
                                            Margin="0,14,0,0"/>
                                    <Ellipse Width="9"
                                             Height="9"
                                             HorizontalAlignment="Center"
                                             VerticalAlignment="Top"
                                             Margin="0,7,0,0"
                                             Fill="{DynamicResource AccentBrush}"/>
                                </Grid>

                                <!-- Event card -->
                                <Border Grid.Column="1"
                                        Background="{DynamicResource SurfaceBrush}"
                                        CornerRadius="8"
                                        Padding="14,12"
                                        Margin="8,0,0,6">
                                    <Expander IsExpanded="{Binding IsExpanded, Mode=TwoWay}"
                                              BorderThickness="0">
                                        <Expander.Header>
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                </Grid.ColumnDefinitions>

                                                <StackPanel>
                                                    <TextBlock Text="{Binding Title}"
                                                               FontWeight="SemiBold"
                                                               Foreground="{DynamicResource TextBrush}"
                                                               TextTrimming="CharacterEllipsis"/>
                                                    <TextBlock Text="{Binding ChangedAtText}"
                                                               FontSize="11"
                                                               Foreground="{DynamicResource MutedBrush}"
                                                               Margin="0,3,0,0"/>
                                                    <TextBlock Text="{Binding ChangeSummary}"
                                                               FontSize="12"
                                                               Foreground="{DynamicResource MutedBrush}"
                                                               Margin="0,5,0,0"/>
                                                </StackPanel>

                                                <TextBlock Grid.Column="1"
                                                           Text="{Binding Username}"
                                                           FontSize="11"
                                                           Foreground="{DynamicResource MutedBrush}"
                                                           VerticalAlignment="Center"
                                                           Margin="12,0,0,0"
                                                           TextTrimming="CharacterEllipsis"/>
                                            </Grid>
                                        </Expander.Header>

                                        <Border Margin="0,12,0,0"
                                                Padding="10,10,10,2"
                                                Background="{DynamicResource SurfaceAltBrush}"
                                                CornerRadius="6">
                                            <StackPanel>
                                                <TextBlock Text="Changed fields"
                                                           FontSize="11"
                                                           FontWeight="SemiBold"
                                                           Foreground="{DynamicResource MutedBrush}"
                                                           Margin="0,0,0,8"/>

                                                <ItemsControl ItemsSource="{Binding ChangedFields}">
                                                    <ItemsControl.ItemsPanel>
                                                        <ItemsPanelTemplate>
                                                            <WrapPanel/>
                                                        </ItemsPanelTemplate>
                                                    </ItemsControl.ItemsPanel>
                                                    <ItemsControl.ItemTemplate>
                                                        <DataTemplate>
                                                            <Border Background="{DynamicResource SurfaceBrush}"
                                                                    CornerRadius="4"
                                                                    Padding="8,4"
                                                                    Margin="0,0,6,6">
                                                                <TextBlock Text="{Binding}"
                                                                           FontSize="11"
                                                                           Foreground="{DynamicResource TextBrush}"/>
                                                            </Border>
                                                        </DataTemplate>
                                                    </ItemsControl.ItemTemplate>
                                                </ItemsControl>

                                                <TextBlock Text="No field changes detected."
                                                           FontSize="11"
                                                           Foreground="{DynamicResource MutedBrush}"
                                                           Margin="0,0,0,8">
                                                    <TextBlock.Style>
                                                        <Style TargetType="TextBlock">
                                                            <Setter Property="Visibility" Value="Collapsed"/>
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding ChangedFields.Count}"
                                                                             Value="0">
                                                                    <Setter Property="Visibility" Value="Visible"/>
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </TextBlock.Style>
                                                </TextBlock>
                                            </StackPanel>
                                        </Border>
                                    </Expander>
                                </Border>
                            </Grid>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>

                <!-- Comparison panel -->
                <Border Grid.Column="1"
                        Background="{DynamicResource SurfaceBrush}"
                        CornerRadius="8"
                        Margin="20,0,0,0"
                        Padding="20">
                    <Grid>
                        <!-- Empty state -->
                        <StackPanel HorizontalAlignment="Center"
                                    VerticalAlignment="Center">
                            <StackPanel.Style>
                                <Style TargetType="StackPanel">
                                    <Setter Property="Visibility" Value="Collapsed"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding SelectedItem}" Value="{x:Null}">
                                            <Setter Property="Visibility" Value="Visible"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </StackPanel.Style>
                            <TextBlock Text="No snapshot selected"
                                       FontSize="18"
                                       FontWeight="SemiBold"
                                       Foreground="{DynamicResource TextBrush}"
                                       HorizontalAlignment="Center"/>
                            <TextBlock Text="Select a history snapshot from the left to compare it with the current entry."
                                       FontSize="12"
                                       Foreground="{DynamicResource MutedBrush}"
                                       Margin="0,8,0,0"
                                       TextWrapping="Wrap"
                                       TextAlignment="Center"
                                       HorizontalAlignment="Center"/>
                        </StackPanel>

                        <!-- Comparison content -->
                        <Grid>
                            <Grid.Style>
                                <Style TargetType="Grid">
                                    <Setter Property="Visibility" Value="Visible"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding SelectedItem}" Value="{x:Null}">
                                            <Setter Property="Visibility" Value="Collapsed"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Grid.Style>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>

                            <!-- Column header -->
                            <Grid Grid.Row="0"
                                  Margin="0,0,0,8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="34"/>
                                    <ColumnDefinition Width="120"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="1"
                                           Text="Field"
                                           FontWeight="SemiBold"
                                           Foreground="{DynamicResource MutedBrush}"/>
                                <TextBlock Grid.Column="2"
                                           Text="Current"
                                           FontWeight="SemiBold"
                                           Foreground="{DynamicResource MutedBrush}"/>
                                <TextBlock Grid.Column="3"
                                           Text="Snapshot"
                                           FontWeight="SemiBold"
                                           Foreground="{DynamicResource MutedBrush}"/>
                            </Grid>

                            <!-- Fields -->
                            <ScrollViewer Grid.Row="1"
                                          VerticalScrollBarVisibility="Auto"
                                          HorizontalScrollBarVisibility="Disabled">
                                <ItemsControl ItemsSource="{Binding Fields}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Border Padding="0,10"
                                                    BorderBrush="{DynamicResource BorderBrush}"
                                                    BorderThickness="0,0,0,1">
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="34"/>
                                                        <ColumnDefinition Width="120"/>
                                                        <ColumnDefinition Width="*"/>
                                                        <ColumnDefinition Width="*"/>
                                                    </Grid.ColumnDefinitions>

                                                    <!-- Select only changed fields -->
                                                    <CheckBox Grid.Column="0"
                                                              IsChecked="{Binding IsSelected, Mode=TwoWay}"
                                                              VerticalAlignment="Center">
                                                        <CheckBox.Style>
                                                            <Style TargetType="CheckBox">
                                                                <Setter Property="Visibility" Value="Collapsed"/>
                                                                <Style.Triggers>
                                                                    <DataTrigger Binding="{Binding IsChanged}" Value="True">
                                                                        <Setter Property="Visibility" Value="Visible"/>
                                                                    </DataTrigger>
                                                                </Style.Triggers>
                                                            </Style>
                                                        </CheckBox.Style>
                                                    </CheckBox>

                                                    <!-- Field name -->
                                                    <Grid Grid.Column="1"
                                                          VerticalAlignment="Center">
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="*"/>
                                                            <ColumnDefinition Width="Auto"/>
                                                        </Grid.ColumnDefinitions>
                                                        <TextBlock Text="{Binding Name}"
                                                                   FontWeight="SemiBold"
                                                                   Foreground="{DynamicResource TextBrush}"
                                                                   VerticalAlignment="Center"
                                                                   Margin="0,0,6,0"
                                                                   TextTrimming="CharacterEllipsis"/>
                                                        <Button Grid.Column="1"
                                                                Content="&#xE890;"
                                                                Command="{Binding ToggleSecretVisibilityCommand}"
                                                                Width="24"
                                                                Height="24"
                                                                Padding="0"
                                                                FontFamily="Segoe MDL2 Assets"
                                                                FontSize="13"
                                                                Foreground="{DynamicResource AccentBrush}"
                                                                Background="Transparent"
                                                                BorderThickness="0"
                                                                Cursor="Hand"
                                                                VerticalAlignment="Center">
                                                            <Button.Style>
                                                                <Style TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
                                                                    <Setter Property="Visibility" Value="Collapsed"/>
                                                                    <Setter Property="ToolTip" Value="Show or hide secret"/>
                                                                    <Style.Triggers>
                                                                        <DataTrigger Binding="{Binding IsSecret}" Value="True">
                                                                            <Setter Property="Visibility" Value="Visible"/>
                                                                        </DataTrigger>
                                                                    </Style.Triggers>
                                                                </Style>
                                                            </Button.Style>
                                                        </Button>
                                                    </Grid>

                                                    <!-- Current -->
                                                    <TextBlock Grid.Column="2"
                                                               Text="{Binding CurrentDisplayValue}"
                                                               Foreground="{DynamicResource TextBrush}"
                                                               TextWrapping="Wrap"
                                                               VerticalAlignment="Center"
                                                               Margin="0,0,8,0"/>

                                                    <!-- Snapshot -->
                                                    <TextBlock Grid.Column="3"
                                                               Text="{Binding SnapshotDisplayValue}"
                                                               Foreground="{DynamicResource TextBrush}"
                                                               TextWrapping="Wrap"
                                                               VerticalAlignment="Center"
                                                               Margin="0,0,8,0"/>
                                                </Grid>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </ScrollViewer>
                        </Grid>
                    </Grid>
                </Border>
            </Grid>

            <!-- Footer -->
            <Grid Grid.Row="2"
                  Margin="0,16,0,0">
                <TextBlock Text="{Binding Items.Count, StringFormat={}{0} history snapshots}"
                           Foreground="{DynamicResource MutedBrush}"
                           VerticalAlignment="Center"/>
                <StackPanel Orientation="Horizontal"
                            HorizontalAlignment="Right">
                    <Button Content="Delete"
                            Command="{Binding DeleteHistoryCommand}"
                            Margin="0,0,8,0"
                            IsEnabled="{Binding HasSelectedItem}"/>

                    <Button Content="Delete All"
                            Command="{Binding DeleteAllHistoryCommand}"
                            Margin="0,0,8,0"
                            IsEnabled="{Binding HasHistoryItems}"/>
                    
                    <Button Content="Restore"
                            Command="{Binding RestoreCommand}"
                            IsEnabled="{Binding HasSelectedFields}"
                            IsDefault="True"/>
                </StackPanel>
            </Grid>
        </Grid>
    </DockPanel>
</Window>
