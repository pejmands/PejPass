<Window x:Class="PejPass.Wpf.Views.HistoryWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="clr-namespace:PejPass.Wpf.Controls"
        Title="History"
        Width="1100"
        Height="700"
        MinWidth="900"
        MinHeight="560"
        WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False"
        Background="{DynamicResource BgBrush}">
    <DockPanel>
        <controls:AppTitleBar DockPanel.Dock="Top"
                              ShowMinimize="false"
                              ShowMaximize="true"/>
        <Grid Margin="24">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- Header & Instruction (Perfect Horizontal Alignment) -->
            <Grid Grid.Row="0"
                  Margin="0,0,0,16">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="42*"/>
                    <ColumnDefinition Width="58*"/>
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- Title -->
                <TextBlock Grid.Row="0"
                           Grid.Column="0"
                           Text="Entry History"
                           FontSize="22"
                           FontWeight="Bold"
                           Foreground="{DynamicResource TextBrush}"
                           Margin="0,0,0,4"/>

                <!-- Subtitle -->
                <TextBlock Grid.Row="1"
                           Grid.Column="0"
                           Text="Compare previous versions and restore selected fields"
                           FontSize="12"
                           Foreground="{DynamicResource MutedBrush}"/>

                <!-- Instruction (Horizontally aligned with the subtitle) -->
                <TextBlock Grid.Row="1"
                           Grid.Column="1"
                           Text="Select the changed fields you want to restore. Fields without changes cannot be selected."
                           FontSize="12"
                           Foreground="{DynamicResource MutedBrush}"
                           TextWrapping="Wrap"
                           Margin="12,0,0,0"/>
            </Grid>

            <!-- Main content -->
            <Grid Grid.Row="1">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="42*"/>
                    <ColumnDefinition Width="58*"/>
                </Grid.ColumnDefinitions>

                <!-- History list -->
                <ListBox Grid.Column="0"
                         ItemsSource="{Binding Items}"
                         SelectedItem="{Binding SelectedItem}"
                         Background="Transparent"
                         BorderThickness="0"
                         ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                         ScrollViewer.VerticalScrollBarVisibility="Auto">
                    <ListBox.ItemContainerStyle>
                        <Style TargetType="ListBoxItem">
                            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                            <Setter Property="Padding" Value="0"/>
                            <Setter Property="Margin" Value="0,0,12,6"/>
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="ListBoxItem">
                                        <Border x:Name="ItemBorder"
                                                Background="{DynamicResource SurfaceBrush}"
                                                CornerRadius="8"
                                                Padding="14,12">
                                            <ContentPresenter/>
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsSelected" Value="True">
                                                <Setter TargetName="ItemBorder" Property="Background" Value="{DynamicResource SurfaceAltBrush}"/>
                                                <Setter TargetName="ItemBorder" Property="BorderBrush" Value="{DynamicResource AccentBrush}"/>
                                                <Setter TargetName="ItemBorder" Property="BorderThickness" Value="1"/>
                                            </Trigger>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter TargetName="ItemBorder" Property="Background" Value="{DynamicResource SurfaceAltBrush}"/>
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                        </Style>
                    </ListBox.ItemContainerStyle>
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel>
                                    <TextBlock Text="{Binding Title}"
                                               FontWeight="SemiBold"
                                               Foreground="{DynamicResource TextBrush}"
                                               TextTrimming="CharacterEllipsis"/>
                                    <TextBlock Text="{Binding Username}"
                                               FontSize="12"
                                               Foreground="{DynamicResource MutedBrush}"
                                               Margin="0,3,0,0"
                                               TextTrimming="CharacterEllipsis"/>
                                </StackPanel>
                                <TextBlock Grid.Column="1"
                                           Text="{Binding ChangedAtText}"
                                           FontSize="11"
                                           Foreground="{DynamicResource MutedBrush}"
                                           VerticalAlignment="Center"
                                           Margin="12,0,0,0"/>
                            </Grid>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>

                <!-- Comparison panel -->
                <Border Grid.Column="1"
                        Background="{DynamicResource SurfaceBrush}"
                        CornerRadius="8"
                        Margin="20,0,0,0"
                        Padding="20">
                    <Grid>
                        <!-- Empty state -->
                        <StackPanel HorizontalAlignment="Center"
                                    VerticalAlignment="Center">
                            <StackPanel.Style>
                                <Style TargetType="StackPanel">
                                    <Setter Property="Visibility" Value="Collapsed"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding SelectedItem}" Value="{x:Null}">
                                            <Setter Property="Visibility" Value="Visible"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </StackPanel.Style>
                            <TextBlock Text="No snapshot selected"
                                       FontSize="18"
                                       FontWeight="SemiBold"
                                       Foreground="{DynamicResource TextBrush}"
                                       HorizontalAlignment="Center"/>
                            <TextBlock Text="Select a history snapshot from the left to compare it with the current entry."
                                       FontSize="12"
                                       Foreground="{DynamicResource MutedBrush}"
                                       Margin="0,8,0,0"
                                       TextWrapping="Wrap"
                                       TextAlignment="Center"
                                       HorizontalAlignment="Center"/>
                        </StackPanel>

                        <!-- Comparison content -->
                        <Grid>
                            <Grid.Style>
                                <Style TargetType="Grid">
                                    <Setter Property="Visibility" Value="Visible"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding SelectedItem}" Value="{x:Null}">
                                            <Setter Property="Visibility" Value="Collapsed"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Grid.Style>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>

                            <!-- Column header -->
                            <Grid Grid.Row="0"
                                  Margin="0,0,0,8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="34"/>
                                    <ColumnDefinition Width="120"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="1"
                                           Text="Field"
                                           FontWeight="SemiBold"
                                           Foreground="{DynamicResource MutedBrush}"/>
                                <TextBlock Grid.Column="2"
                                           Text="Current"
                                           FontWeight="SemiBold"
                                           Foreground="{DynamicResource MutedBrush}"/>
                                <TextBlock Grid.Column="3"
                                           Text="Snapshot"
                                           FontWeight="SemiBold"
                                           Foreground="{DynamicResource MutedBrush}"/>
                            </Grid>

                            <!-- Fields -->
                            <ScrollViewer Grid.Row="1"
                                          VerticalScrollBarVisibility="Auto"
                                          HorizontalScrollBarVisibility="Disabled">
                                <ItemsControl ItemsSource="{Binding Fields}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Border Padding="0,10"
                                                    BorderBrush="{DynamicResource BorderBrush}"
                                                    BorderThickness="0,0,0,1">
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="34"/>
                                                        <ColumnDefinition Width="120"/>
                                                        <ColumnDefinition Width="*"/>
                                                        <ColumnDefinition Width="*"/>
                                                    </Grid.ColumnDefinitions>

                                                    <!-- Select only changed fields -->
                                                    <CheckBox Grid.Column="0"
                                                              IsChecked="{Binding IsSelected, Mode=TwoWay}"
                                                              VerticalAlignment="Top">
                                                        <CheckBox.Style>
                                                            <Style TargetType="CheckBox">
                                                                <Setter Property="Visibility" Value="Collapsed"/>
                                                                <Style.Triggers>
                                                                    <DataTrigger Binding="{Binding IsChanged}" Value="True">
                                                                        <Setter Property="Visibility" Value="Visible"/>
                                                                    </DataTrigger>
                                                                </Style.Triggers>
                                                            </Style>
                                                        </CheckBox.Style>
                                                    </CheckBox>

                                                    <!-- Field name -->
                                                    <TextBlock Grid.Column="1"
                                                               Text="{Binding Name}"
                                                               FontWeight="SemiBold"
                                                               Foreground="{DynamicResource TextBrush}"
                                                               VerticalAlignment="Top"
                                                               Margin="0,0,12,0"/>

                                                    <!-- Current -->
                                                    <TextBlock Grid.Column="2"
                                                               Text="{Binding CurrentValue}"
                                                               Foreground="{DynamicResource TextBrush}"
                                                               TextWrapping="Wrap"
                                                               VerticalAlignment="Top"
                                                               Margin="0,0,12,0"/>

                                                    <!-- Snapshot -->
                                                    <TextBlock Grid.Column="3"
                                                               Text="{Binding SnapshotValue}"
                                                               Foreground="{DynamicResource TextBrush}"
                                                               TextWrapping="Wrap"
                                                               VerticalAlignment="Top"/>
                                                </Grid>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </ScrollViewer>
                        </Grid>
                    </Grid>
                </Border>
            </Grid>

            <!-- Footer -->
            <Grid Grid.Row="2"
                  Margin="0,16,0,0">
                <TextBlock Text="{Binding Items.Count, StringFormat={}{0} history snapshots}"
                           Foreground="{DynamicResource MutedBrush}"
                           VerticalAlignment="Center"/>
                <Button Content="Restore"
                        Command="{Binding RestoreCommand}"
                        IsEnabled="{Binding HasSelectedFields}"
                        HorizontalAlignment="Right"
                        IsDefault="True"/>
            </Grid>
        </Grid>
    </DockPanel>
</Window>
