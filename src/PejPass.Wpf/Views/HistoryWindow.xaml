<Window x:Class="PejPass.Wpf.Views.HistoryWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="History"
        Width="1100"
        Height="650"
        MinWidth="900"
        MinHeight="500"
        ShowInTaskbar="False"
        WindowStartupLocation="CenterOwner">

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0"
                   Text="Entry History"
                   FontSize="20"
                   FontWeight="SemiBold"
                   Margin="0,0,0,16"/>

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="2*"/>
                <ColumnDefinition Width="3*"/>
            </Grid.ColumnDefinitions>

            <ListView Grid.Column="0"
                      ItemsSource="{Binding Items}"
                      SelectedItem="{Binding SelectedItem}"
                      BorderThickness="0"
                      Margin="0,0,16,0">

                <ListView.View>
                    <GridView>
                        <GridViewColumn Header="Title"
                                        DisplayMemberBinding="{Binding Title}"
                                        Width="180"/>

                        <GridViewColumn Header="Username"
                                        DisplayMemberBinding="{Binding Username}"
                                        Width="150"/>

                        <GridViewColumn Header="Changed"
                                        DisplayMemberBinding="{Binding ChangedAtText}"
                                        Width="130"/>
                    </GridView>
                </ListView.View>
            </ListView>

            <Border Grid.Column="1"
                    Background="{DynamicResource SurfaceAltBrush}"
                    CornerRadius="8"
                    Padding="20">

                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel>

                        <TextBlock Text="Snapshot"
                                   FontSize="18"
                                   FontWeight="SemiBold"
                                   Margin="0,0,0,20"/>

                        <TextBlock Text="Title"
                                   FontWeight="SemiBold"/>

                        <TextBlock Text="{Binding SelectedSnapshot.Title}"
                                   Margin="0,4,0,16"
                                   TextWrapping="Wrap"/>

                        <TextBlock Text="Favorite"
                                   FontWeight="SemiBold"/>

                        <TextBlock Text="{Binding SelectedSnapshot.IsFavorite}"
                                   Margin="0,4,0,16"/>

                        <TextBlock Text="Created"
                                   FontWeight="SemiBold"/>

                        <TextBlock Text="{Binding SelectedSnapshot.CreatedAt,
                                   StringFormat={}{0:yyyy-MM-dd HH:mm:ss}}"
                                   Margin="0,4,0,16"/>
                        
                        <TextBlock Text="Username"
                                   FontWeight="SemiBold"/>

                        <TextBlock Text="{Binding SelectedSnapshot.Username}"
                                   Margin="0,4,0,16"
                                   TextWrapping="Wrap"/>

                        <TextBlock Text="Password"
                                   FontWeight="SemiBold"/>

                        <TextBlock Text="••••••••"
                                   Margin="0,4,0,16"/>

                        <TextBlock Text="URL"
                                   FontWeight="SemiBold"/>

                        <TextBlock Text="{Binding SelectedSnapshot.Url}"
                                   Margin="0,4,0,16"
                                   TextWrapping="Wrap"/>

                        <TextBlock Text="TOTP"
                                   FontWeight="SemiBold"/>

                        <TextBlock Text="••••••••"
                                   Margin="0,4,0,16"/>

                        <TextBlock Text="Notes"
                                   FontWeight="SemiBold"/>

                        <TextBlock Text="{Binding SelectedSnapshot.Notes}"
                                   Margin="0,4,0,16"
                                   TextWrapping="Wrap"/>

                        <TextBlock Text="Tags"
                                   FontWeight="SemiBold"/>

                        <ItemsControl ItemsSource="{Binding SelectedSnapshot.Tags}"
                                      Margin="0,4,0,16">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding}"
                                               Margin="0,0,0,4"/>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>

                        <TextBlock Text="Custom Fields"
                                   FontWeight="SemiBold"/>

                        <ItemsControl ItemsSource="{Binding SelectedSnapshot.CustomFields}"
                                      Margin="0,4,0,16">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Grid Margin="0,0,0,8">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="120"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>

                                        <TextBlock Grid.Column="0"
                                                   Text="{Binding Name}"
                                                   FontWeight="SemiBold"/>

                                        <TextBlock Grid.Column="1"
                                                   TextWrapping="Wrap">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock">
                                                    <Setter Property="Text"
                                                            Value="{Binding Value}"/>

                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding IsSecret}"
                                                                     Value="True">
                                                            <Setter Property="Text"
                                                                    Value="••••••••"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>
                                    </Grid>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>

                        <TextBlock Text="Changed"
                                   FontWeight="SemiBold"/>

                        <TextBlock Text="{Binding SelectedSnapshot.ChangedAt,
                                                  StringFormat={}{0:yyyy-MM-dd HH:mm:ss}}"
                                   Margin="0,4,0,0"/>

                    </StackPanel>
                </ScrollViewer>
            </Border>
        </Grid>

        <StackPanel Grid.Row="2"
                    Orientation="Horizontal"
                    HorizontalAlignment="Right"
                    Margin="0,16,0,0">

            <Button Content="Restore"
                    Command="{Binding RestoreCommand}"
                    Padding="20,8"/>
        </StackPanel>
    </Grid>
</Window>
