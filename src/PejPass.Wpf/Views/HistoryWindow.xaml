<Window
	x:Class="PejPass.Wpf.Views.HistoryWindow"
	xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
	xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
	xmlns:controls="clr-namespace:PejPass.Wpf.Controls"
	Title="History"
	Width="980"
	Height="620"
	MinWidth="820"
	MinHeight="520"
	Background="{DynamicResource BgBrush}"
	ResizeMode="CanResize"
	ShowInTaskbar="False"
	WindowStartupLocation="CenterOwner">
	<Grid>
		<Grid.RowDefinitions>
			<RowDefinition Height="Auto" />
			<RowDefinition Height="*" />
		</Grid.RowDefinitions>

		<controls:AppTitleBar
			Grid.Row="0"
			ShowMaximize="true"
			ShowMinimize="false" />

		<Grid Grid.Row="1" Margin="16">
			<Grid.RowDefinitions>
				<RowDefinition Height="Auto" />
				<RowDefinition Height="Auto" />
				<RowDefinition Height="*" />
				<RowDefinition Height="Auto" />
			</Grid.RowDefinitions>

			<controls:SearchBox
				Grid.Row="0"
				Margin="0,0,0,12"
				Placeholder="Search history..."
				Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"
				ToolTip="Search history by title, username, or URL" />

			<!--  Header & Instruction  -->
			<Grid Grid.Row="1" Margin="0,0,0,16">
				<Grid.ColumnDefinitions>
					<ColumnDefinition Width="2*" />
					<ColumnDefinition Width="3*" />
				</Grid.ColumnDefinitions>
				<Grid.RowDefinitions>
					<RowDefinition Height="Auto" />
					<RowDefinition Height="Auto" />
				</Grid.RowDefinitions>

				<TextBlock
					Grid.Row="0"
					Grid.Column="0"
					Margin="0,0,0,4"
					FontSize="{DynamicResource AppFontSize22}"
					FontWeight="Bold"
					Foreground="{DynamicResource TextBrush}"
					Text="Entry History" />

				<TextBlock
					Grid.Row="1"
					Grid.Column="0"
					FontSize="{DynamicResource AppFontSize12}"
					Foreground="{DynamicResource MutedBrush}"
					Text="Compare previous versions and restore selected fields" />

				<TextBlock
					Grid.Row="1"
					Grid.Column="1"
					Margin="12,0,0,0"
					FontSize="{DynamicResource AppFontSize12}"
					Foreground="{DynamicResource MutedBrush}"
					Text="Select the changed fields you want to restore. Fields without changes cannot be selected."
					TextWrapping="Wrap" />
			</Grid>

			<!--  Main content  -->
			<Grid Grid.Row="2">
				<Grid.ColumnDefinitions>
					<ColumnDefinition Width="2*" />
					<ColumnDefinition Width="3*" />
				</Grid.ColumnDefinitions>

				<!--  History list  -->
				<ListBox
					Grid.Column="0"
					Background="Transparent"
					BorderThickness="0"
					ItemsSource="{Binding FilteredItems}"
					ScrollViewer.HorizontalScrollBarVisibility="Disabled"
					ScrollViewer.VerticalScrollBarVisibility="Auto"
					SelectedItem="{Binding SelectedItem}">
					<ListBox.Resources>
						<Style x:Key="EmptyHistoryTextStyle" TargetType="TextBlock">
							<Setter Property="Foreground" Value="{DynamicResource MutedBrush}" />
							<Setter Property="FontSize" Value="{DynamicResource AppFontSize13}" />
							<Setter Property="HorizontalAlignment" Value="Center" />
							<Setter Property="TextAlignment" Value="Center" />
						</Style>
					</ListBox.Resources>

					<ListBox.Style>
						<Style TargetType="ListBox">
							<Setter Property="Template">
								<Setter.Value>
									<ControlTemplate TargetType="ListBox">
										<Grid>
											<ScrollViewer HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
												<ItemsPresenter />
											</ScrollViewer>

											<StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
												<StackPanel.Style>
													<Style TargetType="StackPanel">
														<Setter Property="Visibility" Value="Collapsed" />
														<Style.Triggers>
															<DataTrigger Binding="{Binding HasHistoryItems}" Value="False">
																<Setter Property="Visibility" Value="Visible" />
															</DataTrigger>
														</Style.Triggers>
													</Style>
												</StackPanel.Style>

												<TextBlock
													HorizontalAlignment="Center"
													FontSize="{DynamicResource AppFontSize16}"
													FontWeight="SemiBold"
													Foreground="{DynamicResource TextBrush}"
													Text="No history snapshots" />

												<TextBlock
													Margin="0,8,0,0"
													Style="{StaticResource EmptyHistoryTextStyle}"
													Text="Changes made to entries will appear here." />
											</StackPanel>

											<StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
												<StackPanel.Style>
													<Style TargetType="StackPanel">
														<Setter Property="Visibility" Value="Collapsed" />
														<Style.Triggers>
															<DataTrigger Binding="{Binding HasNoSearchResults}" Value="True">
																<Setter Property="Visibility" Value="Visible" />
															</DataTrigger>
														</Style.Triggers>
													</Style>
												</StackPanel.Style>

												<TextBlock
													HorizontalAlignment="Center"
													FontSize="{DynamicResource AppFontSize16}"
													FontWeight="SemiBold"
													Foreground="{DynamicResource TextBrush}"
													Text="No matching history snapshots" />

												<TextBlock
													Margin="0,8,0,0"
													Style="{StaticResource EmptyHistoryTextStyle}"
													Text="Try a different search." />
											</StackPanel>
										</Grid>
									</ControlTemplate>
								</Setter.Value>
							</Setter>
						</Style>
					</ListBox.Style>
					<ListBox.ItemContainerStyle>
						<Style TargetType="ListBoxItem">
							<EventSetter Event="PreviewMouseLeftButtonDown" Handler="HistoryListBoxItem_PreviewMouseLeftButtonDown" />
							<Setter Property="HorizontalContentAlignment" Value="Stretch" />
							<Setter Property="Padding" Value="0" />
							<Setter Property="Margin" Value="0,0,12,6" />
							<Setter Property="Template">
								<Setter.Value>
									<ControlTemplate TargetType="ListBoxItem">
										<Border
											x:Name="ItemBorder"
											Padding="14,12"
											Background="{DynamicResource SurfaceBrush}"
											BorderBrush="Transparent"
											BorderThickness="1"
											CornerRadius="8">
											<ContentPresenter />
										</Border>
										<ControlTemplate.Triggers>
											<Trigger Property="IsSelected" Value="True">
												<Setter TargetName="ItemBorder" Property="Background" Value="{DynamicResource SurfaceAltBrush}" />
												<Setter TargetName="ItemBorder" Property="BorderBrush" Value="{DynamicResource AccentBrush}" />
											</Trigger>
											<Trigger Property="IsMouseOver" Value="True">
												<Setter TargetName="ItemBorder" Property="Background" Value="{DynamicResource SurfaceAltBrush}" />
											</Trigger>
											<Trigger Property="IsKeyboardFocusWithin" Value="True">
												<Setter TargetName="ItemBorder" Property="BorderBrush" Value="{DynamicResource AccentBrush}" />
											</Trigger>
										</ControlTemplate.Triggers>
									</ControlTemplate>
								</Setter.Value>
							</Setter>
						</Style>
					</ListBox.ItemContainerStyle>
					<ListBox.ItemTemplate>
						<DataTemplate>
							<Grid>
								<Grid.ColumnDefinitions>
									<ColumnDefinition Width="24" />
									<ColumnDefinition Width="*" />
								</Grid.ColumnDefinitions>

								<Grid Grid.Column="0">
									<Border
										Width="1"
										Margin="0,14,0,0"
										HorizontalAlignment="Center"
										VerticalAlignment="Stretch"
										Background="{DynamicResource BorderBrush}" />
									<Ellipse
										Width="9"
										Height="9"
										Margin="0,7,0,0"
										HorizontalAlignment="Center"
										VerticalAlignment="Top"
										Fill="{DynamicResource AccentBrush}" />
								</Grid>

								<Border
									Grid.Column="1"
									Margin="8,0,0,6"
									Padding="14,12"
									Background="{DynamicResource SurfaceBrush}"
									CornerRadius="8">
									<Expander BorderThickness="0" IsExpanded="{Binding IsExpanded, Mode=TwoWay}">
										<Expander.Header>
											<Grid>
												<Grid.ColumnDefinitions>
													<ColumnDefinition Width="*" />
													<ColumnDefinition Width="Auto" />
												</Grid.ColumnDefinitions>

												<StackPanel>
													<TextBlock
														FontWeight="SemiBold"
														Foreground="{DynamicResource TextBrush}"
														Text="{Binding Title}"
														TextTrimming="CharacterEllipsis" />
													<TextBlock
														Margin="0,3,0,0"
														FontSize="{DynamicResource AppFontSize11}"
														Foreground="{DynamicResource MutedBrush}"
														Text="{Binding ChangedAtText}" />
													<TextBlock
														Margin="0,5,0,0"
														FontSize="{DynamicResource AppFontSize12}"
														Foreground="{DynamicResource MutedBrush}"
														Text="{Binding ChangeSummary}" />
												</StackPanel>

												<TextBlock
													Grid.Column="1"
													Margin="12,0,0,0"
													VerticalAlignment="Center"
													FontSize="{DynamicResource AppFontSize11}"
													Foreground="{DynamicResource MutedBrush}"
													Text="{Binding Username}"
													TextTrimming="CharacterEllipsis" />
											</Grid>
										</Expander.Header>

										<Border
											Margin="0,12,0,0"
											Padding="10,10,10,2"
											Background="{DynamicResource SurfaceAltBrush}"
											CornerRadius="6">
											<StackPanel>
												<TextBlock
													Margin="0,0,0,8"
													FontSize="{DynamicResource AppFontSize11}"
													FontWeight="SemiBold"
													Foreground="{DynamicResource MutedBrush}"
													Text="Changed fields" />

												<ItemsControl ItemsSource="{Binding ChangedFields}">
													<ItemsControl.ItemsPanel>
														<ItemsPanelTemplate>
															<WrapPanel />
														</ItemsPanelTemplate>
													</ItemsControl.ItemsPanel>
													<ItemsControl.ItemTemplate>
														<DataTemplate>
															<Border
																Margin="0,0,6,6"
																Padding="8,4"
																Background="{DynamicResource SurfaceBrush}"
																CornerRadius="4">
																<TextBlock
																	FontSize="{DynamicResource AppFontSize11}"
																	Foreground="{DynamicResource TextBrush}"
																	Text="{Binding}" />
															</Border>
														</DataTemplate>
													</ItemsControl.ItemTemplate>
												</ItemsControl>

												<TextBlock
													Margin="0,0,0,8"
													FontSize="{DynamicResource AppFontSize11}"
													Foreground="{DynamicResource MutedBrush}"
													Text="No field changes detected.">
													<TextBlock.Style>
														<Style TargetType="TextBlock">
															<Setter Property="Visibility" Value="Collapsed" />
															<Style.Triggers>
																<DataTrigger Binding="{Binding ChangedFields.Count}" Value="0">
																	<Setter Property="Visibility" Value="Visible" />
																</DataTrigger>
															</Style.Triggers>
														</Style>
													</TextBlock.Style>
												</TextBlock>
											</StackPanel>
										</Border>
									</Expander>
								</Border>
							</Grid>
						</DataTemplate>
					</ListBox.ItemTemplate>
				</ListBox>

				<!--  Comparison panel  -->
				<Border
					Grid.Column="1"
					Margin="12,0,0,0"
					Padding="16"
					Background="{DynamicResource SurfaceBrush}"
					CornerRadius="8">
					<Grid>
						<StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
							<StackPanel.Style>
								<Style TargetType="StackPanel">
									<Setter Property="Visibility" Value="Collapsed" />
									<Style.Triggers>
										<DataTrigger Binding="{Binding SelectedItem}" Value="{x:Null}">
											<Setter Property="Visibility" Value="Visible" />
										</DataTrigger>
									</Style.Triggers>
								</Style>
							</StackPanel.Style>
							<TextBlock
								HorizontalAlignment="Center"
								FontSize="{DynamicResource AppFontSize18}"
								FontWeight="SemiBold"
								Foreground="{DynamicResource TextBrush}"
								Text="No snapshot selected" />
							<TextBlock
								Margin="0,8,0,0"
								HorizontalAlignment="Center"
								FontSize="{DynamicResource AppFontSize12}"
								Foreground="{DynamicResource MutedBrush}"
								Text="Select a history snapshot from the left to compare it with the current entry."
								TextAlignment="Center"
								TextWrapping="Wrap" />
						</StackPanel>

						<Grid>
							<Grid.Style>
								<Style TargetType="Grid">
									<Setter Property="Visibility" Value="Visible" />
									<Style.Triggers>
										<DataTrigger Binding="{Binding SelectedItem}" Value="{x:Null}">
											<Setter Property="Visibility" Value="Collapsed" />
										</DataTrigger>
									</Style.Triggers>
								</Style>
							</Grid.Style>
							<Grid.RowDefinitions>
								<RowDefinition Height="Auto" />
								<RowDefinition Height="*" />
							</Grid.RowDefinitions>

							<Grid Grid.Row="0" Margin="0,0,0,8">
								<Grid.ColumnDefinitions>
									<ColumnDefinition Width="34" />
									<ColumnDefinition Width="120" />
									<ColumnDefinition Width="*" />
									<ColumnDefinition Width="*" />
								</Grid.ColumnDefinitions>
								<TextBlock
									Grid.Column="1"
									FontWeight="SemiBold"
									Foreground="{DynamicResource MutedBrush}"
									Text="Field" />
								<TextBlock
									Grid.Column="2"
									FontWeight="SemiBold"
									Foreground="{DynamicResource MutedBrush}"
									Text="Current" />
								<TextBlock
									Grid.Column="3"
									FontWeight="SemiBold"
									Foreground="{DynamicResource MutedBrush}"
									Text="Snapshot" />
							</Grid>

							<ScrollViewer
								Grid.Row="1"
								HorizontalScrollBarVisibility="Disabled"
								VerticalScrollBarVisibility="Auto">
								<ItemsControl ItemsSource="{Binding Fields}">
									<ItemsControl.ItemTemplate>
										<DataTemplate>
											<Border
												Padding="0,10"
												BorderBrush="{DynamicResource BorderBrush}"
												BorderThickness="0,0,0,1">
												<Grid>
													<Grid.ColumnDefinitions>
														<ColumnDefinition Width="34" />
														<ColumnDefinition Width="120" />
														<ColumnDefinition Width="*" />
														<ColumnDefinition Width="*" />
													</Grid.ColumnDefinitions>

													<CheckBox
														Grid.Column="0"
														VerticalAlignment="Center"
														IsChecked="{Binding IsSelected, Mode=TwoWay}"
														Visibility="{Binding IsChanged, Converter={StaticResource BoolToVis}}" />

													<Grid Grid.Column="1" VerticalAlignment="Center">
														<Grid.ColumnDefinitions>
															<ColumnDefinition Width="*" />
															<ColumnDefinition Width="Auto" />
														</Grid.ColumnDefinitions>
														<TextBlock
															Margin="0,0,6,0"
															VerticalAlignment="Center"
															FontWeight="SemiBold"
															Foreground="{DynamicResource TextBrush}"
															Text="{Binding Name}"
															TextTrimming="CharacterEllipsis" />
														<Button
															Grid.Column="1"
															Width="32"
															Height="32"
															Padding="0"
															VerticalAlignment="Center"
															Background="Transparent"
															BorderThickness="0"
															Command="{Binding ToggleSecretVisibilityCommand}"
															Content="&#xE890;"
															Cursor="Hand"
															FontFamily="Segoe MDL2 Assets"
															FontSize="{DynamicResource AppFontSize13}"
															Foreground="{DynamicResource AccentBrush}">
															<Button.Style>
																<Style BasedOn="{StaticResource {x:Type Button}}" TargetType="Button">
																	<Setter Property="Visibility" Value="Collapsed" />
																	<Setter Property="ToolTip" Value="Show or hide secret" />
																	<Style.Triggers>
																		<DataTrigger Binding="{Binding IsSecret}" Value="True">
																			<Setter Property="Visibility" Value="Visible" />
																		</DataTrigger>
																	</Style.Triggers>
																</Style>
															</Button.Style>
														</Button>
													</Grid>

													<TextBlock
														Grid.Column="2"
														MaxHeight="48"
														Margin="0,0,8,0"
														VerticalAlignment="Center"
														Foreground="{DynamicResource TextBrush}"
														Text="{Binding CurrentDisplayValue}"
														TextTrimming="CharacterEllipsis"
														TextWrapping="NoWrap" />

													<TextBlock
														Grid.Column="3"
														MaxHeight="48"
														Margin="0,0,8,0"
														VerticalAlignment="Center"
														Foreground="{DynamicResource TextBrush}"
														Text="{Binding SnapshotDisplayValue}"
														TextTrimming="CharacterEllipsis"
														TextWrapping="NoWrap" />
												</Grid>
											</Border>
										</DataTemplate>
									</ItemsControl.ItemTemplate>
								</ItemsControl>
							</ScrollViewer>
						</Grid>
					</Grid>
				</Border>
			</Grid>

			<!--  Footer  -->
			<Grid Grid.Row="3" Margin="0,16,0,0">
				<TextBlock
					VerticalAlignment="Center"
					Foreground="{DynamicResource MutedBrush}"
					Text="{Binding FilteredItems.Count, StringFormat={}{0} history snapshots}" />
				<StackPanel HorizontalAlignment="Right" Orientation="Horizontal">
					<Button
						Margin="0,0,8,0"
						Command="{Binding DeleteHistoryCommand}"
						Content="Delete"
						IsEnabled="{Binding HasSelectedItem}" />

					<Button
						Margin="0,0,8,0"
						Command="{Binding DeleteAllHistoryCommand}"
						Content="Delete All"
						IsEnabled="{Binding HasHistoryItems}" />

					<Button
						Command="{Binding RestoreCommand}"
						Content="Restore"
						IsDefault="True"
						IsEnabled="{Binding HasSelectedFields}" />
				</StackPanel>
			</Grid>
		</Grid>

		<!--  Busy overlay  -->
		<Border
			Grid.Row="0"
			Grid.RowSpan="2"
			Panel.ZIndex="100"
			Background="#80000000"
			Visibility="{Binding IsBusy, Converter={StaticResource BoolToVis}}">
			<Border
				Margin="24"
				Padding="24"
				HorizontalAlignment="Center"
				VerticalAlignment="Center"
				Background="{DynamicResource SurfaceBrush}">
				<StackPanel>
					<ProgressBar
						Width="180"
						Height="4"
						IsIndeterminate="True" />
					<TextBlock
						Margin="0,12,0,0"
						HorizontalAlignment="Center"
						Foreground="{DynamicResource TextBrush}"
						Text="{Binding BusyMessage}" />
				</StackPanel>
			</Border>
		</Border>
	</Grid>
</Window>
