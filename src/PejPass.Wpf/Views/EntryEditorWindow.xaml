<Window x:Class="PejPass.Wpf.Views.EntryEditorWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="clr-namespace:PejPass.Wpf.Controls"
        Height="760"
        Width="560"
        WindowStartupLocation="CenterOwner"
        ResizeMode="CanResize"
        MinHeight="520"
        MinWidth="480"
        ShowInTaskbar="False"
        Background="{DynamicResource BgBrush}">

    <Window.Resources>
        <Style x:Key="SectionHeader" TargetType="TextBlock">
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="{DynamicResource TextBrush}"/>
            <Setter Property="Margin" Value="0,12,0,10"/>
        </Style>

        <Style x:Key="CustomFieldMoveButton"
               TargetType="Button"
               BasedOn="{StaticResource SecondaryButton}">
            <Setter Property="Foreground" Value="{DynamicResource TextBrush}"/>
            <Style.Triggers>
                <Trigger Property="IsEnabled" Value="False">
                    <Setter Property="Foreground" Value="{DynamicResource TextDisabledBrush}"/>
                    <Setter Property="Background" Value="{DynamicResource SurfaceBrush}"/>
                    <Setter Property="Opacity" Value="1"/>
                </Trigger>
            </Style.Triggers>
        </Style>
    </Window.Resources>

    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <ScrollViewer VerticalScrollBarVisibility="Auto">
            <StackPanel Margin="0,0,12,0">

                <!-- Identity -->
                <Border BorderBrush="{DynamicResource BorderBrush}"
                        BorderThickness="0,0,0,1"
                        Margin="0,12,0,10"
                        Padding="0,0,0,8">
                    <TextBlock Text="Identity"
                               FontSize="{DynamicResource AppFontSize13}"
                               FontWeight="SemiBold"
                               Foreground="{DynamicResource TextBrush}"/>
                </Border>

                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel>
                        <TextBlock Text="Title"
                                   Foreground="{DynamicResource MutedBrush}"
                                   Margin="0,0,0,6"/>

                        <TextBox x:Name="TitleTextBox"
                                 Text="{Binding Title, UpdateSourceTrigger=PropertyChanged}"
                                 TextWrapping="NoWrap"
                                 VerticalScrollBarVisibility="Disabled"/>

                        <TextBlock Style="{StaticResource ValidationErrorText}"
                                   Text="{Binding TitleErrorMessage, StringFormat=⚠ {0}}"
                                   Visibility="{Binding TitleErrorMessage, Converter={StaticResource NullOrEmptyToVis}}"/>
                    </StackPanel>

                    <Button Grid.Column="1"
                            Width="36"
                            Height="36"
                            Padding="10,0,10,3"
                            Margin="12,0,0,0"
                            VerticalAlignment="Bottom"
                            Command="{Binding ToggleFavoriteCommand}"
                            Background="{DynamicResource SurfaceAltBrush}"
                            BorderThickness="0"
                            Cursor="Hand">
                        <Button.Style>
                            <Style TargetType="Button"
                                   BasedOn="{StaticResource {x:Type Button}}">
                                <Setter Property="ToolTip" Value="Add to favorites"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsFavorite}" Value="True">
                                        <Setter Property="ToolTip" Value="Remove from favorites"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                        <TextBlock FontSize="{DynamicResource AppFontSize16}"
                                   Foreground="{DynamicResource TextBrush}">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Text" Value="☆"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsFavorite}" Value="True">
                                            <Setter Property="Text" Value="★"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                    </Button>
                </Grid>

                <TextBlock Text="Username"
                           Foreground="{DynamicResource MutedBrush}"
                           Margin="0,12,0,6"/>

                <TextBox Text="{Binding Username, UpdateSourceTrigger=PropertyChanged}"
                         Margin="0,0,0,12"
                         TextWrapping="NoWrap"
                         VerticalScrollBarVisibility="Disabled"/>

                <TextBlock Text="URL"
                           Foreground="{DynamicResource MutedBrush}"
                           Margin="0,0,0,6"/>

                <TextBox Text="{Binding Url, UpdateSourceTrigger=PropertyChanged}"
                         Margin="0,0,0,20"
                         TextWrapping="NoWrap"
                         VerticalScrollBarVisibility="Disabled"/>

                <!-- Password -->
                <Border BorderBrush="{DynamicResource BorderBrush}"
                        BorderThickness="0,0,0,1"
                        Margin="0,12,0,10"
                        Padding="0,0,0,8">
                    <TextBlock Text="Password"
                               FontSize="{DynamicResource AppFontSize13}"
                               FontWeight="SemiBold"
                               Foreground="{DynamicResource TextBrush}"/>
                </Border>

                <!-- Password input -->
                <controls:PasswordRevealBox x:Name="PasswordBox"
                                            PasswordChanged="PasswordBox_PasswordChanged"
                                            Margin="0,0,0,8"/>

                <Button Style="{StaticResource SecondaryButton}"
                        Content="Generate password"
                        Command="{Binding OpenAdvancedGeneratorCommand}"
                        HorizontalAlignment="Left"
                        Padding="14,7"
                        Margin="0,0,0,16"
                        ToolTip="Generate a password and customize its options"/>

                <!-- Password Strength -->
                <controls:PasswordStrengthIndicator
                    StrengthLabel="{Binding PasswordStrengthLabel}"
                    StrengthLevel="{Binding PasswordStrengthLevel}"
                    StrengthProgress="{Binding PasswordStrengthProgress}"
                    Margin="0,0,0,20"/>

                <!-- Two-factor authentication -->
                <Border BorderBrush="{DynamicResource BorderBrush}"
                        BorderThickness="0,0,0,1"
                        Margin="0,12,0,10"
                        Padding="0,0,0,8">
                    <TextBlock Text="Two-factor authentication"
                               FontSize="{DynamicResource AppFontSize13}"
                               FontWeight="SemiBold"
                               Foreground="{DynamicResource TextBrush}"/>
                </Border>

                <TextBlock Text="TOTP Secret (Base32)"
                           Foreground="{DynamicResource MutedBrush}"
                           Margin="0,0,0,6"/>

                <controls:PasswordRevealBox x:Name="TotpSecretBox"
                                            PasswordChanged="TotpSecretBox_PasswordChanged"
                                            Margin="0,0,0,6"
                                            ToolTip="Paste the authenticator secret key (Base32). Leave empty to disable TOTP."/>

                <TextBlock Text="Import QR code"
                           FontSize="{DynamicResource AppFontSize12}"
                           FontWeight="SemiBold"
                           Foreground="{DynamicResource MutedBrush}"
                           Margin="0,0,0,6"/>

                <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                    <Button Style="{StaticResource SecondaryButton}"
                            Content="From image"
                            Command="{Binding ImportTotpFromFileCommand}"
                            Padding="12,6"
                            Height="32"
                            Margin="0,0,8,0"
                            Background="{DynamicResource SurfaceAltBrush}"
                            Foreground="{DynamicResource TextBrush}"
                            ToolTip="Import a QR code from an image file"/>
                    <Button Style="{StaticResource SecondaryButton}"
                            Content="From clipboard"
                            Command="{Binding ImportTotpFromClipboardCommand}"
                            Padding="12,6"
                            Height="32"
                            Background="{DynamicResource SurfaceAltBrush}"
                            Foreground="{DynamicResource TextBrush}"
                            ToolTip="Import a QR code image from the clipboard"/>
                </StackPanel>

                <TextBlock Style="{StaticResource ValidationErrorText}"
                           Text="{Binding TotpErrorMessage, StringFormat=⚠ {0}}"
                           Visibility="{Binding TotpErrorMessage, Converter={StaticResource NullOrEmptyToVis}}"/>

                <TextBlock Text="Optional — used to generate 2FA codes in the main window"
                           FontSize="{DynamicResource AppFontSize11}"
                           Foreground="{DynamicResource MutedBrush}"
                           Margin="0,0,0,20"/>

                <!-- Tags -->
                <Border BorderBrush="{DynamicResource BorderBrush}"
                        BorderThickness="0,0,0,1"
                        Margin="0,12,0,10"
                        Padding="0,0,0,8">
                    <TextBlock Text="Tags"
                               FontSize="{DynamicResource AppFontSize13}"
                               FontWeight="SemiBold"
                               Foreground="{DynamicResource TextBrush}"/>
                </Border>

                <TextBox Text="{Binding TagsText, UpdateSourceTrigger=PropertyChanged}"
                         Margin="0,0,0,6"
                         TextWrapping="NoWrap"
                         VerticalScrollBarVisibility="Disabled"/>

                <controls:TagChipStrip ItemsSource="{Binding SuggestedTags}"
                                       ChipCommand="{Binding ToggleSuggestedTagCommand}"
                                       Margin="0,0,0,20"/>

                <!-- Additional information -->
                <Border BorderBrush="{DynamicResource BorderBrush}"
                        BorderThickness="0,0,0,1"
                        Margin="0,12,0,10"
                        Padding="0,0,0,8">
                    <TextBlock Text="Additional information"
                               FontSize="{DynamicResource AppFontSize13}"
                               FontWeight="SemiBold"
                               Foreground="{DynamicResource TextBrush}"/>
                </Border>

                <!-- Custom Fields -->
                <Grid Margin="0,0,0,8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <TextBlock Text="Custom Fields"
                               FontSize="{DynamicResource AppFontSize12}"
                               FontWeight="SemiBold"
                               Foreground="{DynamicResource MutedBrush}"
                               VerticalAlignment="Center"/>

                    <Button Grid.Column="1"
                            Style="{StaticResource SecondaryButton}"
                            Content="+ Add Field"
                            Command="{Binding AddCustomFieldCommand}"
                            Padding="10,4"
                            Height="32"
                            FontSize="{DynamicResource AppFontSize12}"/>
                </Grid>

                <ItemsControl ItemsSource="{Binding CustomFields}"
                              Margin="0,0,0,20">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Grid Margin="0,0,0,6">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="120"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="32"/>
                                    <ColumnDefinition Width="32"/>
                                    <ColumnDefinition Width="32"/>
                                </Grid.ColumnDefinitions>

                                <TextBox Text="{Binding Name, UpdateSourceTrigger=PropertyChanged}"
                                         ToolTip="Field name"
                                         Margin="0,0,6,0"
                                         TextWrapping="NoWrap"
                                         VerticalScrollBarVisibility="Disabled"/>

                                <TextBox Grid.Column="1"
                                         Text="{Binding Value, UpdateSourceTrigger=PropertyChanged}"
                                         ToolTip="Field value"
                                         Margin="2,0,6,0"
                                         TextWrapping="NoWrap"
                                         VerticalScrollBarVisibility="Disabled"/>

                                <CheckBox Grid.Column="2"
                                          IsChecked="{Binding IsSecret}"
                                          Content="Secret"
                                          Foreground="{DynamicResource MutedBrush}"
                                          VerticalAlignment="Center"
                                          Margin="4,0,10,0"
                                          ToolTip="Hide value in the main window like a password"/>

                                <Button Grid.Column="3"
                                        Style="{StaticResource CustomFieldMoveButton}"
                                        Content="▲"
                                        Command="{Binding DataContext.MoveCustomFieldUpCommand,
                                                  RelativeSource={RelativeSource AncestorType=Window}}"
                                        CommandParameter="{Binding}"
                                        Width="32"
                                        Height="32"
                                        Padding="0"
                                        ToolTip="Move field up"/>

                                <Button Grid.Column="4"
                                        Style="{StaticResource CustomFieldMoveButton}"
                                        Content="▼"
                                        Command="{Binding DataContext.MoveCustomFieldDownCommand,
                                                  RelativeSource={RelativeSource AncestorType=Window}}"
                                        CommandParameter="{Binding}"
                                        Width="32"
                                        Height="32"
                                        Padding="0"
                                        Margin="2,0,0,0"
                                        ToolTip="Move field down"/>

                                <Button Grid.Column="5"
                                        Content="✕"
                                        Command="{Binding DataContext.RemoveCustomFieldCommand,
                                                  RelativeSource={RelativeSource AncestorType=Window}}"
                                        CommandParameter="{Binding}"
                                        Padding="8,4"
                                        Height="32"
                                        Margin="2,0,0,0"
                                        Background="{DynamicResource DangerBrush}"
                                        ToolTip="Remove field"/>
                            </Grid>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

                <!-- Notes -->
                <TextBlock Text="Notes"
                           Foreground="{DynamicResource MutedBrush}"
                           Margin="0,0,0,6"/>

                <TextBox Text="{Binding Notes, UpdateSourceTrigger=PropertyChanged}"
                         Height="100"
                         MaxHeight="160"
                         TextWrapping="Wrap"
                         AcceptsReturn="True"
                         VerticalContentAlignment="Top"
                         VerticalScrollBarVisibility="Auto"
                         HorizontalScrollBarVisibility="Disabled"/>

                </StackPanel>
        </ScrollViewer>

        <!-- Footer -->
        <StackPanel Grid.Row="1"
                    Orientation="Horizontal"
                    HorizontalAlignment="Right"
                    Margin="0,16,0,0">

            <Button Style="{StaticResource SecondaryButton}"
                    Content="Cancel"
                    Click="Cancel_Click"
                    IsCancel="True"
                    Margin="0,0,8,0"
                    Background="{DynamicResource SurfaceBrush}"
                    Foreground="{DynamicResource TextBrush}"/>

            <Button Style="{StaticResource PrimaryButton}"
                    Content="Save"
                    Click="Save_Click"
                    IsDefault="True"/>
        </StackPanel>
    </Grid>
</Window>