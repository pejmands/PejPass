<Window x:Class="PejPass.Wpf.Views.EntryEditorWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="{Binding WindowTitle}"
        Height="640" Width="520"
        MinHeight="480" MinWidth="420"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource BgBrush}">

    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="0,0,16,0">
            <StackPanel>
                <TextBlock Text="Title" Foreground="{DynamicResource MutedBrush}" Margin="0,0,0,4"/>
                <TextBox Text="{Binding Title, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,0,12"/>

                <TextBlock Text="Username" Foreground="{DynamicResource MutedBrush}" Margin="0,0,0,4"/>
                <TextBox Text="{Binding Username, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,0,12"/>

                <TextBlock Text="Password" Foreground="{DynamicResource MutedBrush}" Margin="0,0,0,4"/>
                <Grid Margin="0,0,0,4">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBox Text="{Binding Password, UpdateSourceTrigger=PropertyChanged}"
                             FontFamily="Consolas"/>
                    <Button Grid.Column="1" Content="Generate" Margin="8,0,0,0" Padding="12,8"
                            Command="{Binding OpenGeneratorCommand}"
                            Background="{DynamicResource SurfaceAltBrush}" Foreground="{DynamicResource TextBrush}"/>
                </Grid>
                <Grid Margin="0,0,0,12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <ProgressBar Height="4" Maximum="4" Value="{Binding PasswordStrengthProgress}"
                                 VerticalAlignment="Center"/>
                    <TextBlock Grid.Column="1" Text="{Binding PasswordStrengthLabel}"
                               FontSize="11" Margin="10,0,0,0" VerticalAlignment="Center"
                               Foreground="{DynamicResource MutedBrush}"/>
                </Grid>

                <TextBlock Text="URL" Foreground="{DynamicResource MutedBrush}" Margin="0,0,0,4"/>
                <TextBox Text="{Binding Url, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,0,12"/>

                <TextBlock Text="TOTP secret (Base32)" Foreground="{DynamicResource MutedBrush}" Margin="0,0,0,4"/>
                <TextBox Text="{Binding TotpSecret, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,0,12"
                         FontFamily="Consolas"/>

                <TextBlock Text="Notes" Foreground="{DynamicResource MutedBrush}" Margin="0,0,0,4"/>
                <TextBox Text="{Binding Notes, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,0,12"
                         AcceptsReturn="True" TextWrapping="Wrap" MinHeight="72"/>

                <TextBlock Text="Tags (comma separated)" Foreground="{DynamicResource MutedBrush}" Margin="0,0,0,4"/>
                <TextBox Text="{Binding TagsText, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,0,6"/>
                <ItemsControl ItemsSource="{Binding SuggestedTags}" Margin="0,0,0,12">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <WrapPanel/>
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Button Content="{Binding}"
                                    Command="{Binding DataContext.ToggleSuggestedTagCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                    CommandParameter="{Binding}"
                                    Margin="0,0,6,6" Padding="10,4" FontSize="11"
                                    Background="{DynamicResource SurfaceAltBrush}"
                                    Foreground="{DynamicResource TextBrush}"
                                    ToolTip="Add or remove this tag"/>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

                <CheckBox Content="Favorite" IsChecked="{Binding IsFavorite}" Margin="0,0,0,16"/>

                <!-- Custom fields and history sections preserved by fetching full file -->
                <TextBlock Text="Custom fields" FontWeight="SemiBold" Foreground="{DynamicResource TextBrush}" Margin="0,0,0,8"/>
                <ItemsControl ItemsSource="{Binding CustomFields}" Margin="0,0,0,8">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Grid Margin="0,0,0,8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBox Text="{Binding Name, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,6,0"
                                         ToolTip="Field name"/>
                                <TextBox Grid.Column="1" Text="{Binding Value, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,6,0"
                                         ToolTip="Field value"/>
                                <CheckBox Grid.Column="2" Content="Secret" IsChecked="{Binding IsSecret}" Margin="0,0,6,0" VerticalAlignment="Center"/>
                                <Button Grid.Column="3" Content="✕" Padding="8,4"
                                        Command="{Binding DataContext.RemoveCustomFieldCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                        CommandParameter="{Binding}"
                                        Background="{DynamicResource SurfaceAltBrush}" Foreground="{DynamicResource TextBrush}"/>
                            </Grid>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
                <Button Content="+ Add field" Command="{Binding AddCustomFieldCommand}" Margin="0,0,0,16"
                        HorizontalAlignment="Left" Padding="12,6"
                        Background="{DynamicResource SurfaceAltBrush}" Foreground="{DynamicResource TextBrush}"/>

                <StackPanel Visibility="{Binding HasPasswordHistory, Converter={StaticResource BoolToVis}}" Margin="0,0,0,12">
                    <TextBlock Text="Password history" FontWeight="SemiBold" Foreground="{DynamicResource TextBrush}" Margin="0,0,0,8"/>
                    <ItemsControl ItemsSource="{Binding PasswordHistoryItems}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Grid Margin="0,0,0,6">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock VerticalAlignment="Center">
                                        <Run Text="{Binding Password, Mode=OneWay}" FontFamily="Consolas"/>
                                        <Run Text="  ·  " Foreground="{DynamicResource MutedBrush}"/>
                                        <Run Text="{Binding ChangedAtText, Mode=OneWay}" Foreground="{DynamicResource MutedBrush}" FontSize="11"/>
                                    </TextBlock>
                                    <Button Grid.Column="1" Content="✕" Padding="8,4"
                                            Command="{Binding DataContext.RemovePasswordHistoryCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                            CommandParameter="{Binding}"
                                            Background="{DynamicResource SurfaceAltBrush}" Foreground="{DynamicResource TextBrush}"/>
                                </Grid>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>

                <StackPanel Visibility="{Binding HasUsernameHistory, Converter={StaticResource BoolToVis}}" Margin="0,0,0,12">
                    <TextBlock Text="Username history" FontWeight="SemiBold" Foreground="{DynamicResource TextBrush}" Margin="0,0,0,8"/>
                    <ItemsControl ItemsSource="{Binding UsernameHistoryItems}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Grid Margin="0,0,0,6">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock VerticalAlignment="Center">
                                        <Run Text="{Binding Username, Mode=OneWay}"/>
                                        <Run Text="  ·  " Foreground="{DynamicResource MutedBrush}"/>
                                        <Run Text="{Binding ChangedAtText, Mode=OneWay}" Foreground="{DynamicResource MutedBrush}" FontSize="11"/>
                                    </TextBlock>
                                    <Button Grid.Column="1" Content="✕" Padding="8,4"
                                            Command="{Binding DataContext.RemoveUsernameHistoryCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                            CommandParameter="{Binding}"
                                            Background="{DynamicResource SurfaceAltBrush}" Foreground="{DynamicResource TextBrush}"/>
                                </Grid>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </StackPanel>
        </ScrollViewer>

        <StackPanel Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0">
            <Button Content="Cancel" IsCancel="True" Padding="20,10" Margin="0,0,10,0"
                    Background="{DynamicResource SurfaceAltBrush}" Foreground="{DynamicResource TextBrush}"
                    Click="Cancel_Click"/>
            <Button Content="Save" IsDefault="True" Padding="20,10"
                    Command="{Binding SaveCommand}"/>
        </StackPanel>
    </Grid>
</Window>
