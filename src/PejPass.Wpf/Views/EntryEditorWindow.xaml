<Window
	x:Class="PejPass.Wpf.Views.EntryEditorWindow"
	xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
	xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
	xmlns:controls="clr-namespace:PejPass.Wpf.Controls"
	Width="560"
	Height="760"
	MinWidth="480"
	MinHeight="520"
	Background="{DynamicResource BgBrush}"
	ResizeMode="CanResize"
	ShowInTaskbar="False"
	WindowStartupLocation="CenterOwner">

	<Window.Resources>
		<Style x:Key="SectionHeader" TargetType="TextBlock">
			<Setter Property="FontSize" Value="13" />
			<Setter Property="FontWeight" Value="SemiBold" />
			<Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
			<Setter Property="Margin" Value="0,12,0,10" />
		</Style>

		<Style
			x:Key="CustomFieldMoveButton"
			BasedOn="{StaticResource SecondaryButton}"
			TargetType="Button">
			<Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
			<Style.Triggers>
				<Trigger Property="IsEnabled" Value="False">
					<Setter Property="Foreground" Value="{DynamicResource TextDisabledBrush}" />
					<Setter Property="Background" Value="{DynamicResource SurfaceBrush}" />
					<Setter Property="Opacity" Value="1" />
				</Trigger>
			</Style.Triggers>
		</Style>
	</Window.Resources>

	<Grid Margin="24">
		<Grid.RowDefinitions>
			<RowDefinition Height="*" />
			<RowDefinition Height="Auto" />
		</Grid.RowDefinitions>

		<ScrollViewer VerticalScrollBarVisibility="Auto">
			<StackPanel Margin="0,0,12,0">

				<!--  Identity  -->
				<Border
					Margin="0,12,0,10"
					Padding="0,0,0,8"
					BorderBrush="{DynamicResource BorderBrush}"
					BorderThickness="0,0,0,1">
					<TextBlock
						FontSize="{DynamicResource AppFontSize13}"
						FontWeight="SemiBold"
						Foreground="{DynamicResource TextBrush}"
						Text="Identity" />
				</Border>

				<Grid>
					<Grid.ColumnDefinitions>
						<ColumnDefinition Width="*" />
						<ColumnDefinition Width="Auto" />
					</Grid.ColumnDefinitions>

					<StackPanel>
						<TextBlock
							Margin="0,0,0,6"
							Foreground="{DynamicResource MutedBrush}"
							Text="Title" />

						<TextBox
							x:Name="TitleTextBox"
							Text="{Binding Title, UpdateSourceTrigger=PropertyChanged}"
							TextWrapping="NoWrap"
							VerticalScrollBarVisibility="Disabled" />

						<TextBlock
							Style="{StaticResource ValidationErrorText}"
							Text="{Binding TitleErrorMessage, StringFormat=⚠ {0}}"
							Visibility="{Binding TitleErrorMessage, Converter={StaticResource NullOrEmptyToVis}}" />
					</StackPanel>

					<Button
						Grid.Column="1"
						Width="36"
						Height="36"
						Margin="12,0,0,0"
						Padding="10,0,10,3"
						VerticalAlignment="Bottom"
						Background="{DynamicResource SurfaceAltBrush}"
						BorderThickness="0"
						Command="{Binding ToggleFavoriteCommand}"
						Cursor="Hand">
						<Button.Style>
							<Style BasedOn="{StaticResource {x:Type Button}}" TargetType="Button">
								<Setter Property="ToolTip" Value="Add to favorites" />
								<Style.Triggers>
									<DataTrigger Binding="{Binding IsFavorite}" Value="True">
										<Setter Property="ToolTip" Value="Remove from favorites" />
									</DataTrigger>
								</Style.Triggers>
							</Style>
						</Button.Style>
						<TextBlock FontSize="{DynamicResource AppFontSize16}" Foreground="{DynamicResource TextBrush}">
							<TextBlock.Style>
								<Style TargetType="TextBlock">
									<Setter Property="Text" Value="☆" />
									<Style.Triggers>
										<DataTrigger Binding="{Binding IsFavorite}" Value="True">
											<Setter Property="Text" Value="★" />
										</DataTrigger>
									</Style.Triggers>
								</Style>
							</TextBlock.Style>
						</TextBlock>
					</Button>
				</Grid>

				<TextBlock
					Margin="0,12,0,6"
					Foreground="{DynamicResource MutedBrush}"
					Text="Username" />

				<TextBox
					Margin="0,0,0,12"
					Text="{Binding Username, UpdateSourceTrigger=PropertyChanged}"
					TextWrapping="NoWrap"
					VerticalScrollBarVisibility="Disabled" />

				<TextBlock
					Margin="0,0,0,6"
					Foreground="{DynamicResource MutedBrush}"
					Text="URL" />

				<TextBox
					x:Name="UrlTextBox"
					Margin="0,0,0,0"
					Text="{Binding Url, UpdateSourceTrigger=PropertyChanged}"
					TextWrapping="NoWrap"
					VerticalScrollBarVisibility="Disabled" />

				<TextBlock
					Margin="0,4,0,12"
					Style="{StaticResource ValidationErrorText}"
					Text="{Binding UrlErrorMessage, StringFormat=⚠ {0}}"
					Visibility="{Binding UrlErrorMessage, Converter={StaticResource NullOrEmptyToVis}}" />

				<!--  Password  -->
				<Border
					Margin="0,12,0,10"
					Padding="0,0,0,8"
					BorderBrush="{DynamicResource BorderBrush}"
					BorderThickness="0,0,0,1">
					<TextBlock
						FontSize="{DynamicResource AppFontSize13}"
						FontWeight="SemiBold"
						Foreground="{DynamicResource TextBrush}"
						Text="Password" />
				</Border>

				<!--  Password input  -->
				<controls:PasswordRevealBox
					x:Name="PasswordBox"
					Margin="0,0,0,8"
					PasswordChanged="PasswordBox_PasswordChanged" />

				<Button
					Margin="0,0,0,16"
					Padding="14,7"
					HorizontalAlignment="Left"
					Command="{Binding OpenAdvancedGeneratorCommand}"
					Content="Generate password"
					Style="{StaticResource SecondaryButton}"
					ToolTip="Generate a password and customize its options" />

				<!--  Password Strength  -->
				<controls:PasswordStrengthIndicator
					Margin="0,0,0,20"
					StrengthLabel="{Binding PasswordStrengthLabel}"
					StrengthLevel="{Binding PasswordStrengthLevel}"
					StrengthProgress="{Binding PasswordStrengthProgress}" />

				<!--  Two-factor authentication  -->
				<Border
					Margin="0,12,0,10"
					Padding="0,0,0,8"
					BorderBrush="{DynamicResource BorderBrush}"
					BorderThickness="0,0,0,1">
					<TextBlock
						FontSize="{DynamicResource AppFontSize13}"
						FontWeight="SemiBold"
						Foreground="{DynamicResource TextBrush}"
						Text="Two-factor authentication" />
				</Border>

				<TextBlock
					Margin="0,0,0,6"
					Foreground="{DynamicResource MutedBrush}"
					Text="TOTP Secret (Base32)" />

				<controls:PasswordRevealBox
					x:Name="TotpSecretBox"
					Margin="0,0,0,6"
					PasswordChanged="TotpSecretBox_PasswordChanged"
					ToolTip="Paste the authenticator secret key (Base32). Leave empty to disable TOTP." />

				<TextBlock
					Margin="0,0,0,6"
					FontSize="{DynamicResource AppFontSize12}"
					FontWeight="SemiBold"
					Foreground="{DynamicResource MutedBrush}"
					Text="Import QR code" />

				<StackPanel Margin="0,0,0,6" Orientation="Horizontal">
					<Button
						Height="32"
						Margin="0,0,8,0"
						Padding="12,6"
						Background="{DynamicResource SurfaceAltBrush}"
						Command="{Binding ImportTotpFromFileCommand}"
						Content="From image"
						Foreground="{DynamicResource TextBrush}"
						Style="{StaticResource SecondaryButton}"
						ToolTip="Import a QR code from an image file" />
					<Button
						Height="32"
						Padding="12,6"
						Background="{DynamicResource SurfaceAltBrush}"
						Command="{Binding ImportTotpFromClipboardCommand}"
						Content="From clipboard"
						Foreground="{DynamicResource TextBrush}"
						Style="{StaticResource SecondaryButton}"
						ToolTip="Import a QR code image from the clipboard" />
				</StackPanel>

				<TextBlock
					Style="{StaticResource ValidationErrorText}"
					Text="{Binding TotpErrorMessage, StringFormat=⚠ {0}}"
					Visibility="{Binding TotpErrorMessage, Converter={StaticResource NullOrEmptyToVis}}" />

				<TextBlock
					Margin="0,0,0,20"
					FontSize="{DynamicResource AppFontSize11}"
					Foreground="{DynamicResource MutedBrush}"
					Text="Optional — used to generate 2FA codes in the main window" />

				<!--  Tags  -->
				<Border
					Margin="0,12,0,10"
					Padding="0,0,0,8"
					BorderBrush="{DynamicResource BorderBrush}"
					BorderThickness="0,0,0,1">
					<TextBlock
						FontSize="{DynamicResource AppFontSize13}"
						FontWeight="SemiBold"
						Foreground="{DynamicResource TextBrush}"
						Text="Tags" />
				</Border>

				<TextBox
					x:Name="TagsTextBox"
					Margin="0,0,0,6"
					Text="{Binding TagsText, UpdateSourceTrigger=PropertyChanged}"
					TextWrapping="NoWrap"
					VerticalScrollBarVisibility="Disabled" />

				<controls:TagChipStrip
					Margin="0,0,0,20"
					ChipCommand="{Binding ToggleSuggestedTagCommand}"
					ItemsSource="{Binding SuggestedTags}" />

				<!--  Additional information  -->
				<Border
					Margin="0,12,0,10"
					Padding="0,0,0,8"
					BorderBrush="{DynamicResource BorderBrush}"
					BorderThickness="0,0,0,1">
					<TextBlock
						FontSize="{DynamicResource AppFontSize13}"
						FontWeight="SemiBold"
						Foreground="{DynamicResource TextBrush}"
						Text="Additional information" />
				</Border>

				<!--  Custom Fields  -->
				<Grid Margin="0,0,0,8">
					<Grid.ColumnDefinitions>
						<ColumnDefinition Width="*" />
						<ColumnDefinition Width="Auto" />
					</Grid.ColumnDefinitions>

					<TextBlock
						VerticalAlignment="Center"
						FontSize="{DynamicResource AppFontSize12}"
						FontWeight="SemiBold"
						Foreground="{DynamicResource MutedBrush}"
						Text="Custom Fields" />

					<Button
						Grid.Column="1"
						Height="32"
						Padding="10,4"
						Command="{Binding AddCustomFieldCommand}"
						Content="+ Add Field"
						FontSize="{DynamicResource AppFontSize12}"
						Style="{StaticResource SecondaryButton}" />
				</Grid>

				<ItemsControl
					x:Name="CustomFieldsItemsControl"
					Margin="0,0,0,20"
					ItemsSource="{Binding CustomFields}">
					<ItemsControl.ItemTemplate>
						<DataTemplate>
							<Grid Margin="0,0,0,6">
								<Grid.RowDefinitions>
									<RowDefinition Height="40" />
									<RowDefinition Height="Auto" />
								</Grid.RowDefinitions>
								<Grid.ColumnDefinitions>
									<ColumnDefinition Width="120" />
									<ColumnDefinition Width="*" />
									<ColumnDefinition Width="Auto" />
									<ColumnDefinition Width="32" />
									<ColumnDefinition Width="32" />
									<ColumnDefinition Width="32" />
								</Grid.ColumnDefinitions>

								<TextBox
									Grid.Row="0"
									Margin="0,0,6,0"
									Text="{Binding Name, UpdateSourceTrigger=PropertyChanged}"
									TextWrapping="NoWrap"
									ToolTip="Field name"
									VerticalScrollBarVisibility="Disabled" />

								<Grid Grid.Row="0" Grid.Column="1">
									<TextBox
										Margin="2,0,6,0"
										Text="{Binding Value, UpdateSourceTrigger=PropertyChanged}"
										TextWrapping="NoWrap"
										ToolTip="Field value"
										VerticalScrollBarVisibility="Disabled">
										<TextBox.Style>
											<Style BasedOn="{StaticResource {x:Type TextBox}}" TargetType="TextBox">
												<Style.Triggers>
													<DataTrigger Binding="{Binding IsSecret}" Value="True">
														<Setter Property="Visibility" Value="Collapsed" />
													</DataTrigger>
												</Style.Triggers>
											</Style>
										</TextBox.Style>
									</TextBox>

									<controls:PasswordRevealBox Margin="2,0,6,0" Password="{Binding Value, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}">
										<controls:PasswordRevealBox.Style>
											<Style TargetType="controls:PasswordRevealBox">
												<Setter Property="Visibility" Value="Collapsed" />
												<Style.Triggers>
													<DataTrigger Binding="{Binding IsSecret}" Value="True">
														<Setter Property="Visibility" Value="Visible" />
													</DataTrigger>
												</Style.Triggers>
											</Style>
										</controls:PasswordRevealBox.Style>
									</controls:PasswordRevealBox>
								</Grid>

								<CheckBox
									Grid.Row="0"
									Grid.Column="2"
									Margin="4,0,10,0"
									VerticalAlignment="Center"
									Content="Secret"
									Foreground="{DynamicResource MutedBrush}"
									IsChecked="{Binding IsSecret}"
									ToolTip="Hide value in the main window like a password" />

								<Button
									Grid.Row="0"
									Grid.Column="3"
									Width="32"
									Height="32"
									Padding="0"
									Command="{Binding DataContext.MoveCustomFieldUpCommand, RelativeSource={RelativeSource AncestorType=Window}}"
									CommandParameter="{Binding}"
									Content="▲"
									Style="{StaticResource CustomFieldMoveButton}"
									ToolTip="Move field up" />

								<Button
									Grid.Row="0"
									Grid.Column="4"
									Width="32"
									Height="32"
									Margin="2,0,0,0"
									Padding="0"
									Command="{Binding DataContext.MoveCustomFieldDownCommand, RelativeSource={RelativeSource AncestorType=Window}}"
									CommandParameter="{Binding}"
									Content="▼"
									Style="{StaticResource CustomFieldMoveButton}"
									ToolTip="Move field down" />

								<Button
									Grid.Row="0"
									Grid.Column="5"
									Height="32"
									Margin="2,0,0,0"
									Padding="8,4"
									Background="{DynamicResource DangerBrush}"
									Command="{Binding DataContext.RemoveCustomFieldCommand, RelativeSource={RelativeSource AncestorType=Window}}"
									CommandParameter="{Binding}"
									Content="✕"
									ToolTip="Remove field" />
								<TextBlock
									Grid.Row="1"
									Grid.Column="0"
									Grid.ColumnSpan="6"
									Margin="0,4,0,0"
									FontSize="{DynamicResource AppFontSize11}"
									Foreground="{DynamicResource DangerBrush}"
									Text="{Binding ErrorMessage, StringFormat=⚠ {0}}"
									TextWrapping="Wrap"
									Visibility="{Binding ErrorMessage, Converter={StaticResource NullOrEmptyToVis}}" />
							</Grid>
						</DataTemplate>
					</ItemsControl.ItemTemplate>
				</ItemsControl>

				<!--  Notes  -->
				<TextBlock
					Margin="0,0,0,6"
					Foreground="{DynamicResource MutedBrush}"
					Text="Notes" />

				<TextBox
					Height="100"
					MaxHeight="160"
					VerticalContentAlignment="Top"
					AcceptsReturn="True"
					HorizontalScrollBarVisibility="Disabled"
					Text="{Binding Notes, UpdateSourceTrigger=PropertyChanged}"
					TextWrapping="Wrap"
					VerticalScrollBarVisibility="Auto" />

			</StackPanel>
		</ScrollViewer>

		<!--  Footer  -->
		<StackPanel
			Grid.Row="1"
			Margin="0,16,0,0"
			HorizontalAlignment="Right"
			Orientation="Horizontal">

			<Button
				Margin="0,0,8,0"
				Background="{DynamicResource SurfaceBrush}"
				Click="Cancel_Click"
				Content="Cancel"
				Foreground="{DynamicResource TextBrush}"
				IsCancel="True"
				Style="{StaticResource SecondaryButton}" />

			<Button
				Click="Save_Click"
				Content="Save"
				IsDefault="True"
				Style="{StaticResource PrimaryButton}" />
		</StackPanel>
	</Grid>
</Window>
