<Window x:Class="PejPass.Wpf.Views.EntryEditorWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Entry" Height="620" Width="520"
        WindowStartupLocation="CenterOwner"
        ResizeMode="CanResizeWithGrip"
        MinHeight="500" MinWidth="460"
        Background="{StaticResource BgBrush}">

    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <ScrollViewer 
            Padding="0,0,16,0"
            VerticalScrollBarVisibility="Auto">
            <StackPanel>
                <TextBlock Text="Title" Foreground="{StaticResource MutedBrush}" Margin="0,0,0,4"/>
                <TextBox Text="{Binding Title, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,0,12"/>

                <TextBlock Text="Username" Foreground="{StaticResource MutedBrush}" Margin="0,0,0,4"/>
                <TextBox Text="{Binding Username, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,0,12"/>

                <TextBlock Text="Password" Foreground="{StaticResource MutedBrush}" Margin="0,0,0,4"/>
                <Grid Margin="0,0,0,12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBox Text="{Binding Password, UpdateSourceTrigger=PropertyChanged}"/>
                    <Button Grid.Column="1" Content="Generate" Margin="8,0,0,0"
                            Command="{Binding GeneratePasswordCommand}" Padding="12,6"/>
                </Grid>

                <TextBlock Text="URL" Foreground="{StaticResource MutedBrush}" Margin="0,0,0,4"/>
                <TextBox Text="{Binding Url, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,0,12"/>

                <TextBlock Text="Tags (comma separated)" Foreground="{StaticResource MutedBrush}" Margin="0,0,0,4"/>
                <TextBox Text="{Binding TagsText, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,0,12"/>

                <!-- Custom Fields -->
                <Grid Margin="0,8,0,4">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="Custom Fields" Foreground="{StaticResource MutedBrush}"
                               VerticalAlignment="Center"/>
                    <Button Grid.Column="1" Content="+ Add Field"
                            Command="{Binding AddCustomFieldCommand}"
                            Padding="10,4" FontSize="12"/>
                </Grid>

                <ItemsControl ItemsSource="{Binding CustomFields}" Margin="0,0,0,12">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Grid Margin="0,0,0,8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="140"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>

                                <TextBox Text="{Binding Name, UpdateSourceTrigger=PropertyChanged}"
                                         ToolTip="Field name" Margin="0,0,6,0"/>
                                <TextBox Grid.Column="1"
                                         Text="{Binding Value, UpdateSourceTrigger=PropertyChanged}"
                                         ToolTip="Field value" Margin="0,0,6,0"/>
                                <Button Grid.Column="2" Content="✕"
                                        Command="{Binding DataContext.RemoveCustomFieldCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                        CommandParameter="{Binding}"
                                        Padding="8,4"
                                        Background="{StaticResource DangerBrush}"
                                        ToolTip="Remove field"/>
                            </Grid>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

                <TextBlock Text="Notes" Foreground="{StaticResource MutedBrush}" Margin="0,0,0,4"/>
                <TextBox Text="{Binding Notes, UpdateSourceTrigger=PropertyChanged}"
                         Height="80" TextWrapping="Wrap" AcceptsReturn="True"
                         VerticalScrollBarVisibility="Auto"/>
            </StackPanel>
        </ScrollViewer>

        <StackPanel Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0">
            <Button Content="Cancel" Click="Cancel_Click" Margin="0,0,8,0"
                    Background="{StaticResource SurfaceBrush}" Foreground="{StaticResource TextBrush}"/>
            <Button Content="Save" Click="Save_Click" IsDefault="True"/>
        </StackPanel>
    </Grid>
</Window>
