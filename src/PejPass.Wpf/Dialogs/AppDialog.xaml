<Window
	x:Class="PejPass.Wpf.Dialogs.AppDialog"
	xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
	xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
	xmlns:controls="clr-namespace:PejPass.Wpf.Controls"
	Title="PejPass"
	Width="440"
	Background="{DynamicResource BgBrush}"
	ResizeMode="NoResize"
	ShowInTaskbar="False"
	SizeToContent="Height"
	WindowStartupLocation="CenterOwner">

	<DockPanel>
		<controls:AppTitleBar
			DockPanel.Dock="Top"
			ShowMaximize="false"
			ShowMinimize="false" />

		<Border
			Padding="24"
			Background="{DynamicResource SurfaceBrush}"
			BorderBrush="{DynamicResource BorderBrush}"
			BorderThickness="1"
			CornerRadius="0">
			<StackPanel>
				<ScrollViewer
					MaxHeight="420"
					HorizontalScrollBarVisibility="Disabled"
					VerticalScrollBarVisibility="Auto">
					<StackPanel>
						<Grid Margin="0,0,0,10">
							<Grid.ColumnDefinitions>
								<ColumnDefinition Width="40" />
								<ColumnDefinition Width="*" />
							</Grid.ColumnDefinitions>

							<Path
								x:Name="TypeIcon"
								Width="28"
								Height="28"
								Margin="0,2,12,0"
								VerticalAlignment="Top"
								Data="M16,2 C23.732,2 30,8.268 30,16 C30,23.732 23.732,30 16,30 C8.268,30 2,23.732 2,16 C2,8.268 8.268,2 16,2 Z M16,13 L16,22 M16,8 L16,8.1"
								Stretch="Uniform"
								Stroke="{DynamicResource AccentBrush}"
								StrokeEndLineCap="Round"
								StrokeLineJoin="Round"
								StrokeStartLineCap="Round"
								StrokeThickness="2.2" />

							<TextBlock
								x:Name="TitleText"
								Grid.Column="1"
								VerticalAlignment="Top"
								FontSize="{DynamicResource AppFontSize18}"
								FontWeight="Bold"
								Foreground="{DynamicResource TextBrush}"
								TextWrapping="Wrap" />
						</Grid>

						<TextBlock
							x:Name="MessageText"
							Margin="0,0,0,24"
							FontSize="{DynamicResource AppFontSize14}"
							Foreground="{DynamicResource MutedBrush}"
							TextWrapping="Wrap" />
					</StackPanel>
				</ScrollViewer>

				<StackPanel HorizontalAlignment="Right" Orientation="Horizontal">
					<Button
						x:Name="TertiaryButton"
						Margin="0,0,8,0"
						Padding="16,8"
						Click="Tertiary_Click"
						Content="Cancel"
						IsCancel="True"
						Style="{StaticResource SecondaryButton}"
						Visibility="Collapsed" />
					<Button
						x:Name="SecondaryButton"
						Margin="0,0,8,0"
						Padding="16,8"
						Click="Secondary_Click"
						Content="No"
						Style="{StaticResource SecondaryButton}"
						Visibility="Collapsed" />
					<Button
						x:Name="PrimaryButton"
						Padding="16,8"
						Click="Primary_Click"
						Content="OK"
						IsDefault="True"
						Style="{StaticResource PrimaryButton}" />
				</StackPanel>
			</StackPanel>
		</Border>
	</DockPanel>
</Window>
