<UserControl x:Class="PejPass.Wpf.Controls.PasswordStrengthIndicator"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <StackPanel>

        <TextBlock Text="{Binding StrengthLabel, RelativeSource={RelativeSource AncestorType=UserControl}}"
                   FontSize="11"
                   FontWeight="SemiBold"
                   Margin="0,0,0,6">

            <TextBlock.Style>
                <Style TargetType="TextBlock">
                    <Setter Property="Foreground"
                            Value="{DynamicResource MutedBrush}"/>

                    <Style.Triggers>

                        <DataTrigger Binding="{Binding StrengthLevel, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                     Value="1">
                            <Setter Property="Foreground"
                                    Value="{DynamicResource DangerBrush}"/>
                        </DataTrigger>

                        <DataTrigger Binding="{Binding StrengthLevel, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                     Value="2">
                            <Setter Property="Foreground"
                                    Value="{DynamicResource DangerBrush}"/>
                        </DataTrigger>

                        <DataTrigger Binding="{Binding StrengthLevel, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                     Value="3">
                            <Setter Property="Foreground"
                                    Value="{DynamicResource WarningBrush}"/>
                        </DataTrigger>

                        <DataTrigger Binding="{Binding StrengthLevel, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                     Value="4">
                            <Setter Property="Foreground"
                                    Value="{DynamicResource SuccessBrush}"/>
                        </DataTrigger>

                        <DataTrigger Binding="{Binding StrengthLevel, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                     Value="5">
                            <Setter Property="Foreground"
                                    Value="{DynamicResource SuccessBrush}"/>
                        </DataTrigger>

                    </Style.Triggers>
                </Style>
            </TextBlock.Style>

        </TextBlock>

        <ProgressBar Height="6"
                     Minimum="0"
                     Maximum="100"
                     Value="{Binding StrengthProgress, RelativeSource={RelativeSource AncestorType=UserControl}}"
                     Background="{DynamicResource SurfaceAltBrush}"/>

    </StackPanel>

</UserControl>
