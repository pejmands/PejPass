<UserControl x:Class="PejPass.Wpf.Controls.PasswordRevealBox"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Height="40">
    <Grid>
        <PasswordBox x:Name="PasswordBox"
                     PasswordChanged="PasswordBox_PasswordChanged"
                     Padding="10,8,36,8"
                     FontFamily="{Binding FontFamily, RelativeSource={RelativeSource AncestorType=UserControl}}"
                     FontSize="{Binding FontSize, RelativeSource={RelativeSource AncestorType=UserControl}}"/>

        <TextBox x:Name="TextBox"
                 TextChanged="TextBox_TextChanged"
                 Padding="10,8,36,8"
                 VerticalContentAlignment="Center"
                 FontFamily="{Binding FontFamily, RelativeSource={RelativeSource AncestorType=UserControl}}"
                 FontSize="{Binding FontSize, RelativeSource={RelativeSource AncestorType=UserControl}}"
                 Visibility="Collapsed"/>

        <ToggleButton x:Name="VisibilityButton"
              Content="&#xE890;"
              Click="VisibilityButton_Click"
              PreviewKeyDown="VisibilityButton_PreviewKeyDown"
              PreviewMouseLeftButtonDown="VisibilityButton_PreviewMouseLeftButtonDown"
              IsChecked="{Binding IsRevealed, RelativeSource={RelativeSource AncestorType=UserControl}, Mode=OneWay}"
              Width="32"
              Height="32"
              HorizontalAlignment="Right"
              VerticalAlignment="Center"
              Margin="0,0,4,0"
              Padding="0"
              FontFamily="Segoe MDL2 Assets"
              FontSize="{DynamicResource AppFontSize15}"
              FontWeight="Normal"
              Foreground="{DynamicResource AccentBrush}"
              Background="Transparent"
              BorderThickness="1"
              BorderBrush="Transparent"
              Cursor="Hand"
              Visibility="{Binding ShowRevealButton, RelativeSource={RelativeSource AncestorType=UserControl}, Converter={StaticResource BoolToVis}}"
              Template="{StaticResource PasswordRevealButtonTemplate}"/>
    </Grid>
</UserControl>
