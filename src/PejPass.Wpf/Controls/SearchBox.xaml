<UserControl
	x:Class="PejPass.Wpf.Controls.SearchBox"
	xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
	xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
	Height="40"
	MinHeight="40">
	<Grid>
		<TextBox
			x:Name="InputBox"
			Padding="10,8,32,8"
			VerticalContentAlignment="Center"
			PreviewKeyDown="InputBox_PreviewKeyDown"
			Text="{Binding Text, RelativeSource={RelativeSource AncestorType=UserControl}, UpdateSourceTrigger=PropertyChanged}" />

		<TextBlock
			Margin="12,0,36,0"
			VerticalAlignment="Center"
			Foreground="{DynamicResource MutedBrush}"
			IsHitTestVisible="False"
			Text="{Binding Placeholder, RelativeSource={RelativeSource AncestorType=UserControl}}"
			Visibility="{Binding Text, RelativeSource={RelativeSource AncestorType=UserControl}, Converter={StaticResource EmptyStringToVis}}" />

		<Button
			Width="32"
			Height="32"
			Margin="0,0,8,0"
			Padding="0"
			HorizontalAlignment="Right"
			VerticalAlignment="Center"
			Background="{DynamicResource SurfaceAltBrush}"
			BorderThickness="0"
			Click="ClearButton_Click"
			Content="✕"
			Cursor="Hand"
			FontSize="{DynamicResource AppFontSize11}"
			Foreground="{DynamicResource TextBrush}"
			ToolTip="Clear"
			Visibility="{Binding Text, RelativeSource={RelativeSource AncestorType=UserControl}, Converter={StaticResource NullOrEmptyToVis}}" />
	</Grid>
</UserControl>
