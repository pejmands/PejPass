<UserControl x:Class="PejPass.Wpf.Controls.AppTitleBar"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
             Height="40"
             MinHeight="40"
             Background="{DynamicResource SurfaceBrush}">

    <UserControl.ContextMenu>
        <ContextMenu x:Name="TitleBarContextMenu"
                     Style="{StaticResource PejPassContextMenu}"
                     Opened="TitleBarContextMenu_Opened">
            <MenuItem x:Name="RestoreMenuItem"
                      Style="{StaticResource PejPassContextMenuItem}"
                      Header="Restore"
                      Click="RestoreMenuItem_Click"/>
            <MenuItem x:Name="MinimizeMenuItem"
                      Style="{StaticResource PejPassContextMenuItem}"
                      Header="Minimize"
                      Click="MinimizeMenuItem_Click"/>
            <MenuItem x:Name="MaximizeMenuItem"
                      Style="{StaticResource PejPassContextMenuItem}"
                      Header="Maximize"
                      Click="MaximizeMenuItem_Click"/>
            <Separator x:Name="TitleBarSeparator"
                       Style="{StaticResource PejPassContextMenuSeparator}"/>
            <MenuItem x:Name="CopyFilePathMenuItem"
                      Style="{StaticResource PejPassContextMenuItem}"
                      Header="Copy file path"
                      Click="CopyFilePathMenuItem_Click"/>
            <MenuItem x:Name="CloseMenuItem"
                      Style="{StaticResource PejPassContextMenuItem}"
                      Header="Close"
                      Click="CloseMenuItem_Click"/>
        </ContextMenu>
    </UserControl.ContextMenu>

    <Border BorderBrush="{DynamicResource BorderBrush}"
            BorderThickness="0,0,0,1"
            Background="{DynamicResource SurfaceBrush}"
            shell:WindowChrome.IsHitTestVisibleInChrome="True"
            PreviewMouseRightButtonDown="TitleBar_PreviewMouseRightButtonDown">
        <Grid Margin="12,0,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <TextBlock x:Name="TitleText"
                       Text="{Binding Title, RelativeSource={RelativeSource AncestorType=UserControl}}"
                       VerticalAlignment="Center"
                       FontSize="13"
                       FontWeight="SemiBold"
                       Foreground="{DynamicResource TextBrush}"
                       TextTrimming="CharacterEllipsis"
                       ToolTip="{Binding FilePath, RelativeSource={RelativeSource AncestorType=UserControl}}"
                       IsHitTestVisible="False"
                       Margin="0,0,8,0"/>

            <StackPanel Grid.Column="1" Orientation="Horizontal">

                <Button x:Name="MinButton"
                        IsTabStop="False"
                        Click="Minimize_Click"
                        Width="46" Height="40"
                        shell:WindowChrome.IsHitTestVisibleInChrome="True"
                        ToolTip="Minimize">
                    <Button.Template>
                        <ControlTemplate TargetType="Button">
                            <Border x:Name="Bd" Background="Transparent">
                                <Path Data="M0,0 H10"
                                      Stroke="{DynamicResource TextBrush}"
                                      StrokeThickness="1.2"
                                      HorizontalAlignment="Center" VerticalAlignment="Center"
                                      Width="10" Height="1" Stretch="Fill"/>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="Bd" Property="Background" Value="{DynamicResource SurfaceAltBrush}"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Button.Template>
                </Button>

                <Button x:Name="MaxButton"
                        IsTabStop="False"
                        Click="Maximize_Click"
                        Width="46" Height="40"
                        shell:WindowChrome.IsHitTestVisibleInChrome="True"
                        ToolTip="Maximize">
                    <Button.Template>
                        <ControlTemplate TargetType="Button">
                            <Border x:Name="Bd" Background="Transparent">
                                <Path x:Name="MaxIcon"
                                      Data="M0,0 H9 V9 H0 Z"
                                      Stroke="{DynamicResource TextBrush}"
                                      StrokeThickness="1.2"
                                      Fill="Transparent"
                                      HorizontalAlignment="Center" VerticalAlignment="Center"
                                      Width="10" Height="10" Stretch="Uniform"/>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="Bd" Property="Background" Value="{DynamicResource SurfaceAltBrush}"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Button.Template>
                </Button>

                <Button x:Name="CloseButton"
                        IsTabStop="False"
                        Click="Close_Click"
                        Width="46" Height="40"
                        shell:WindowChrome.IsHitTestVisibleInChrome="True"
                        ToolTip="Close">
                    <Button.Template>
                        <ControlTemplate TargetType="Button">
                            <Border x:Name="Bd" Background="Transparent">
                                <Path Data="M0,0 L8,8 M8,0 L0,8"
                                      Stroke="{DynamicResource TextBrush}"
                                      StrokeThickness="1.2"
                                      StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                                      HorizontalAlignment="Center" VerticalAlignment="Center"
                                      Width="10" Height="10" Stretch="Uniform"/>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="Bd" Property="Background" Value="{DynamicResource DangerBrush}"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Button.Template>
                </Button>
            </StackPanel>
        </Grid>
    </Border>
</UserControl>
