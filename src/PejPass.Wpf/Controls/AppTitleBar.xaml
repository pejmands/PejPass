<UserControl
	x:Class="PejPass.Wpf.Controls.AppTitleBar"
	xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
	xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
	xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
	Height="40"
	MinHeight="40"
	Background="{DynamicResource SurfaceBrush}">

	<!--  Custom title-bar menu (themed). System drag / double-click maximize stay with WindowChrome.  -->
	<UserControl.ContextMenu>
		<ContextMenu
			x:Name="TitleBarContextMenu"
			Opened="TitleBarContextMenu_Opened"
			Style="{StaticResource PejPassContextMenu}">
			<MenuItem
				x:Name="RestoreMenuItem"
				Click="RestoreMenuItem_Click"
				Header="Restore"
				Style="{StaticResource PejPassContextMenuItem}" />

			<MenuItem
				x:Name="MinimizeMenuItem"
				Click="MinimizeMenuItem_Click"
				Header="Minimize"
				Style="{StaticResource PejPassContextMenuItem}" />

			<MenuItem
				x:Name="MaximizeMenuItem"
				Click="MaximizeMenuItem_Click"
				Header="Maximize"
				Style="{StaticResource PejPassContextMenuItem}" />

			<Separator x:Name="TitleBarSeparator" Style="{StaticResource PejPassContextMenuSeparator}" />

			<MenuItem
				x:Name="CopyFilePathMenuItem"
				Click="CopyFilePathMenuItem_Click"
				Header="Copy file path"
				Style="{StaticResource PejPassContextMenuItem}" />

			<MenuItem
				x:Name="OpenFileLocationMenuItem"
				Click="OpenFileLocationMenuItem_Click"
				Header="Open file location"
				Style="{StaticResource PejPassContextMenuItem}" />

			<Separator x:Name="FileActionsSeparator" Style="{StaticResource PejPassContextMenuSeparator}" />

			<MenuItem
				x:Name="CloseMenuItem"
				Click="CloseMenuItem_Click"
				Header="Close"
				InputGestureText="Alt+F4"
				Style="{StaticResource PejPassContextMenuItem}" />
		</ContextMenu>
	</UserControl.ContextMenu>

	<!--
		No IsHitTestVisibleInChrome on the caption surface so WindowChrome owns drag + double-click maximize.
		Only the chrome buttons opt into hit-testing.
	-->
	<Border
		Background="{DynamicResource SurfaceBrush}"
		BorderBrush="{DynamicResource BorderBrush}"
		BorderThickness="0,0,0,1">
		<Grid Margin="12,0,0,0">
			<Grid.ColumnDefinitions>
				<ColumnDefinition Width="*" />
				<ColumnDefinition Width="Auto" />
			</Grid.ColumnDefinitions>

			<Grid x:Name="TitleTextHost" ClipToBounds="True">
				<TextBlock
					x:Name="TitleText"
					MaxWidth="{Binding ActualWidth, ElementName=TitleTextHost}"
					Margin="0,0,8,0"
					HorizontalAlignment="Left"
					VerticalAlignment="Center"
					shell:WindowChrome.IsHitTestVisibleInChrome="True"
					FontSize="{DynamicResource AppFontSize13}"
					FontWeight="SemiBold"
					Foreground="{DynamicResource TextBrush}"
					PreviewMouseLeftButtonDown="TitleText_PreviewMouseLeftButtonDown"
					Text="{Binding Title, RelativeSource={RelativeSource AncestorType=UserControl}}"
					TextTrimming="CharacterEllipsis"
					ToolTipService.IsEnabled="{Binding ShowFilePathToolTip, RelativeSource={RelativeSource AncestorType=UserControl}}"
					ToolTipService.ToolTip="{Binding FilePath, RelativeSource={RelativeSource AncestorType=UserControl}}" />
			</Grid>

			<StackPanel Grid.Column="1" Orientation="Horizontal">

				<StackPanel
					x:Name="MainActionsPanel"
					Orientation="Horizontal"
					Visibility="Collapsed">
					<Button
						x:Name="LockButton"
						Width="40"
						Height="40"
						Margin="2,0"
						shell:WindowChrome.IsHitTestVisibleInChrome="True"
						Command="{Binding DataContext.LockCommand, RelativeSource={RelativeSource AncestorType=Window}}"
						Content="&#xE72E;"
						Style="{StaticResource ToolbarIconButton}"
						ToolTip="Lock vault (Ctrl+L)" />

					<Button
						x:Name="MoreActionsButton"
						Width="40"
						Height="40"
						Margin="2,0"
						shell:WindowChrome.IsHitTestVisibleInChrome="True"
						Click="MoreActionsButton_Click"
						Content="&#xE712;"
						PreviewMouseRightButtonDown="MoreActionsButton_OnPreviewMouseRightButtonDown"
						Style="{StaticResource ToolbarIconButton}"
						ToolTip="More actions">
						<Button.ContextMenu>
							<ContextMenu
								x:Name="MoreActionsMenu"
								DataContext="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource Self}}"
								Placement="Bottom"
								Style="{StaticResource PejPassContextMenu}"
								VerticalOffset="6">

								<MenuItem
									Command="{Binding OpenHealthCommand}"
									Header="Vault Health"
									InputGestureText="Ctrl+H"
									Style="{StaticResource PejPassContextMenuItem}" />
								<MenuItem
									Command="{Binding OpenHistoryCommand}"
									Header="History"
									Style="{StaticResource PejPassContextMenuItem}" />
								<MenuItem
									Command="{Binding OpenTrashCommand}"
									Header="Trash"
									InputGestureText="Ctrl+Shift+T"
									Style="{StaticResource PejPassContextMenuItem}" />

								<Separator Style="{StaticResource PejPassContextMenuSeparator}" />

								<MenuItem
									Command="{Binding ExportBackupCommand}"
									Header="Backup"
									InputGestureText="Ctrl+B"
									Style="{StaticResource PejPassContextMenuItem}" />
								<MenuItem
									Command="{Binding RestoreBackupCommand}"
									Header="Restore"
									Style="{StaticResource PejPassContextMenuItem}" />

								<Separator Style="{StaticResource PejPassContextMenuSeparator}" />

								<MenuItem Header="Import" Style="{StaticResource PejPassContextMenuItem}">
									<MenuItem
										Command="{Binding ImportCommand}"
										Header="Browser CSV"
										Style="{StaticResource PejPassContextMenuItem}" />
									<MenuItem
										Command="{Binding ImportPejPassCsvCommand}"
										Header="PejPass CSV"
										Style="{StaticResource PejPassContextMenuItem}" />
								</MenuItem>

								<MenuItem Header="Export" Style="{StaticResource PejPassContextMenuItem}">
									<MenuItem
										Command="{Binding ExportCsvCommand}"
										Header="Browser CSV"
										Style="{StaticResource PejPassContextMenuItem}" />
									<MenuItem
										Command="{Binding ExportPejPassCsvCommand}"
										Header="PejPass CSV"
										Style="{StaticResource PejPassContextMenuItem}" />
								</MenuItem>

								<Separator Style="{StaticResource PejPassContextMenuSeparator}" />

								<MenuItem
									Command="{Binding DeleteAllEntriesCommand}"
									Header="Delete All Entries"
									IsEnabled="{Binding HasEntries}"
									Style="{StaticResource PejPassContextMenuItem}" />

								<Separator Style="{StaticResource PejPassContextMenuSeparator}" />

								<MenuItem
									Command="{Binding OpenWhatsNewCommand}"
									Header="What's New"
									Style="{StaticResource PejPassContextMenuItem}" />

								<MenuItem
									Command="{Binding OpenAboutCommand}"
									Header="About PejPass"
									Style="{StaticResource PejPassContextMenuItem}" />
							</ContextMenu>
						</Button.ContextMenu>
					</Button>

					<Popup
						x:Name="MoreActionsPopup"
						AllowsTransparency="True"
						DataContext="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource Self}}"
						HorizontalOffset="0"
						Placement="Bottom"
						PlacementTarget="{Binding ElementName=MoreActionsButton}"
						StaysOpen="False"
						VerticalOffset="6">
						<Border Style="{StaticResource ToolbarOverflowBorder}">
							<StackPanel>
								<MenuItem
									Command="{Binding OpenHealthCommand}"
									Header="Vault Health"
									InputGestureText="Ctrl+H"
									Style="{StaticResource ToolbarMenuItem}" />
								<MenuItem
									Command="{Binding OpenHistoryCommand}"
									Header="History"
									Style="{StaticResource ToolbarMenuItem}" />
								<MenuItem
									Command="{Binding OpenTrashCommand}"
									Header="Trash"
									InputGestureText="Ctrl+Shift+T"
									Style="{StaticResource ToolbarMenuItem}" />
								<Separator Margin="4,5" Background="{DynamicResource BorderBrush}" />
								<MenuItem
									Command="{Binding ExportBackupCommand}"
									Header="Backup"
									InputGestureText="Ctrl+B"
									Style="{StaticResource ToolbarMenuItem}" />
								<MenuItem
									Command="{Binding RestoreBackupCommand}"
									Header="Restore"
									Style="{StaticResource ToolbarMenuItem}" />
								<Separator Margin="4,5" Background="{DynamicResource BorderBrush}" />
								<MenuItem
									Command="{Binding ImportCommand}"
									Header="Import Browser CSV"
									Style="{StaticResource ToolbarMenuItem}" />
								<MenuItem
									Command="{Binding ImportPejPassCsvCommand}"
									Header="Import PejPass CSV"
									Style="{StaticResource ToolbarMenuItem}" />
								<MenuItem
									Command="{Binding ExportCsvCommand}"
									Header="Export Browser CSV"
									Style="{StaticResource ToolbarMenuItem}" />
								<MenuItem
									Command="{Binding ExportPejPassCsvCommand}"
									Header="Export PejPass CSV"
									Style="{StaticResource ToolbarMenuItem}" />
								<Separator Margin="4,5" Background="{DynamicResource BorderBrush}" />
								<MenuItem
									Command="{Binding OpenAboutCommand}"
									Header="About PejPass"
									Style="{StaticResource ToolbarMenuItem}" />
							</StackPanel>
						</Border>
					</Popup>

					<Button
						x:Name="SettingsButton"
						Width="40"
						Height="40"
						Margin="2,0"
						shell:WindowChrome.IsHitTestVisibleInChrome="True"
						Command="{Binding DataContext.OpenSettingsCommand, RelativeSource={RelativeSource AncestorType=Window}}"
						Content="&#xE713;"
						Style="{StaticResource ToolbarIconButton}"
						ToolTip="Settings (Ctrl+S)" />
				</StackPanel>

				<Border
					x:Name="MainActionsSeparator"
					Width="1"
					Height="20"
					Margin="6,0,4,0"
					Background="{DynamicResource BorderBrush}"
					Visibility="Collapsed" />

				<Button
					x:Name="MinButton"
					Width="46"
					Height="40"
					shell:WindowChrome.IsHitTestVisibleInChrome="True"
					Click="Minimize_Click"
					IsTabStop="False"
					ToolTip="Minimize">
					<Button.Template>
						<ControlTemplate TargetType="Button">
							<Border x:Name="Bd" Background="Transparent">
								<Path
									Width="10"
									Height="1"
									HorizontalAlignment="Center"
									VerticalAlignment="Center"
									Data="M0,0 H10"
									Stretch="Fill"
									Stroke="{DynamicResource TextBrush}"
									StrokeThickness="1.2" />
							</Border>
							<ControlTemplate.Triggers>
								<Trigger Property="IsMouseOver" Value="True">
									<Setter TargetName="Bd" Property="Background" Value="{DynamicResource SurfaceAltBrush}" />
								</Trigger>
							</ControlTemplate.Triggers>
						</ControlTemplate>
					</Button.Template>
				</Button>

				<Button
					x:Name="MaxButton"
					Width="46"
					Height="40"
					shell:WindowChrome.IsHitTestVisibleInChrome="True"
					Click="Maximize_Click"
					IsTabStop="False"
					ToolTip="Maximize">
					<Button.Template>
						<ControlTemplate TargetType="Button">
							<Border x:Name="Bd" Background="Transparent">
								<Path
									x:Name="MaxIcon"
									Width="10"
									Height="10"
									HorizontalAlignment="Center"
									VerticalAlignment="Center"
									Data="M0,0 H9 V9 H0 Z"
									Fill="Transparent"
									Stretch="Uniform"
									Stroke="{DynamicResource TextBrush}"
									StrokeThickness="1.2" />
							</Border>
							<ControlTemplate.Triggers>
								<Trigger Property="IsMouseOver" Value="True">
									<Setter TargetName="Bd" Property="Background" Value="{DynamicResource SurfaceAltBrush}" />
								</Trigger>
							</ControlTemplate.Triggers>
						</ControlTemplate>
					</Button.Template>
				</Button>

				<Button
					x:Name="CloseButton"
					Width="46"
					Height="40"
					shell:WindowChrome.IsHitTestVisibleInChrome="True"
					Click="Close_Click"
					IsTabStop="False"
					ToolTip="Close">
					<Button.Template>
						<ControlTemplate TargetType="Button">
							<Border x:Name="Bd" Background="Transparent">
								<Path
									Width="10"
									Height="10"
									HorizontalAlignment="Center"
									VerticalAlignment="Center"
									Data="M0,0 L8,8 M8,0 L0,8"
									Stretch="Uniform"
									Stroke="{DynamicResource TextBrush}"
									StrokeEndLineCap="Round"
									StrokeStartLineCap="Round"
									StrokeThickness="1.2" />
							</Border>
							<ControlTemplate.Triggers>
								<Trigger Property="IsMouseOver" Value="True">
									<Setter TargetName="Bd" Property="Background" Value="{DynamicResource DangerBrush}" />
								</Trigger>
							</ControlTemplate.Triggers>
						</ControlTemplate>
					</Button.Template>
				</Button>
			</StackPanel>
		</Grid>
	</Border>
</UserControl>
