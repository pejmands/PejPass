<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows10.0.19041.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <LangVersion>latest</LangVersion>
    <AssemblyName>PejPass</AssemblyName>
    <RootNamespace>PejPass.Wpf</RootNamespace>
    <Platforms>x64</Platforms>
    <ApplicationIcon>Assets\PejPass.ico</ApplicationIcon>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>

    <!-- Single place to bump the product version (File Properties + About). -->
    <Version>1.0.0</Version>
    <AssemblyVersion>1.0.0.0</AssemblyVersion>
    <FileVersion>1.0.0.0</FileVersion>
    <InformationalVersion>1.0.0</InformationalVersion>
    <Product>PejPass</Product>
    <Company>PejPass</Company>
    <Authors>pejmands</Authors>
  </PropertyGroup>

  <ItemGroup>
    <None Remove="Assets\PejPass.ico" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="CommunityToolkit.Mvvm" Version="8.4.2" />
    <PackageReference Include="Microsoft.Extensions.DependencyInjection" Version="10.0.12" />
    <PackageReference Include="ZXing.Net" Version="0.16.11" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\PejPass.Application\PejPass.Application.csproj" />
    <ProjectReference Include="..\PejPass.Infrastructure\PejPass.Infrastructure.csproj" />
    <ProjectReference Include="..\PejPass.Domain\PejPass.Domain.csproj" />
  </ItemGroup>

  <ItemGroup>
    <Resource Include="Assets\PejPass.ico">
      <CopyToOutputDirectory>Never</CopyToOutputDirectory>
    </Resource>
  </ItemGroup>

</Project>
