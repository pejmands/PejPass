<Window x:Class="PejPass.Wpf.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="PejPass"
        Height="720" Width="1180"
        MinHeight="560" MinWidth="900"
        WindowStartupLocation="CenterScreen"
        Background="{DynamicResource BgBrush}">

    <Grid>
        <DockPanel>

        <!-- Header -->
        <Border DockPanel.Dock="Top"
                Background="{DynamicResource SurfaceBrush}"
                Padding="16,10">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="PejPass"
                               FontSize="20"
                               FontWeight="Bold"
                               Foreground="{DynamicResource TextBrush}"
                               VerticalAlignment="Center"/>
                    <Border Background="{DynamicResource SurfaceAltBrush}"
                            CornerRadius="4"
                            Padding="8,2"
                            Margin="12,0,0,0"
                            VerticalAlignment="Center">
                        <TextBlock Text="{Binding VaultName}"
                                   FontSize="12"
                                   Foreground="{DynamicResource MutedBrush}"/>
                    </Border>
                </StackPanel>

                <StackPanel Grid.Column="1"
                            Orientation="Horizontal"
                            VerticalAlignment="Center">
                    <Button Style="{StaticResource ToolbarIconButton}"
                            Content="&#xE713;"
                            Command="{Binding OpenSettingsCommand}"
                            Margin="0,0,6,0"
                            ToolTip="Settings (Ctrl+S)"/>
                    <Button Style="{StaticResource ToolbarIconButton}"
                            Content="&#xE95E;"
                            Command="{Binding OpenHealthCommand}"
                            Margin="0,0,6,0"
                            ToolTip="Vault health report (Ctrl+H)"/>
                    <Button Style="{StaticResource ToolbarIconButton}"
                            Content="&#xE81C;"
                            Command="{Binding OpenHistoryCommand}"
                            Margin="0,0,6,0"
                            ToolTip="Entry history"/>
                    <Button Style="{StaticResource ToolbarIconButton}"
                            Content="&#xE74D;"
                            Command="{Binding OpenTrashCommand}"
                            Margin="0,0,10,0"
                            ToolTip="Trash (Ctrl+Shift+T)"/>

                    <Border Width="1"
                            Height="22"
                            Background="{DynamicResource BorderBrush}"
                            Margin="0,0,10,0"/>

                    <Button x:Name="MoreActionsButton"
                            Style="{StaticResource ToolbarIconButton}"
                            Content="&#xE712;"
                            Margin="0,0,6,0"
                            ToolTip="More actions"
                            Click="MoreActionsButton_Click"
                            PreviewMouseRightButtonDown="MoreActionsButton_OnPreviewMouseRightButtonDown"/>
                    <Popup x:Name="MoreActionsPopup"
                           PlacementTarget="{Binding ElementName=MoreActionsButton}"
                           Placement="Bottom"
                           HorizontalOffset="0"
                           VerticalOffset="6"
                           StaysOpen="False"
                           AllowsTransparency="True"
                           DataContext="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource Self}}">
                        <Border Style="{StaticResource ToolbarOverflowBorder}">
                            <StackPanel>
                                <MenuItem Header="Backup"
                                          Command="{Binding ExportBackupCommand}"
                                          Style="{StaticResource ToolbarMenuItem}"/>
                                <MenuItem Header="Restore"
                                          Command="{Binding RestoreBackupCommand}"
                                          Style="{StaticResource ToolbarMenuItem}"/>
                                <Separator Margin="4,5"
                                           Background="{DynamicResource BorderBrush}"/>
                                <MenuItem Header="Import CSV"
                                          Command="{Binding ImportCommand}"
                                          Style="{StaticResource ToolbarMenuItem}"/>
                                <MenuItem Header="Export CSV"
                                          Command="{Binding ExportCsvCommand}"
                                          Style="{StaticResource ToolbarMenuItem}"/>
                            </StackPanel>
                        </Border>
                    </Popup>

                    <Button Style="{StaticResource ToolbarIconButton}"
                            Content="&#xE72E;"
                            Command="{Binding LockCommand}"
                            ToolTip="Lock vault (Ctrl+L)"/>
                </StackPanel>
            </Grid>
        </Border>

        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="340"
                                  MinWidth="280"
                                  MaxWidth="420"/>
                <ColumnDefinition Width="1"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- Entry List -->
            <DockPanel Grid.Column="0">

                <!-- Search -->
                <Border DockPanel.Dock="Top"
                        Padding="16,12">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <Grid Margin="0,0,8,0">
                            <TextBox x:Name="SearchBox"
                                     Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"
                                     VerticalContentAlignment="Center"
                                     Padding="10,8,32,8"
                                     ToolTip="Search (Ctrl+K)"/>

                            <TextBlock Text="Search entries…"
                                       Foreground="{DynamicResource MutedBrush}"
                                       IsHitTestVisible="False"
                                       Margin="12,0,36,0"
                                       VerticalAlignment="Center"
                                       Visibility="{Binding Text,
                                                            ElementName=SearchBox,
                                                            Converter={StaticResource EmptyStringToVis}}"/>

                            <Button Content="✕"
                                    Width="22"
                                    Height="22"
                                    VerticalAlignment="Center"
                                    HorizontalAlignment="Right"
                                    Margin="0,0,8,0"
                                    Padding="0"
                                    FontSize="11"
                                    Background="{DynamicResource SurfaceAltBrush}"
                                    Foreground="{DynamicResource TextBrush}"
                                    BorderThickness="0"
                                    Cursor="Hand"
                                    ToolTip="Clear"
                                    Command="{Binding ClearSearchCommand}"
                                    Visibility="{Binding Text,
                                                         ElementName=SearchBox,
                                                         Converter={StaticResource NullOrEmptyToVis}}"/>
                        </Grid>

                        <Button Grid.Column="1"
                                Content="Add Entry"
                                Command="{Binding AddEntryCommand}"
                                Height="40"
                                Padding="14,0"
                                FontSize="12"
                                FontWeight="SemiBold"
                                ToolTip="Add entry (Ctrl+N)"/>
                    </Grid>
                </Border>

                <!-- Tag Filters: single-row horizontal strip (does not grow with tag count) -->
                <ScrollViewer DockPanel.Dock="Top"
                              Margin="16,0,16,8"
                              Height="44"
                              HorizontalScrollBarVisibility="Auto"
                              VerticalScrollBarVisibility="Disabled"
                              Padding="0,0,0,2"
                              Visibility="{Binding ShowTagFilters, Converter={StaticResource BoolToVis}}">
                    <ItemsControl ItemsSource="{Binding TagFilters}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <StackPanel Orientation="Horizontal"/>
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>

                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Button Content="{Binding DisplayLabel}"
                                        Command="{Binding DataContext.SelectTagFilterCommand,
                                                          RelativeSource={RelativeSource AncestorType=Window}}"
                                        CommandParameter="{Binding}"
                                        Margin="0,0,6,0"
                                        Padding="11,0"
                                        Height="30"
                                        FontSize="12"
                                        FontWeight="SemiBold"
                                        Cursor="Hand"
                                        BorderThickness="1"
                                        ToolTip="Filter by tag (click again to clear)">
                                    <Button.Style>
                                        <Style TargetType="Button"
                                               BasedOn="{StaticResource {x:Type Button}}">
                                            <Setter Property="Background"
                                                    Value="{DynamicResource SurfaceBrush}"/>
                                            <Setter Property="Foreground"
                                                    Value="{DynamicResource MutedBrush}"/>
                                            <Setter Property="BorderBrush"
                                                    Value="{DynamicResource BorderBrush}"/>

                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsSelected}"
                                                             Value="True">
                                                    <Setter Property="Background"
                                                            Value="{DynamicResource AccentBrush}"/>
                                                    <Setter Property="Foreground"
                                                            Value="{DynamicResource ButtonTextBrush}"/>
                                                    <Setter Property="BorderBrush"
                                                            Value="{DynamicResource AccentBrush}"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Button.Style>
                                </Button>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>

                <!-- Count / Sort -->
                <Grid DockPanel.Dock="Top"
                      Margin="16,0,16,12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <TextBlock Text="{Binding FilteredEntries.Count,
                                              StringFormat={}{0} results}"
                               Foreground="{DynamicResource MutedBrush}"
                               FontSize="12"
                               VerticalAlignment="Center"/>

                    <ComboBox Grid.Column="1"
                              Width="110"
                              ItemsSource="{Binding SortOptions}"
                              SelectedIndex="{Binding SelectedSortIndex}"
                              FontSize="12"
                              Padding="6,4"
                              ToolTip="Sort order (favorites always on top)"/>
                </Grid>

                <!-- Entries -->
                <ListBox x:Name="EntryList"
                         ItemsSource="{Binding FilteredEntries}"
                         SelectedItem="{Binding SelectedEntry}"
                         IsSynchronizedWithCurrentItem="False"
                         Background="Transparent"
                         BorderThickness="0"
                         ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                         ScrollViewer.VerticalScrollBarVisibility="Auto"
                         Padding="8,0,8,12">

                    <ListBox.ItemContainerStyle>
                        <Style TargetType="ListBoxItem">
                            <Setter Property="HorizontalContentAlignment"
                                    Value="Stretch"/>
                            <Setter Property="Padding"
                                    Value="0"/>
                            <Setter Property="Margin"
                                    Value="0,0,0,2"/>
                            <Setter Property="Focusable"
                                    Value="True"/>

                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="ListBoxItem">
                                        <Border x:Name="Bd"
                                                Background="Transparent"
                                                CornerRadius="6"
                                                Padding="10,8"
                                                SnapsToDevicePixels="True">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="3"/>
                                                    <ColumnDefinition Width="*"/>
                                                </Grid.ColumnDefinitions>

                                                <Border x:Name="SelectionIndicator"
                                                        Width="3"
                                                        Background="Transparent"
                                                        CornerRadius="2"/>

                                                <ContentPresenter Grid.Column="1"
                                                                  Margin="9,0,0,0"/>
                                            </Grid>
                                        </Border>

                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsMouseOver"
                                                     Value="True">
                                                <Setter TargetName="Bd"
                                                        Property="Background"
                                                        Value="{DynamicResource SurfaceBrush}"/>
                                            </Trigger>

                                            <Trigger Property="IsSelected"
                                                     Value="True">
                                                <Setter TargetName="Bd"
                                                        Property="Background"
                                                        Value="{DynamicResource SurfaceAltBrush}"/>
                                                <Setter TargetName="SelectionIndicator"
                                                        Property="Background"
                                                        Value="{DynamicResource AccentBrush}"/>
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                        </Style>
                    </ListBox.ItemContainerStyle>

                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>

                                <Border Width="32"
                                        Height="32"
                                        CornerRadius="8"
                                        ClipToBounds="True"
                                        Background="{DynamicResource SurfaceAltBrush}"
                                        VerticalAlignment="Center"
                                        Margin="0,0,10,0">
                                    <Image Source="{Binding Converter={StaticResource FaviconConv}}"
                                           Stretch="UniformToFill"
                                           RenderOptions.BitmapScalingMode="HighQuality"/>
                                </Border>

                                <StackPanel Grid.Column="1"
                                            VerticalAlignment="Center">
                                    <TextBlock Text="{Binding Title}"
                                               FontWeight="SemiBold"
                                               FontSize="14"
                                               Foreground="{DynamicResource TextBrush}"
                                               TextTrimming="CharacterEllipsis"
                                               ToolTip="{Binding Title}"/>

                                    <TextBlock Text="{Binding Username}"
                                               FontSize="12"
                                               Margin="0,3,0,0"
                                               Foreground="{DynamicResource MutedBrush}"
                                               TextTrimming="CharacterEllipsis"
                                               ToolTip="{Binding Username}"/>
                                </StackPanel>

                                <TextBlock Grid.Column="2"
                                           Text="★"
                                           FontSize="14"
                                           Foreground="{DynamicResource WarningBrush}"
                                           VerticalAlignment="Center"
                                           Margin="8,0,0,0"
                                           Visibility="{Binding IsFavorite,
                                                                Converter={StaticResource BoolToVis}}"/>
                            </Grid>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </DockPanel>

            <!-- Divider -->
            <Border Grid.Column="1"
                    Background="{DynamicResource BorderBrush}"/>

            <!-- Entry Details -->
            <Grid Grid.Column="2">

                <!-- Empty State -->
                <StackPanel VerticalAlignment="Center"
                            HorizontalAlignment="Center"
                            Visibility="{Binding HasSelection,
                                                 Converter={StaticResource BoolToVis},
                                                 ConverterParameter=Invert}">
                    <TextBlock Text="Select an entry"
                               FontSize="18"
                               FontWeight="SemiBold"
                               Foreground="{DynamicResource MutedBrush}"
                               HorizontalAlignment="Center"/>

                    <TextBlock Text="or click + to add a new one"
                               FontSize="13"
                               Margin="0,8,0,0"
                               Foreground="{DynamicResource MutedBrush}"
                               HorizontalAlignment="Center"/>
                </StackPanel>

                <ScrollViewer VerticalScrollBarVisibility="Auto"
                              Padding="32"
                              Visibility="{Binding HasSelection,
                                                   Converter={StaticResource BoolToVis}}">
                    <StackPanel MaxWidth="560">

                        <!-- Title -->
                        <Grid Margin="0,0,0,8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <TextBlock Text="{Binding SelectedEntry.Title}"
                                       FontSize="26"
                                       FontWeight="Bold"
                                       Foreground="{DynamicResource TextBrush}"
                                       TextTrimming="CharacterEllipsis"
                                       ToolTip="{Binding SelectedEntry.Title}"/>

                            <Button Grid.Column="1"
                                    Padding="10,0,10,3"
                                    Margin="12,0,0,0"
                                    Command="{Binding ToggleFavoriteCommand}"
                                    CommandParameter="{Binding SelectedEntry}"
                                    Background="{DynamicResource SurfaceAltBrush}"
                                    ToolTip="Toggle favorite">
                                <TextBlock FontSize="16"
                                           Foreground="{DynamicResource TextBrush}">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="Text"
                                                    Value="☆"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsFavoriteSelected}"
                                                             Value="True">
                                                    <Setter Property="Text"
                                                            Value="★"/>
                                                    <Setter Property="Foreground"
                                                            Value="{DynamicResource WarningBrush}"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                            </Button>
                        </Grid>

                        <TextBlock Margin="0,0,0,20"
                                   FontSize="12"
                                   Foreground="{DynamicResource MutedBrush}">
                            <Run Text="Created "/>
                            <Run Text="{Binding CreatedAtText, Mode=OneWay}"/>
                            <Run Text="  ·  Updated "/>
                            <Run Text="{Binding UpdatedAtText, Mode=OneWay}"/>
                        </TextBlock>

                        <!-- URL -->
                        <StackPanel Visibility="{Binding HasUrl,
                                                          Converter={StaticResource BoolToVis}}"
                                    Margin="0,0,0,20">
                            <TextBlock Text="URL"
                                       FontSize="11"
                                       FontWeight="SemiBold"
                                       Foreground="{DynamicResource MutedBrush}"
                                       Margin="0,0,0,6"/>

                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>

                                <Border Background="{DynamicResource SurfaceBrush}"
                                        CornerRadius="6"
                                        Padding="12,10">
                                    <TextBlock Text="{Binding SelectedEntry.Url}"
                                               Foreground="{DynamicResource AccentBrush}"
                                               FontSize="13"
                                               VerticalAlignment="Center"
                                               TextWrapping="NoWrap"
                                               TextTrimming="CharacterEllipsis"
                                               ToolTip="{Binding SelectedEntry.Url}"/>
                                </Border>

                                <Button Grid.Column="1"
                                        Content="Copy"
                                        Margin="8,0,0,0"
                                        Command="{Binding CopyUrlCommand}"
                                        Background="{DynamicResource SurfaceAltBrush}"
                                        Foreground="{DynamicResource TextBrush}"/>

                                <Button Grid.Column="2"
                                        Content="Open"
                                        Margin="8,0,0,0"
                                        Command="{Binding OpenUrlCommand}"/>
                            </Grid>
                        </StackPanel>

                        <!-- Username -->
                        <TextBlock Text="USERNAME"
                                   FontSize="11"
                                   FontWeight="SemiBold"
                                   Foreground="{DynamicResource MutedBrush}"
                                   Margin="0,0,0,6"/>

                        <Grid Margin="0,0,0,20">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <Border Background="{DynamicResource SurfaceBrush}"
                                    CornerRadius="6"
                                    Padding="12,10">
                                <TextBlock Text="{Binding SelectedEntry.Username}"
                                           Foreground="{DynamicResource TextBrush}"
                                           FontSize="14"
                                           VerticalAlignment="Center"
                                           TextWrapping="NoWrap"
                                           TextTrimming="CharacterEllipsis"
                                           ToolTip="{Binding SelectedEntry.Username}"/>
                            </Border>

                            <Button Grid.Column="1"
                                    Content="Copy"
                                    Margin="8,0,0,0"
                                    Command="{Binding CopyUsernameCommand}"
                                    Background="{DynamicResource SurfaceAltBrush}"
                                    Foreground="{DynamicResource TextBrush}"/>
                        </Grid>

                        <!-- Password -->
                        <TextBlock Text="PASSWORD"
                                   FontSize="11"
                                   FontWeight="SemiBold"
                                   Foreground="{DynamicResource MutedBrush}"
                                   Margin="0,0,0,6"/>

                        <Grid Margin="0,0,0,20">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <Border Background="{DynamicResource SurfaceAltBrush}"
                                    CornerRadius="6"
                                    Padding="12,10">
                                <TextBlock Text="{Binding DisplayPassword}"
                                           Foreground="{DynamicResource TextBrush}"
                                           FontSize="15"
                                           FontWeight="SemiBold"
                                           FontFamily="Consolas"
                                           VerticalAlignment="Center"
                                           TextWrapping="NoWrap"
                                           TextTrimming="CharacterEllipsis"
                                           ToolTip="{Binding DisplayPassword}"/>
                            </Border>

                            <Button Grid.Column="1"
                                    Content="{Binding ShowPasswordButtonText}"
                                    Margin="8,0,0,0"
                                    Command="{Binding TogglePasswordVisibilityCommand}"
                                    Background="{DynamicResource SurfaceAltBrush}"
                                    Foreground="{DynamicResource TextBrush}"/>

                            <Button Grid.Column="2"
                                    Content="Copy"
                                    Margin="8,0,0,0"
                                    Command="{Binding CopyPasswordCommand}"
                                    CommandParameter="{Binding SelectedEntry}"/>
                        </Grid>

                        <!-- TOTP -->
                        <StackPanel Visibility="{Binding HasTotp,
                                                          Converter={StaticResource BoolToVis}}"
                                    Margin="0,0,0,20">
                            <TextBlock Text="AUTHENTICATOR (TOTP)"
                                       FontSize="11"
                                       FontWeight="SemiBold"
                                       Foreground="{DynamicResource AccentBrush}"
                                       Margin="0,0,0,6"/>

                            <Border Background="{DynamicResource SurfaceAltBrush}"
                                    CornerRadius="8"
                                    Padding="14">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>

                                    <StackPanel>
                                        <TextBlock Text="{Binding TotpCodeFormatted}"
                                                   FontSize="30"
                                                   FontWeight="Bold"
                                                   FontFamily="Consolas"
                                                   Foreground="{DynamicResource TextBrush}"/>

                                        <ProgressBar Height="4"
                                                     Margin="0,10,0,0"
                                                     Maximum="1"
                                                     Value="{Binding TotpProgress}"
                                                     Background="{DynamicResource SurfaceAltBrush}"/>

                                        <TextBlock Margin="0,6,0,0"
                                                   FontSize="12"
                                                   Foreground="{DynamicResource MutedBrush}">
                                            <Run Text="{Binding TotpRemainingSeconds, Mode=OneWay}"/>
                                            <Run Text="s remaining"/>
                                        </TextBlock>
                                    </StackPanel>

                                    <Button Grid.Column="1"
                                            Margin="12,0,0,0"
                                            Content="Copy"
                                            VerticalAlignment="Center"
                                            Command="{Binding CopyTotpCommand}"/>
                                </Grid>
                            </Border>
                        </StackPanel>

                        <!-- Notes -->
                        <StackPanel Visibility="{Binding HasNotes,
                                                          Converter={StaticResource BoolToVis}}"
                                    Margin="0,0,0,20">
                            <TextBlock Text="NOTES"
                                       FontSize="11"
                                       FontWeight="SemiBold"
                                       Foreground="{DynamicResource MutedBrush}"
                                       Margin="0,0,0,6"/>

                            <Border Background="{DynamicResource SurfaceBrush}"
                                    CornerRadius="6"
                                    Padding="12,10">
                                <ScrollViewer MaxHeight="160"
                                              VerticalScrollBarVisibility="Auto"
                                              HorizontalScrollBarVisibility="Disabled">
                                    <TextBlock Text="{Binding SelectedEntry.Notes}"
                                               Foreground="{DynamicResource TextBrush}"
                                               FontSize="13"
                                               TextWrapping="Wrap"
                                               ToolTip="{Binding SelectedEntry.Notes}"/>
                                </ScrollViewer>
                            </Border>
                        </StackPanel>

                        <!-- Custom Fields -->
                        <StackPanel Visibility="{Binding HasCustomFields,
                                                          Converter={StaticResource BoolToVis}}"
                                    Margin="0,0,0,20">
                            <TextBlock Text="CUSTOM FIELDS"
                                       FontSize="11"
                                       FontWeight="SemiBold"
                                       Foreground="{DynamicResource MutedBrush}"
                                       Margin="0,0,0,6"/>

                            <ItemsControl ItemsSource="{Binding DisplayCustomFields}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Grid Margin="0,0,0,8">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="120"/>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>

                                            <TextBlock Text="{Binding Name}"
                                                       Foreground="{DynamicResource MutedBrush}"
                                                       VerticalAlignment="Center"/>

                                            <Border Grid.Column="1"
                                                    Background="{DynamicResource SurfaceBrush}"
                                                    CornerRadius="6"
                                                    Padding="10,8">
                                                <TextBlock Text="{Binding DisplayValue}"
                                                           Foreground="{DynamicResource TextBrush}"
                                                           FontFamily="Consolas"
                                                           TextWrapping="NoWrap"
                                                           TextTrimming="CharacterEllipsis"
                                                           ToolTip="{Binding Value}"/>
                                            </Border>

                                            <Button Grid.Column="2"
                                                    Content="{Binding RevealButtonText}"
                                                    Margin="6,0,0,0"
                                                    Padding="10,6"
                                                    Command="{Binding DataContext.ToggleCustomFieldVisibilityCommand,
                                                                      RelativeSource={RelativeSource AncestorType=Window}}"
                                                    CommandParameter="{Binding}"
                                                    Background="{DynamicResource SurfaceAltBrush}"
                                                    Foreground="{DynamicResource TextBrush}"
                                                    Visibility="{Binding IsSecret,
                                                                         Converter={StaticResource BoolToVis}}"/>

                                            <Button Grid.Column="3"
                                                    Content="Copy"
                                                    Margin="6,0,0,0"
                                                    Padding="10,6"
                                                    Command="{Binding DataContext.CopyCustomFieldCommand,
                                                                      RelativeSource={RelativeSource AncestorType=Window}}"
                                                    CommandParameter="{Binding}"
                                                    Background="{DynamicResource SurfaceAltBrush}"
                                                    Foreground="{DynamicResource TextBrush}"/>
                                        </Grid>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>

                        <!-- Tags -->
                        <StackPanel Visibility="{Binding HasTags,
                                                          Converter={StaticResource BoolToVis}}"
                                    Margin="0,0,0,20">
                            <TextBlock Text="TAGS"
                                       FontSize="11"
                                       FontWeight="SemiBold"
                                       Foreground="{DynamicResource MutedBrush}"
                                       Margin="0,0,0,6"/>

                            <ItemsControl ItemsSource="{Binding SelectedEntry.Tags}">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <WrapPanel/>
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>

                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border Background="{DynamicResource SurfaceBrush}"
                                                CornerRadius="4"
                                                Padding="7,3"
                                                Margin="0,0,6,6">
                                            <TextBlock Text="{Binding}"
                                                       Foreground="{DynamicResource MutedBrush}"
                                                       FontSize="11"/>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>

                        <!-- Actions -->
                        <StackPanel Orientation="Horizontal"
                                    Margin="0,0,0,0">
                            <Button Content="Edit"
                                    Command="{Binding EditEntryCommand}"
                                    CommandParameter="{Binding SelectedEntry}"
                                    Padding="20,8"
                                    Margin="0,0,8,0"
                                    ToolTip="Edit (Ctrl+E)"/>

                            <Button Content="Delete"
                                    Command="{Binding DeleteEntryCommand}"
                                    CommandParameter="{Binding SelectedEntry}"
                                    Padding="20,8"
                                    Background="{DynamicResource DangerBrush}"
                                    ToolTip="Move to trash (Delete)"/>
                        </StackPanel>

                    </StackPanel>
                </ScrollViewer>
            </Grid>
        </Grid>
        </DockPanel>

        <Border x:Name="SnackbarBorder"
                Width="360"
                MinHeight="54"
                MaxHeight="100"
                HorizontalAlignment="Right"
                VerticalAlignment="Bottom"
                Margin="0,0,24,24"
                Background="{DynamicResource SurfaceBrush}"
                BorderBrush="{DynamicResource SuccessBrush}"
                BorderThickness="1"
                CornerRadius="8"
                Visibility="Collapsed"
                IsHitTestVisible="False">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="4"/>
                    <ColumnDefinition Width="42"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <Border x:Name="SnackbarAccent"
                        Grid.Column="0"
                        Background="{DynamicResource SuccessBrush}"
                        CornerRadius="8,0,0,8"/>
                <Border Grid.Column="1"
                        Width="30"
                        Height="30"
                        Margin="12,0,0,0"
                        HorizontalAlignment="Left"
                        VerticalAlignment="Center"
                        Background="{DynamicResource SurfaceAltBrush}"
                        CornerRadius="15">
                    <TextBlock x:Name="SnackbarIcon"
                               Text="&#xE73E;"
                               FontFamily="Segoe MDL2 Assets"
                               FontSize="13"
                               Foreground="{DynamicResource SuccessBrush}"
                               HorizontalAlignment="Center"
                               VerticalAlignment="Center"/>
                </Border>
                <TextBlock x:Name="SnackbarText"
                           Grid.Column="2"
                           Margin="4,11,14,11"
                           FontSize="13"
                           Foreground="{DynamicResource TextBrush}"
                           TextWrapping="Wrap"
                           VerticalAlignment="Center"/>
            </Grid>
        </Border>
    </Grid>
</Window>
