<Window x:Class="PejPass.Wpf.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="PejPass"
        Height="720" Width="1180"
        MinHeight="560" MinWidth="900"
        WindowStartupLocation="CenterScreen"
        Background="{DynamicResource BgBrush}">

    <DockPanel>

        <Border DockPanel.Dock="Top" Background="{DynamicResource SurfaceBrush}" Padding="20,12">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="PejPass" FontSize="20" FontWeight="Bold"
                               Foreground="{DynamicResource TextBrush}" VerticalAlignment="Center"/>
                    <Border Background="{DynamicResource SurfaceAltBrush}" CornerRadius="4" Padding="8,2" Margin="14,0,0,0" VerticalAlignment="Center">
                        <TextBlock Text="{Binding VaultName}" FontSize="12"
                                   Foreground="{DynamicResource MutedBrush}"/>
                    </Border>
                </StackPanel>

                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="{Binding StatusMessage}" Foreground="{DynamicResource AccentBrush}"
                               VerticalAlignment="Center" Margin="0,0,16,0" FontSize="13"/>
                    <Button Content="Settings" Command="{Binding OpenSettingsCommand}"
                            Padding="14,7" Margin="0,0,8,0"
                            Background="{DynamicResource SurfaceAltBrush}" Foreground="{DynamicResource TextBrush}"
                            ToolTip="Settings (Ctrl+S)"/>
                    <Button Content="Health" Command="{Binding OpenHealthCommand}"
                            Padding="14,7" Margin="0,0,8,0"
                            Background="{DynamicResource SurfaceAltBrush}" Foreground="{DynamicResource TextBrush}"
                            ToolTip="Vault health report (Ctrl+H)"/>
                    <Button Content="Trash" Command="{Binding OpenTrashCommand}"
                            Padding="14,7" Margin="0,0,8,0"
                            Background="{DynamicResource SurfaceAltBrush}" Foreground="{DynamicResource TextBrush}"
                            ToolTip="Trash (Ctrl+Shift+T)"/>
                    <Button Content="Backup" Command="{Binding ExportBackupCommand}"
                            Padding="14,7" Margin="0,0,8,0"
                            Background="{DynamicResource SurfaceAltBrush}" Foreground="{DynamicResource TextBrush}"
                            ToolTip="Export encrypted vault backup (Ctrl+B)"/>
                    <Button Content="Export CSV" Command="{Binding ExportCsvCommand}"
                            Padding="14,7" Margin="0,0,8,0"
                            Background="{DynamicResource SurfaceAltBrush}" Foreground="{DynamicResource TextBrush}"
                            ToolTip="Export unencrypted CSV (security warning)"/>
                    <Button Content="Import" Command="{Binding ImportCommand}"
                            Padding="14,7" Margin="0,0,8,0"
                            Background="{DynamicResource SurfaceAltBrush}" Foreground="{DynamicResource TextBrush}"/>
                    <Button Content="Lock" Command="{Binding LockCommand}"
                            Padding="14,7" Background="{DynamicResource DangerBrush}"
                            ToolTip="Lock vault (Ctrl+L)"/>
                </StackPanel>
            </Grid>
        </Border>

        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="340" MinWidth="280" MaxWidth="420"/>
                <ColumnDefinition Width="1"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <DockPanel Grid.Column="0">
                <Border DockPanel.Dock="Top" Padding="16,14,16,10">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBox x:Name="SearchBox" Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"
                                 VerticalContentAlignment="Center" Padding="10,8" Margin="0,0,10,0"
                                 ToolTip="Search (Ctrl+F / Ctrl+K)"/>
                        <Button Grid.Column="1" Content="+" Command="{Binding AddEntryCommand}"
                                Width="44" Height="40" FontSize="18" FontWeight="Bold"
                                ToolTip="Add entry (Ctrl+N)"/>
                    </Grid>
                </Border>

                <Grid DockPanel.Dock="Top" Margin="16,0,16,8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="{Binding FilteredEntries.Count, StringFormat={}{0} entries}"
                               Foreground="{DynamicResource MutedBrush}" FontSize="12"
                               VerticalAlignment="Center"/>
                    <ComboBox Grid.Column="1" Width="110"
                              ItemsSource="{Binding SortOptions}"
                              SelectedIndex="{Binding SelectedSortIndex}"
                              FontSize="12" Padding="6,4"
                              ToolTip="Sort order (favorites always on top)"/>
                </Grid>

                <ListBox x:Name="EntryList"
                         ItemsSource="{Binding FilteredEntries}"
                         SelectedItem="{Binding SelectedEntry}"
                         IsSynchronizedWithCurrentItem="False"
                         Background="Transparent" BorderThickness="0"
                         ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                         ScrollViewer.VerticalScrollBarVisibility="Auto" Padding="8,0,8,12">
                    <ListBox.ItemContainerStyle>
                        <Style TargetType="ListBoxItem">
                            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                            <Setter Property="Padding" Value="0"/>
                            <Setter Property="Margin" Value="0,0,0,4"/>
                            <Setter Property="Focusable" Value="True"/>
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="ListBoxItem">
                                        <Border x:Name="Bd" Background="{DynamicResource SurfaceBrush}"
                                                CornerRadius="8" Padding="14,12" BorderThickness="1"
                                                BorderBrush="Transparent" SnapsToDevicePixels="True">
                                            <ContentPresenter/>
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource SurfaceAltBrush}"/>
                                            </Trigger>
                                            <Trigger Property="IsSelected" Value="True">
                                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource SurfaceAltBrush}"/>
                                                <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource AccentBrush}"/>
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                        </Style>
                    </ListBox.ItemContainerStyle>
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel>
                                    <TextBlock Text="{Binding Title}" FontWeight="SemiBold" FontSize="14"
                                               Foreground="{DynamicResource TextBrush}" TextTrimming="CharacterEllipsis"/>
                                    <TextBlock Text="{Binding Username}" FontSize="12" Margin="0,3,0,0"
                                               Foreground="{DynamicResource MutedBrush}" TextTrimming="CharacterEllipsis"/>
                                </StackPanel>
                                <TextBlock Grid.Column="1" Text="★" FontSize="14"
                                           Foreground="{DynamicResource WarningBrush}"
                                           VerticalAlignment="Center" Margin="8,0,0,0"
                                           Visibility="{Binding IsFavorite, Converter={StaticResource BoolToVis}}"/>
                            </Grid>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </DockPanel>

            <Border Grid.Column="1" Background="{DynamicResource BorderBrush}"/>

            <Grid Grid.Column="2">
                <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center"
                            Visibility="{Binding HasSelection, Converter={StaticResource BoolToVis}, ConverterParameter=Invert}">
                    <TextBlock Text="Select an entry" FontSize="18" FontWeight="SemiBold"
                               Foreground="{DynamicResource MutedBrush}" HorizontalAlignment="Center"/>
                    <TextBlock Text="or click + to add a new one" FontSize="13" Margin="0,8,0,0"
                               Foreground="{DynamicResource MutedBrush}" HorizontalAlignment="Center"/>
                </StackPanel>

                <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="36,32"
                              Visibility="{Binding HasSelection, Converter={StaticResource BoolToVis}}">
                    <StackPanel MaxWidth="560">

                        <Grid Margin="0,0,0,6">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="{Binding SelectedEntry.Title}" FontSize="26" FontWeight="Bold"
                                       Foreground="{DynamicResource TextBrush}" TextWrapping="Wrap"/>
                            <Button Grid.Column="1" Padding="12,8" Margin="12,0,0,0"
                                    Command="{Binding ToggleFavoriteCommand}"
                                    CommandParameter="{Binding SelectedEntry}"
                                    Background="{DynamicResource SurfaceAltBrush}"
                                    ToolTip="Toggle favorite">
                                <TextBlock FontSize="16" Foreground="{DynamicResource TextBrush}">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="Text" Value="☆"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsFavoriteSelected}" Value="True">
                                                    <Setter Property="Text" Value="★"/>
                                                    <Setter Property="Foreground" Value="{DynamicResource WarningBrush}"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                            </Button>
                        </Grid>
                        <TextBlock Margin="0,0,0,18" FontSize="12" Foreground="{DynamicResource MutedBrush}">
                            <Run Text="Created "/>
                            <Run Text="{Binding CreatedAtText, Mode=OneWay}"/>
                            <Run Text="  ·  Updated "/>
                            <Run Text="{Binding UpdatedAtText, Mode=OneWay}"/>
                        </TextBlock>

                        <StackPanel Visibility="{Binding HasUrl, Converter={StaticResource BoolToVis}}" Margin="0,0,0,18">
                            <TextBlock Text="URL" FontSize="11" FontWeight="SemiBold"
                                       Foreground="{DynamicResource MutedBrush}" Margin="0,0,0,6"/>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <Border Background="{DynamicResource SurfaceBrush}" CornerRadius="6" Padding="12,10">
                                    <TextBlock Text="{Binding SelectedEntry.Url}" Foreground="{DynamicResource AccentBrush}"
                                               FontSize="13" VerticalAlignment="Center" TextWrapping="Wrap"/>
                                </Border>
                                <Button Grid.Column="1" Content="Copy" Margin="8,0,0,0" Padding="12,8"
                                        Command="{Binding CopyUrlCommand}"
                                        Background="{DynamicResource SurfaceAltBrush}" Foreground="{DynamicResource TextBrush}"/>
                                <Button Grid.Column="2" Content="Open" Margin="8,0,0,0" Padding="12,8"
                                        Command="{Binding OpenUrlCommand}"/>
                            </Grid>
                        </StackPanel>

                        <TextBlock Text="USERNAME" FontSize="11" FontWeight="SemiBold"
                                   Foreground="{DynamicResource MutedBrush}" Margin="0,0,0,6"/>
                        <Grid Margin="0,0,0,18">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <Border Background="{DynamicResource SurfaceBrush}" CornerRadius="6" Padding="12,10">
                                <TextBlock Text="{Binding SelectedEntry.Username}" Foreground="{DynamicResource TextBrush}"
                                           FontSize="14" VerticalAlignment="Center" TextWrapping="Wrap"/>
                            </Border>
                            <Button Grid.Column="1" Content="Copy" Margin="8,0,0,0" Padding="12,8"
                                    Command="{Binding CopyUsernameCommand}"
                                    Background="{DynamicResource SurfaceAltBrush}" Foreground="{DynamicResource TextBrush}"/>
                        </Grid>

                        <TextBlock Text="PASSWORD" FontSize="11" FontWeight="SemiBold"
                                   Foreground="{DynamicResource MutedBrush}" Margin="0,0,0,6"/>
                        <Grid Margin="0,0,0,18">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <Border Background="{DynamicResource SurfaceBrush}" CornerRadius="6" Padding="12,10">
                                <TextBlock Text="{Binding DisplayPassword}" Foreground="{DynamicResource TextBrush}"
                                           FontSize="14" FontFamily="Consolas" VerticalAlignment="Center"/>
                            </Border>
                            <Button Grid.Column="1" Content="{Binding ShowPasswordButtonText}"
                                    Margin="8,0,0,0" Padding="12,8"
                                    Command="{Binding TogglePasswordVisibilityCommand}"
                                    Background="{DynamicResource SurfaceAltBrush}" Foreground="{DynamicResource TextBrush}"/>
                            <Button Grid.Column="2" Content="Copy" Margin="8,0,0,0" Padding="12,8"
                                    Command="{Binding CopyPasswordCommand}"
                                    CommandParameter="{Binding SelectedEntry}"/>
                        </Grid>

                        <StackPanel Visibility="{Binding HasTotp, Converter={StaticResource BoolToVis}}" Margin="0,0,0,18">
                            <TextBlock Text="AUTHENTICATOR (TOTP)" FontSize="11" FontWeight="SemiBold"
                                       Foreground="{DynamicResource MutedBrush}" Margin="0,0,0,6"/>
                            <Border Background="{DynamicResource SurfaceBrush}" CornerRadius="8" Padding="16,14">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                    </Grid.RowDefinitions>

                                    <TextBlock Text="{Binding TotpCodeFormatted}"
                                               FontSize="28" FontWeight="Bold" FontFamily="Consolas"
                                               Foreground="{DynamicResource TextBrush}" VerticalAlignment="Center"/>

                                    <Button Grid.Column="1" Content="Copy" Padding="14,8"
                                            Command="{Binding CopyTotpCommand}" VerticalAlignment="Center"/>

                                    <ProgressBar Grid.Row="1" Grid.ColumnSpan="2"
                                                 Margin="0,12,0,0"
                                                 Minimum="0" Maximum="30"
                                                 Value="{Binding TotpRemainingSeconds}"
                                                 Height="5"/>

                                    <TextBlock Grid.Row="2" Grid.ColumnSpan="2"
                                               Text="{Binding TotpRemainingSeconds, StringFormat={}{0}s remaining}"
                                               FontSize="12" Foreground="{DynamicResource MutedBrush}"
                                               Margin="0,8,0,0"/>
                                </Grid>
                            </Border>
                        </StackPanel>

                        <StackPanel Visibility="{Binding HasNotes, Converter={StaticResource BoolToVis}}">
                            <TextBlock Text="NOTES" FontSize="11" FontWeight="SemiBold"
                                       Foreground="{DynamicResource MutedBrush}" Margin="0,0,0,6"/>
                            <Border Background="{DynamicResource SurfaceBrush}" CornerRadius="6"
                                    Padding="12,10" Margin="0,0,0,18">
                                <TextBlock Text="{Binding SelectedEntry.Notes}" Foreground="{DynamicResource TextBrush}"
                                           FontSize="13" TextWrapping="Wrap"/>
                            </Border>
                        </StackPanel>

                        <StackPanel Visibility="{Binding HasCustomFields, Converter={StaticResource BoolToVis}}">
                            <TextBlock Text="CUSTOM FIELDS" FontSize="11" FontWeight="SemiBold"
                                       Foreground="{DynamicResource MutedBrush}" Margin="0,0,0,8"/>
                            <ItemsControl ItemsSource="{Binding DisplayCustomFields}" Margin="0,0,0,18">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Grid Margin="0,0,0,8">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="140"/>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Text="{Binding Name}" FontSize="12"
                                                       Foreground="{DynamicResource MutedBrush}" VerticalAlignment="Center"/>
                                            <Border Grid.Column="1" Background="{DynamicResource SurfaceBrush}"
                                                    CornerRadius="6" Padding="10,8" Margin="0,0,6,0">
                                                <TextBlock Text="{Binding DisplayValue}" FontSize="13" FontFamily="Consolas"
                                                           Foreground="{DynamicResource TextBrush}" TextWrapping="Wrap"/>
                                            </Border>
                                            <Button Grid.Column="2" Content="{Binding RevealButtonText}"
                                                    Margin="0,0,6,0" Padding="10,6"
                                                    Command="{Binding DataContext.ToggleCustomFieldVisibilityCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                    CommandParameter="{Binding}"
                                                    Background="{DynamicResource SurfaceAltBrush}" Foreground="{DynamicResource TextBrush}"
                                                    Visibility="{Binding IsSecret, Converter={StaticResource BoolToVis}}"/>
                                            <Button Grid.Column="3" Content="Copy" Padding="10,6"
                                                    Command="{Binding DataContext.CopyCustomFieldCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                    CommandParameter="{Binding}"
                                                    Background="{DynamicResource SurfaceAltBrush}" Foreground="{DynamicResource TextBrush}"/>
                                        </Grid>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>

                        <StackPanel Visibility="{Binding HasTags, Converter={StaticResource BoolToVis}}">
                            <TextBlock Text="TAGS" FontSize="11" FontWeight="SemiBold"
                                       Foreground="{DynamicResource MutedBrush}" Margin="0,0,0,8"/>
                            <ItemsControl ItemsSource="{Binding SelectedEntry.Tags}" Margin="0,0,0,28">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <WrapPanel/>
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border Background="{DynamicResource SurfaceAltBrush}" CornerRadius="4" Padding="8,3" Margin="0,0,6,6">
                                            <TextBlock Text="{Binding}" FontSize="12" Foreground="{DynamicResource MutedBrush}"/>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>

                        <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                            <Button Content="Edit" Command="{Binding EditEntryCommand}"
                                    CommandParameter="{Binding SelectedEntry}" Padding="20,10" Margin="0,0,10,0"
                                    ToolTip="Edit (Ctrl+E)"/>
                            <Button Content="Trash" Command="{Binding DeleteEntryCommand}"
                                    CommandParameter="{Binding SelectedEntry}" Padding="20,10"
                                    Background="{DynamicResource DangerBrush}"
                                    ToolTip="Move to Trash (Del)"/>
                        </StackPanel>

                    </StackPanel>
                </ScrollViewer>
            </Grid>
        </Grid>
    </DockPanel>
</Window>
