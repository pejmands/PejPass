<Window x:Class="PejPass.Wpf.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        Title="PejPass — Local Password Manager"
        Height="640" Width="960"
        WindowStartupLocation="CenterScreen"
        Background="#1E1E2E">

    <Grid>
        <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
            <TextBlock Text="PejPass"
                       FontSize="42"
                       FontWeight="Bold"
                       Foreground="#CDD6F4"
                       HorizontalAlignment="Center"
                       Margin="0,0,0,12"/>

            <TextBlock Text="Professional offline password manager"
                       FontSize="16"
                       Foreground="#A6ADC8"
                       HorizontalAlignment="Center"
                       Margin="0,0,0,32"/>

            <TextBlock Text="Project skeleton is ready.&#x0a;Next: implement vault open / create flow."
                       FontSize="14"
                       Foreground="#89B4FA"
                       TextAlignment="Center"
                       HorizontalAlignment="Center"/>
        </StackPanel>
    </Grid>
</Window>
