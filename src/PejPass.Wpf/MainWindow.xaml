<Window x:Class="PejPass.Wpf.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="PejPass"
        Height="720" Width="1180"
        MinHeight="560" MinWidth="900"
        WindowStartupLocation="CenterScreen"
        Background="{StaticResource BgBrush}">

    <DockPanel>

        <!-- ========== TOP BAR ========== -->
        <Border DockPanel.Dock="Top" Background="{StaticResource SurfaceBrush}" Padding="20,12">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="PejPass" FontSize="20" FontWeight="Bold"
                               Foreground="{StaticResource TextBrush}" VerticalAlignment="Center"/>
                    <Border Background="#45475A" CornerRadius="4" Padding="8,2" Margin="14,0,0,0" VerticalAlignment="Center">
                        <TextBlock Text="{Binding VaultName}" FontSize="12"
                                   Foreground="{StaticResource MutedBrush}"/>
                    </Border>
                </StackPanel>

                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="{Binding StatusMessage}" Foreground="{StaticResource AccentBrush}"
                               VerticalAlignment="Center" Margin="0,0,16,0" FontSize="13"/>
                    <Button Content="Import" Command="{Binding ImportCommand}"
                            Padding="14,7" Margin="0,0,8,0"
                            Background="#45475A" Foreground="{StaticResource TextBrush}"/>
                    <Button Content="Lock" Command="{Binding LockCommand}"
                            Padding="14,7" Background="{StaticResource DangerBrush}"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- ========== MAIN CONTENT ========== -->
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="340" MinWidth="280" MaxWidth="420"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- ===== LEFT: Entry List ===== -->
            <DockPanel Grid.Column="0" Background="{StaticResource BgBrush}">

                <!-- Search + Add -->
                <Border DockPanel.Dock="Top" Padding="16,14,16,10">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBox Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"
                                 VerticalContentAlignment="Center"
                                 Padding="10,8"
                                 Margin="0,0,10,0"/>
                        <Button Grid.Column="1" Content="+"
                                Command="{Binding AddEntryCommand}"
                                Width="36" Height="36" FontSize="18" FontWeight="Bold"
                                ToolTip="Add new entry"/>
                    </Grid>
                </Border>

                <!-- Count -->
                <TextBlock DockPanel.Dock="Top"
                           Text="{Binding FilteredEntries.Count, StringFormat={}{0} entries}"
                           Foreground="{StaticResource MutedBrush}" FontSize="12"
                           Margin="20,0,0,8"/>

                <!-- List -->
                <ListBox ItemsSource="{Binding FilteredEntries}"
                         SelectedItem="{Binding SelectedEntry}"
                         Background="Transparent"
                         BorderThickness="0"
                         ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                         ScrollViewer.VerticalScrollBarVisibility="Auto"
                         Padding="8,0,8,12">

                    <ListBox.ItemContainerStyle>
                        <Style TargetType="ListBoxItem">
                            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                            <Setter Property="Padding" Value="0"/>
                            <Setter Property="Margin" Value="0,0,0,4"/>
                            <Setter Property="Background" Value="Transparent"/>
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="ListBoxItem">
                                        <Border x:Name="Bd"
                                                Background="{StaticResource SurfaceBrush}"
                                                CornerRadius="8"
                                                Padding="14,12"
                                                SnapsToDevicePixels="True">
                                            <ContentPresenter/>
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter TargetName="Bd" Property="Background" Value="#3B3B4F"/>
                                            </Trigger>
                                            <Trigger Property="IsSelected" Value="True">
                                                <Setter TargetName="Bd" Property="Background" Value="#45475A"/>
                                                <Setter TargetName="Bd" Property="BorderBrush" Value="{StaticResource AccentBrush}"/>
                                                <Setter TargetName="Bd" Property="BorderThickness" Value="1"/>
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                        </Style>
                    </ListBox.ItemContainerStyle>

                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel>
                                    <TextBlock Text="{Binding Title}"
                                               FontWeight="SemiBold" FontSize="14"
                                               Foreground="{StaticResource TextBrush}"
                                               TextTrimming="CharacterEllipsis"/>
                                    <TextBlock Text="{Binding Username}"
                                               FontSize="12" Margin="0,3,0,0"
                                               Foreground="{StaticResource MutedBrush}"
                                               TextTrimming="CharacterEllipsis"/>
                                </StackPanel>
                            </Grid>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </DockPanel>

            <!-- Splitter -->
            <GridSplitter Grid.Column="1" Width="1" HorizontalAlignment="Center"
                          Background="#313244" ResizeBehavior="PreviousAndNext"/>

            <!-- ===== RIGHT: Detail Panel ===== -->
            <Grid Grid.Column="2" Background="{StaticResource BgBrush}">

                <!-- Empty state -->
                <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center"
                            Visibility="{Binding HasSelection, Converter={StaticResource BoolToVisibilityConverter}}">
                    <!-- shown when NO selection — we invert below with a trigger style -->
                </StackPanel>

                <!-- Placeholder when nothing selected -->
                <Border x:Name="EmptyState">
                    <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                        <TextBlock Text="Select an entry"
                                   FontSize="18" FontWeight="SemiBold"
                                   Foreground="{StaticResource MutedBrush}"
                                   HorizontalAlignment="Center"/>
                        <TextBlock Text="or click + to add a new one"
                                   FontSize="13" Margin="0,8,0,0"
                                   Foreground="#6C7086"
                                   HorizontalAlignment="Center"/>
                    </StackPanel>
                </Border>

                <!-- Detail content -->
                <ScrollViewer x:Name="DetailPanel" VerticalScrollBarVisibility="Auto"
                              Padding="32,28" Visibility="Collapsed">
                    <StackPanel MaxWidth="560">

                        <!-- Title -->
                        <TextBlock Text="{Binding SelectedEntry.Title}"
                                   FontSize="26" FontWeight="Bold"
                                   Foreground="{StaticResource TextBrush}"
                                   TextWrapping="Wrap" Margin="0,0,0,6"/>

                        <!-- URL -->
                        <TextBlock Text="{Binding SelectedEntry.Url}"
                                   FontSize="13" Foreground="{StaticResource AccentBrush}"
                                   TextWrapping="Wrap" Margin="0,0,0,24"
                                   Cursor="Hand"/>

                        <!-- Username -->
                        <TextBlock Text="USERNAME" FontSize="11" FontWeight="SemiBold"
                                   Foreground="{StaticResource MutedBrush}" Margin="0,0,0,6"/>
                        <Grid Margin="0,0,0,18">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <Border Background="{StaticResource SurfaceBrush}" CornerRadius="6" Padding="12,10">
                                <TextBlock Text="{Binding SelectedEntry.Username}"
                                           Foreground="{StaticResource TextBrush}" FontSize="14"
                                           VerticalAlignment="Center" TextWrapping="Wrap"/>
                            </Border>
                            <Button Grid.Column="1" Content="Copy" Margin="8,0,0,0" Padding="12,8"
                                    Command="{Binding CopyUsernameCommand}"
                                    Background="#45475A" Foreground="{StaticResource TextBrush}"/>
                        </Grid>

                        <!-- Password -->
                        <TextBlock Text="PASSWORD" FontSize="11" FontWeight="SemiBold"
                                   Foreground="{StaticResource MutedBrush}" Margin="0,0,0,6"/>
                        <Grid Margin="0,0,0,18">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <Border Background="{StaticResource SurfaceBrush}" CornerRadius="6" Padding="12,10">
                                <TextBlock Text="{Binding DisplayPassword}"
                                           Foreground="{StaticResource TextBrush}" FontSize="14"
                                           FontFamily="Consolas" VerticalAlignment="Center"/>
                            </Border>
                            <Button Grid.Column="1" Content="{Binding ShowPasswordButtonText}"
                                    Margin="8,0,0,0" Padding="12,8"
                                    Command="{Binding TogglePasswordVisibilityCommand}"
                                    Background="#45475A" Foreground="{StaticResource TextBrush}"/>
                            <Button Grid.Column="2" Content="Copy" Margin="8,0,0,0" Padding="12,8"
                                    Command="{Binding CopyPasswordCommand}"
                                    CommandParameter="{Binding SelectedEntry}"/>
                        </Grid>

                        <!-- Notes -->
                        <TextBlock Text="NOTES" FontSize="11" FontWeight="SemiBold"
                                   Foreground="{StaticResource MutedBrush}" Margin="0,0,0,6"
                                   Visibility="{Binding HasNotes, Converter={StaticResource BoolToVis}}"/>
                        <Border Background="{StaticResource SurfaceBrush}" CornerRadius="6"
                                Padding="12,10" Margin="0,0,0,18"
                                Visibility="{Binding HasNotes, Converter={StaticResource BoolToVis}}">
                            <TextBlock Text="{Binding SelectedEntry.Notes}"
                                       Foreground="{StaticResource TextBrush}" FontSize="13"
                                       TextWrapping="Wrap"/>
                        </Border>

                        <!-- Custom Fields -->
                        <TextBlock Text="CUSTOM FIELDS" FontSize="11" FontWeight="SemiBold"
                                   Foreground="{StaticResource MutedBrush}" Margin="0,0,0,8"
                                   Visibility="{Binding HasCustomFields, Converter={StaticResource BoolToVis}}"/>
                        <ItemsControl ItemsSource="{Binding SelectedEntry.CustomFields}"
                                      Margin="0,0,0,18"
                                      Visibility="{Binding HasCustomFields, Converter={StaticResource BoolToVis}}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Grid Margin="0,0,0,8">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="140"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="{Binding Name}" FontSize="12"
                                                   Foreground="{StaticResource MutedBrush}"
                                                   VerticalAlignment="Center"/>
                                        <Border Grid.Column="1" Background="{StaticResource SurfaceBrush}"
                                                CornerRadius="6" Padding="10,8">
                                            <TextBlock Text="{Binding Value}" FontSize="13"
                                                       Foreground="{StaticResource TextBrush}"
                                                       TextWrapping="Wrap"/>
                                        </Border>
                                    </Grid>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>

                        <!-- Tags -->
                        <TextBlock Text="TAGS" FontSize="11" FontWeight="SemiBold"
                                   Foreground="{StaticResource MutedBrush}" Margin="0,0,0,8"
                                   Visibility="{Binding HasTags, Converter={StaticResource BoolToVis}}"/>
                        <ItemsControl ItemsSource="{Binding SelectedEntry.Tags}" Margin="0,0,0,28"
                                      Visibility="{Binding HasTags, Converter={StaticResource BoolToVis}}">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <WrapPanel/>
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Background="#45475A" CornerRadius="4" Padding="8,3" Margin="0,0,6,6">
                                        <TextBlock Text="{Binding}" FontSize="12"
                                                   Foreground="{StaticResource MutedBrush}"/>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>

                        <!-- Actions -->
                        <StackPanel Orientation="Horizontal">
                            <Button Content="Edit" Command="{Binding EditEntryCommand}"
                                    CommandParameter="{Binding SelectedEntry}"
                                    Padding="20,10" Margin="0,0,10,0"/>
                            <Button Content="Delete" Command="{Binding DeleteEntryCommand}"
                                    CommandParameter="{Binding SelectedEntry}"
                                    Padding="20,10"
                                    Background="{StaticResource DangerBrush}"/>
                        </StackPanel>

                    </StackPanel>
                </ScrollViewer>
            </Grid>
        </Grid>
    </DockPanel>
</Window>
