{
  "manifest_version": 3,
  "name": "PejPass",
  "version": "0.3.0",
  "description": "A lightweight browser companion for PejPass.",
  "permissions": [
    "activeTab",
    "nativeMessaging",
    "scripting"
  ],
  "action": {
    "default_title": "PejPass",
    "default_popup": "popup.html"
  }
}
