{
  "manifest_version": 3,
  "name": "PejPass",
  "version": "0.5.0",
  "description": "A lightweight browser companion for PejPass.",
  "permissions": [
    "activeTab",
    "clipboardWrite",
    "nativeMessaging",
    "scripting"
  ],
  "action": {
    "default_title": "PejPass",
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/PejPassLocked.ico",
      "32": "icons/PejPassLocked.ico"
    }
  }
}
