{
  "manifest_version": 3,
  "name": "PejPass",
  "version": "0.5.0",
  "description": "A lightweight browser companion for PejPass.",
  "permissions": [
    "activeTab",
    "nativeMessaging",
    "scripting",
    "alarms",
    "contextMenus"
  ],
  "commands": {
    "fill-first-login": {
      "suggested_key": { "default": "Ctrl+Shift+L" },
      "description": "Fill the first matching login with PejPass"
    }
  },
  "action": {
    "default_title": "PejPass",
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/PejPass16.png",
      "32": "icons/PejPass48.png"
    }
  },
  "background": {
    "service_worker": "background.js"
  },
  "icons": {
    "16": "icons/PejPass16.png",
    "48": "icons/PejPass48.png",
    "128": "icons/PejPass128.png"
  }
}
