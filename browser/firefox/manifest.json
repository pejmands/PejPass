{
  "manifest_version": 3,
  "name": "PejPass",
  "version": "0.5.0",
  "description": "A lightweight browser companion for PejPass.",
  "browser_specific_settings": {
    "gecko": {
      "id": "pejpass@pejmands.github.io",
      "strict_min_version": "115.0"
    }
  },
  "permissions": [
    "activeTab",
    "nativeMessaging",
    "scripting",
    "alarms",
    "storage",
    "tabs"
  ],
  "action": {
    "default_title": "PejPass",
    "default_popup": "popup.html",
    "default_icon": "icons/PejPassLocked.ico"
  },
  "background": {
    "scripts": [
      "browser-api.js",
      "injected.js",
      "background.js"
    ]
  },
  "icons": {
    "16": "icons/PejPass16.png",
    "48": "icons/PejPass48.png",
    "128": "icons/PejPass128.png"
  }
}
