<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <LangVersion>latest</LangVersion>
  </PropertyGroup>

  <ItemGroup>
    <!-- Shared with the app so the signed payload and trusted keys cannot drift. -->
    <Compile Include="..\..\src\PejPass.Application\Security\UpdateSigningPayload.cs"
             Link="UpdateSigningPayload.cs" />
    <Compile Include="..\..\src\PejPass.Application\Security\TrustedUpdateKeys.cs"
             Link="TrustedUpdateKeys.cs" />
  </ItemGroup>

</Project>
